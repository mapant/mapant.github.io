---
export interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <!-- The <slot /> is where your individual page content gets injected -->
        <slot />
    </body>
</html>

<style is:global>
    /* 
      This global CSS removes default browser margins and forces the 
      layout to stretch from the absolute left edge to the right edge.
    */
    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        max-width: 100%;
        overflow-x: hidden;
        background-color: #f3f7fb;
    }

    /* Ensures padding doesn't accidentally stretch elements beyond 100% width */
    *, *::before, *::after {
        box-sizing: border-box;
    }
</style>