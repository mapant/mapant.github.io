---

<Layout title="Manoj Pant | Senior Product Manager | Product Portfolio">
  <style>
    /* ======================================================================
       DESIGN SYSTEM
       ====================================================================== */

    :root {
      --navy-950: #0b2443;
      --navy-900: #102f55;
      --navy-800: #163d6a;
      --navy-700: #234f7c;
      --ink: #15385f;
      --ink-soft: #466887;
      --body: #587795;
      --muted: #7890a8;
      --faint: #9aaec1;
      --line: #d8e4ef;
      --line-strong: #c9d9e7;
      --line-soft: #eaf0f5;
      --bg: #f5f8fb;
      --paper: #ffffff;
      --blue: #2167d3;
      --blue-soft: #edf5ff;
      --amber: #c47b0d;
      --amber-bright: #e09a2b;
      --amber-soft: #fff7e9;
      --mint: #17886f;
      --mint-soft: #eefaf6;
      --lav: #7356d5;
      --lav-soft: #f5f1ff;
      --teal: #147c86;
      --teal-soft: #edf9fa;
      --red: #a74a43;
      --shadow-xs: 0 4px 14px rgba(16,47,85,.035);
      --shadow-sm: 0 10px 26px rgba(16,47,85,.055);
      --shadow-md: 0 18px 44px rgba(16,47,85,.08);
      --radius-sm: 10px;
      --radius-md: 16px;
      --radius-lg: 24px;
      --header-h: 112px;
      --max: 1480px;
      --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    /* ======================================================================
       BASE / VIEWPORT
       ====================================================================== */

    * { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      background: var(--bg);
      overflow: hidden;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--sans);
      font-size: 14px;
      line-height: 1.45;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    a { color: inherit; }
    button, a { -webkit-tap-highlight-color: transparent; }

    main {
      height: calc(100dvh - var(--header-h));
      overflow-y: auto;
      overflow-x: hidden;
      scroll-snap-type: y mandatory;
      scrollbar-width: thin;
      scrollbar-color: #b8c9d9 transparent;
    }

    .slide {
      height: calc(100dvh - var(--header-h));
      min-height: 720px;
      width: 100%;
      overflow: hidden;
      position: relative;
      display: flex;
      align-items: center;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      padding: 30px 0 28px;
      isolation: isolate;
    }

    .slide.white { background: var(--paper); }
    .slide.soft { background: var(--bg); }
    .slide.dark { background: var(--navy-900); color: #fff; }

    .wrap {
      width: 100%;
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 34px;
      position: relative;
      z-index: 2;
    }

    /* ======================================================================
       HEADER / NAVIGATION
       ====================================================================== */

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      height: var(--header-h);
      background: rgba(255,255,255,.985);
      border-bottom: 1px solid var(--line);
      backdrop-filter: blur(14px);
    }

    .head {
      height: 100%;
      display: grid;
      grid-template-columns: 240px minmax(0,1fr) 150px;
      gap: 20px;
      align-items: center;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 13px;
      text-decoration: none;
      min-width: 0;
    }

    .brand-logo {
      width: 49px;
      height: 49px;
      flex: 0 0 49px;
      display: grid;
      place-items: center;
      border-radius: 13px;
      background: var(--navy-900);
      color: #fff;
      font-size: 15px;
      font-weight: 900;
      box-shadow: 0 9px 22px rgba(16,47,85,.17);
    }

    .brand-copy {
      min-width: 0;
    }

    .brand-copy b {
      display: block;
      color: var(--navy-900);
      font-size: 18px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: -.025em;
      white-space: nowrap;
    }

    .brand-copy small {
      display: block;
      margin-top: 7px;
      color: var(--muted);
      font-size: 10px;
      line-height: 1;
      font-weight: 850;
      letter-spacing: .12em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    #nav {
      height: 86px;
      display: grid;
      grid-template-columns: repeat(5,minmax(0,1fr));
      grid-template-rows: repeat(2,1fr);
      gap: 5px 8px;
      align-content: center;
      min-width: 0;
    }

    #nav a {
      min-width: 0;
      display: grid;
      place-items: center;
      padding: 8px 8px;
      border-radius: 10px;
      color: var(--ink);
      text-decoration: none;
      font-size: 12.5px;
      line-height: 1;
      font-weight: 800;
      white-space: nowrap;
      transition: background .18s ease, color .18s ease, transform .18s ease;
    }

    #nav a:hover {
      background: #f1f6fb;
      color: var(--blue);
    }

    #nav a.active {
      background: #edf5ff;
      color: var(--blue);
    }

    .nav-cta {
      display: flex;
      justify-content: flex-end;
    }

    .btn {
      min-height: 46px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 19px;
      border-radius: 12px;
      text-decoration: none;
      font-size: 12.5px;
      line-height: 1;
      font-weight: 900;
      white-space: nowrap;
      transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
    }

    .btn.primary {
      background: var(--amber);
      color: #fff;
      box-shadow: 0 10px 24px rgba(196,123,13,.19);
    }

    .btn.primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 13px 28px rgba(196,123,13,.24);
    }

    /* ======================================================================
       TYPOGRAPHY / SECTION HEADERS
       ====================================================================== */

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: var(--amber);
      font-size: 10.5px;
      line-height: 1;
      font-weight: 950;
      letter-spacing: .15em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .eyebrow::before {
      content: "";
      width: 30px;
      height: 3px;
      flex: 0 0 30px;
      background: var(--amber);
      border-radius: 99px;
    }

    .section-head {
      margin-bottom: 22px;
    }

    .section-head h2 {
      margin: 10px 0 8px;
      color: var(--navy-900);
      font-size: clamp(34px, 3.1vw, 50px);
      line-height: .98;
      font-weight: 950;
      letter-spacing: -.052em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: clip;
    }

    .section-head p {
      max-width: 1040px;
      margin: 0;
      color: var(--body);
      font-size: 14.5px;
      line-height: 1.32;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: clip;
    }

    .dark .section-head h2 { color: #fff; }
    .dark .section-head p { color: #b9cbe0; }
    .dark .eyebrow { color: var(--amber-bright); }
    .dark .eyebrow::before { background: var(--amber-bright); }

    .mini-label {
      color: var(--muted);
      font-size: 9px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: .1em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .body-copy {
      margin: 0;
      color: var(--body);
      font-size: 13px;
      line-height: 1.48;
    }

    /* ======================================================================
       GENERIC COMPONENTS
       ====================================================================== */

    .pill-row {
      display: flex;
      align-items: center;
      flex-wrap: nowrap;
      gap: 7px;
      min-width: 0;
    }

    .pill {
      min-height: 29px;
      display: inline-flex;
      align-items: center;
      padding: 0 11px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: #fff;
      color: var(--ink-soft);
      font-size: 9.5px;
      line-height: 1;
      font-weight: 850;
      white-space: nowrap;
    }

    .card {
      min-width: 0;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: var(--paper);
      box-shadow: var(--shadow-xs);
    }

    .number {
      color: var(--amber);
      font-size: 10px;
      line-height: 1;
      font-weight: 950;
      letter-spacing: .06em;
    }

    .soft-rule {
      height: 1px;
      background: var(--line);
      width: 100%;
    }

    .dark-rule {
      height: 1px;
      background: rgba(255,255,255,.11);
      width: 100%;
    }

    /* ======================================================================
       OVERVIEW SLIDE
       ====================================================================== */

    .overview-grid {
      display: grid;
      grid-template-columns: minmax(0,1.04fr) minmax(430px,.96fr);
      gap: 42px;
      align-items: center;
    }

    .overview-title {
      margin: 17px 0 12px;
      max-width: 900px;
      color: var(--navy-900);
      font-size: clamp(47px,4.55vw,68px);
      line-height: .96;
      font-weight: 950;
      letter-spacing: -.06em;
    }

    .overview-lead {
      max-width: 860px;
      margin: 0;
      color: var(--ink-soft);
      font-size: 17px;
      line-height: 1.42;
    }

    .overview-lead strong {
      color: var(--navy-900);
      font-weight: 950;
    }

    .focus-row {
      margin-top: 20px;
      padding-bottom: 19px;
      border-bottom: 1px solid var(--line);
    }

    .focus-row .pill {
      background: transparent;
      border: 0;
      padding: 0;
      min-height: 24px;
      color: var(--ink);
      font-size: 11px;
    }

    .focus-row .pill::after {
      content: "•";
      margin-left: 9px;
      color: var(--amber);
    }

    .focus-row .pill:last-child::after { display: none; }

    .overview-stats {
      display: grid;
      grid-template-columns: repeat(4,minmax(0,1fr));
      gap: 9px;
      margin-top: 16px;
    }

    .overview-stat {
      padding: 14px 14px 13px;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: #fff;
    }

    .overview-stat strong {
      display: block;
      color: var(--navy-900);
      font-size: 23px;
      line-height: 1;
      font-weight: 950;
      letter-spacing: -.035em;
    }

    .overview-stat span {
      display: block;
      margin-top: 6px;
      color: var(--muted);
      font-size: 8.5px;
      line-height: 1.12;
      font-weight: 900;
      letter-spacing: .055em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .career-strip {
      margin-top: 15px;
      display: grid;
      grid-template-columns: repeat(4,1fr);
      border: 1px solid var(--line);
      border-radius: 15px;
      overflow: hidden;
      background: #fff;
    }

    .career-step {
      min-width: 0;
      min-height: 75px;
      padding: 12px 13px;
      border-right: 1px solid var(--line);
    }

    .career-step:last-child { border-right: 0; }

    .career-step .number { font-size: 8.5px; }

    .career-step strong {
      display: block;
      margin-top: 6px;
      color: var(--navy-900);
      font-size: 11px;
      line-height: 1;
      white-space: nowrap;
    }

    .career-step span {
      display: block;
      margin-top: 5px;
      color: var(--body);
      font-size: 8.5px;
      line-height: 1.25;
    }

    .overview-visual {
      min-height: 500px;
      padding: 23px;
      border: 1px solid var(--line);
      border-radius: 28px;
      background:
        radial-gradient(circle at 90% 8%, rgba(33,103,211,.12), transparent 28%),
        radial-gradient(circle at 4% 94%, rgba(196,123,13,.13), transparent 27%),
        #fff;
      box-shadow: var(--shadow-sm);
      position: relative;
      overflow: hidden;
    }

    .visual-top {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      color: var(--muted);
      font-size: 9px;
      line-height: 1;
      font-weight: 950;
      letter-spacing: .1em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .operating-map {
      height: 414px;
      position: relative;
      display: grid;
      place-items: center;
    }

    .operating-center {
      width: 245px;
      height: 125px;
      border-radius: 22px;
      background: var(--navy-900);
      color: #fff;
      display: grid;
      place-items: center;
      text-align: center;
      position: relative;
      z-index: 3;
      box-shadow: 0 20px 42px rgba(16,47,85,.2);
    }

    .operating-center strong {
      display: block;
      font-size: 23px;
      line-height: 1;
      font-weight: 950;
      letter-spacing: -.03em;
