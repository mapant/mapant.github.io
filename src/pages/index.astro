---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Manoj Pant | Senior Product Manager & Data Analytics Portfolio">
    <style>
        :root{
            --navy:#102f55; --navy-2:#163d6a; --navy-3:#214e7d;
            --ink:#102a4d; --ink-2:#365774; --muted:#627c97; --line:#d8e4ef; --line-2:#e8eff5;
            --bg:#f3f7fb; --paper:#fff; --blue:#2468d7; --blue-soft:#eaf2ff;
            --lav:#7658d9; --lav-soft:#f1edff; --mint:#17886f; --mint-soft:#e8f7f2;
            --amber:#be7615; --amber-soft:#fff2df; --rose:#bb3f76; --rose-soft:#fff0f6;
            --teal:#167d87; --teal-soft:#e9f7f8; --radius:18px; --max:1480px; --header-h:110px;
            --shadow:0 12px 30px rgba(22,52,82,.07); --sans:Inter,ui-sans-serif,system-ui,sans-serif;
            --mono:"SFMono-Regular",Consolas,"Liberation Mono",monospace;
        }
        *{box-sizing:border-box}
        html{scroll-behavior:smooth;scroll-padding-top:calc(var(--header-h) + 10px)}
        body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.45;overflow-x:hidden}
        body.locked{overflow:hidden}
        a{text-decoration:none;color:inherit} button,input{font:inherit} button{cursor:pointer} svg,img{max-width:100%;display:block}
        .wrap{width:min(var(--max),calc(100% - 48px));margin:0 auto}
        .hidden{display:none!important}
        #progress{position:fixed;top:0;left:0;height:4px;width:0;background:linear-gradient(90deg,var(--blue),var(--lav));z-index:300}

        /* HEADER */
        header{position:sticky;top:0;z-index:100;background:var(--navy);color:#fff;border-bottom:1px solid rgba(255,255,255,.10);box-shadow:0 10px 24px rgba(8,28,51,.18)}
        .head{height:var(--header-h);display:grid;grid-template-columns:250px minmax(520px,1fr) 290px;gap:16px;align-items:center}
        .brand{display:flex;align-items:center;gap:12px;min-width:0}
        .brand-logo{width:42px;height:42px;border-radius:11px;background:#244f7f;border:1px solid rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-weight:950;color:#fff;font-size:13px}
        .brand-copy{min-width:0}.brand-copy b{display:block;font-size:18px;line-height:1.1;color:#fff;letter-spacing:-.02em}.brand-copy small{display:block;margin-top:5px;color:#c1d2e4;font-size:10px;line-height:1.15;font-weight:900;letter-spacing:.10em;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        #nav{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));grid-template-rows:repeat(2,34px);gap:8px;align-items:center}
        #nav a{height:34px;display:flex;align-items:center;justify-content:center;border-radius:9px;color:#eaf1f7;font-size:12px;font-weight:900;white-space:nowrap;transition:.15s ease}
        #nav a:hover,#nav a.active{background:#234f7f;color:#fff}
        .head-actions{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:42px 42px;gap:7px}.head-actions .action-row{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:7px}.head-actions .btn{height:42px}.portfolio-top{grid-column:1/-1}
        .btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:10px 14px;border:1px solid var(--line);border-radius:11px;background:#fff;color:var(--ink);font-size:12px;font-weight:950;transition:.15s ease}
        .btn:hover{transform:translateY(-1px);box-shadow:0 8px 18px rgba(10,36,65,.12)}.btn.primary{background:var(--navy);border-color:var(--navy);color:#fff}.portfolio-top{background:#2a5c8d;color:#fff;border-color:#547ca5}

        /* SHARED SECTIONS & SLIDE PAGES */
        .section,.ecosystem-wrap{border-bottom:1px solid var(--line-2)}
        .section.white{background:#fff}.section{background:#f6f9fc}
        .fit-section, .slide-page { min-height: calc(100vh - var(--header-h)); display: flex; flex-direction: column; overflow: hidden; }
        .slide-page { border-bottom: 1px solid var(--line-2); }
        .slide-page:last-child { border-bottom: none; }
        .fit-section > .wrap, .slide-page > .wrap { height: 100%; padding: 18px 0 16px; display: flex; flex-direction: column; min-height: 0; flex: 1; justify-content: center; }

        .eyebrow{font-size:11px;line-height:1.15;color:var(--blue);font-weight:950;letter-spacing:.17em;text-transform:uppercase}
        .section-head{display:grid;gap:6px;margin-bottom:14px;flex:none}.section-head h2{margin:4px 0 0;font-size:37px;line-height:1.03;letter-spacing:-.045em;color:var(--ink);font-weight:950;white-space:nowrap}.section-head p{margin:0;color:var(--ink-2);font-size:15px;line-height:1.42}

        /* OVERVIEW */
        .hero{background:linear-gradient(180deg,#f8fbff 0%,#f3f7fb 100%)}
        .hero>.wrap{height:calc(100vh - var(--header-h));padding:16px 0;display:flex;flex-direction:column;min-height:0}
        .hero-copy{display:grid;grid-template-columns:1.18fr .82fr;gap:26px;align-items:center;min-height:0;flex:1}
        .kicker{display:inline-flex;align-items:center;gap:9px;padding:7px 11px;border:1px solid #c8def7;border-radius:999px;background:var(--blue-soft);color:#17539c;font-size:11px;font-weight:950;letter-spacing:.11em;text-transform:uppercase}
        h1{font-size:clamp(50px,4.8vw,70px);line-height:.91;letter-spacing:-.065em;margin:14px 0 12px;color:var(--ink);font-weight:950}
        .lead{font-size:17px;line-height:1.48;color:#42627f;margin:0}.lead strong{color:var(--ink);font-weight:900}
        .hero-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:16px}.safe{margin:10px 0 0;color:#7087a0;font-size:10.5px;line-height:1.35}
        .role-card{border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:var(--shadow);padding:18px}.role-top{display:flex;align-items:center;gap:11px}
        .role-kicker{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:#6d84a0;font-weight:950}
        .role-top h2{margin:3px 0 0;font-size:24px;line-height:1.1;color:var(--ink)}
        .role-list{display:grid;gap:7px;margin-top:13px}.role-list>div{padding:9px 10px;border:1px solid var(--line);border-radius:11px;background:#fff}
        .role-list>div:nth-child(1){background:var(--blue-soft)}.role-list>div:nth-child(2){background:var(--lav-soft)}.role-list>div:nth-child(3){background:var(--mint-soft)}.role-list>div:nth-child(4){background:var(--amber-soft)}
        .role-list b{display:block;color:var(--ink);font-size:12px}.role-list span{display:block;margin-top:2px;color:#54708d;font-size:10.5px;line-height:1.35}
        .quick{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:12px}
        .stat{background:#fff;border:1px solid var(--line);border-top:4px solid var(--blue);border-radius:13px;padding:10px 12px;min-height:66px;display:flex;flex-direction:column;justify-content:center}
        .stat-purple{border-top-color:var(--lav)}.stat-mint{border-top-color:var(--mint)}.stat-rose{border-top-color:var(--rose)}
        .stat strong{font-size:25px;line-height:1;color:var(--ink);letter-spacing:-.04em}.stat span{margin-top:4px;font-size:9.5px;line-height:1.2;color:#607891;font-weight:800}

        /* EXPERTISE / SKILLS */
        .ecosystem-wrap{background:#edf3f8}.ecosystem-panel{height:100%;border:1px solid var(--line);border-radius:22px;background:#fff;box-shadow:var(--shadow);padding:10px}
        .eco-shell{height:100%;border:1px solid #d9e5ef;border-radius:18px;background:#f8fbfd;display:flex;flex-direction:column;overflow:hidden}
        .eco-topbar{height:34px;display:flex;align-items:center;justify-content:space-between;padding:0 14px;background:#fff;border-bottom:1px solid var(--line)}
        .eco-dots{display:flex;gap:6px}.eco-dots i{width:8px;height:8px;border-radius:50%;background:#d2deea}
        .eco-brand{display:flex;align-items:center;gap:6px;color:#566f89;font-size:9px;font-weight:950;letter-spacing:.12em;text-transform:uppercase}
        .eco-stage{flex:1;padding:15px 18px 10px;display:flex;flex-direction:column;min-height:0;justify-content:center}
        .eco-heading{text-align:center;flex:none}.eco-heading h2{margin:0;font-size:28px;line-height:1.05;letter-spacing:-.035em;color:var(--ink);font-weight:950}.eco-heading h2 span{color:var(--blue)}
        .eco-heading p{margin:5px auto 0;max-width:1250px;color:#365a79;font-size:11.5px;line-height:1.4}.eco-heading p strong{font-weight:900;color:var(--ink-2)}
        .eco-board{position:relative;flex:1;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-template-rows:52px 56px 78px 56px 52px;gap:7px;margin:16px auto 0;width:min(1280px,100%);min-height:0}
        .eco-lines{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:0}.eco-lines .ring{fill:none}.eco-lines line{fill:none}
        .eco-core{z-index:2;grid-column:5/9;grid-row:2/5;align-self:center;justify-self:center;width:100%;max-width:320px;min-height:132px;padding:14px 20px;border:2px solid #b9cee4;border-radius:20px;background:#fff;box-shadow:0 14px 30px rgba(26,59,90,.09);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
        .eco-core>b{font-size:23px;line-height:1.02;color:var(--ink);letter-spacing:-.025em}.eco-core>span:last-child{margin-top:7px;font-size:10.5px;line-height:1.3;color:#607892}
        .eco-node{z-index:3;display:flex;align-items:center;gap:8px;padding:7px 10px;border:1px solid #ccdbe8;border-left:4px solid var(--accent);border-radius:12px;background:var(--soft);box-shadow:0 6px 15px rgba(28,57,83,.05);color:var(--ink);min-width:0;min-height:0;transition:.15s ease}
        .eco-node:hover{transform:translateY(-2px);box-shadow:0 11px 22px rgba(28,57,83,.10)}
        .eco-number{width:27px;height:27px;border-radius:8px;background:rgba(255,255,255,.80);display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:10px;font-weight:950;flex:none}
        .eco-copy{min-width:0}.eco-copy b{display:block;font-size:13px;line-height:1.02;white-space:nowrap}.eco-copy span{display:block;margin-top:3px;font-size:9.5px;line-height:1.15;color:#627c97;white-space:nowrap}
        .eco-footnote{text-align:center;margin-top:10px;font-size:10.5px;color:#56718d;font-weight:850;flex:none}
        .eco-12{grid-column:2/5;grid-row:1}.eco-01{grid-column:5/8;grid-row:1}.eco-02{grid-column:8/11;grid-row:1}.eco-11{grid-column:1/4;grid-row:2}.eco-03{grid-column:10/13;grid-row:2}.eco-10{grid-column:1/4;grid-row:3}.eco-04{grid-column:10/13;grid-row:3}.eco-09{grid-column:1/4;grid-row:4}.eco-05{grid-column:10/13;grid-row:4}.eco-08{grid-column:2/5;grid-row:5}.eco-07{grid-column:5/8;grid-row:5}.eco-06{grid-column:8/11;grid-row:5}

        /* EXPERIENCE & BACKGROUND */
        #challenge .story-grid{display:grid;grid-template-columns:1.05fr .95fr;grid-template-rows:auto auto;gap:16px;flex:1;min-height:0;align-content:center}
        .story{border:1px solid var(--line);border-radius:17px;padding:20px;background:var(--blue-soft);box-shadow:var(--shadow);min-height:0}
        .story:nth-child(2){background:var(--lav-soft)}
        .story h3{font-size:24px;line-height:1.10;margin:7px 0;color:var(--ink);letter-spacing:-.025em}
        .story p{font-size:14px;line-height:1.45;color:#4f6d8a;margin:0}
        .story ul{margin:12px 0 0;padding-left:19px;color:#506d89;font-size:12.5px;line-height:1.45}.story li+li{margin-top:5px}

        /* FOOTER */
        footer{color:var(--ink);background:#fff;border-top:1px solid var(--line)}
        .footer-wrap{min-height:calc(100vh - var(--header-h));padding:40px 0;display:grid;grid-template-columns:1fr;gap:16px;align-content:center;position:relative;max-width:860px;margin:0 auto;text-align:center}
        .footer-cta,.footer-meta{position:relative;z-index:1}.footer-cta{margin:0 auto}
        .footer-eyebrow{color:var(--blue);font-weight:950}
        .footer-cta h2{margin:12px 0 14px;font-size:48px;line-height:1.05;letter-spacing:-.05em;color:var(--ink)}
        .footer-cta p{margin:0 auto;color:var(--ink-2);font-size:16px;line-height:1.5}
        .footer-cta-btn{display:inline-flex;margin-top:20px;padding:14px 18px;border:1px solid var(--navy);border-radius:12px;background:var(--navy);color:#fff;font-size:12px;font-weight:950}
    </style>

    <div class="progress" id="progress"></div>

    <header>
        <div class="wrap head">
            <a aria-label="Manoj Pant Portfolio Overview" class="brand" href="#overview">
                <span aria-hidden="true" class="brand-logo">MP</span>
                <span class="brand-copy"><b>Manoj Pant</b><small>Senior Product Manager</small></span>
            </a>
            <nav aria-label="Portfolio sections" id="nav">
                <a href="#overview">Overview</a>
                <a href="#expertise">Expertise</a>
                <a href="#background">Background</a>
                <a href="#analytics">Analytics</a>
                <a href="#contact">Contact</a>
            </nav>
            <div class="head-actions">
                <div class="action-row">
                    <a class="btn light-btn" href="#expertise">View skills →</a>
                    <a class="btn light-btn" href="#background">Experience →</a>
                </div>
                <a class="btn portfolio-top" href="#overview">↑ Back to Top</a>
            </div>
        </div>
    </header>

    <main>
        <section class="hero slide-page" id="overview">
            <div class="wrap">
                <div class="hero-copy">
                    <div class="reveal visible">
                        <span class="kicker">
                            Senior Product Manager · M2P Fintech · Noida
                        </span>
                        <h1>Manoj Pant<br/>Product &amp; Data Leader</h1>
                        <p class="lead">Senior Product Manager at <strong>M2P Fintech</strong> based in Noida. Currently pursuing an MBA from Manipal Academy of Higher Education (MAHE). Deeply experienced in data analytics, business intelligence, and fintech solutions.</p>
                        <div class="hero-actions">
                            <a class="btn primary" href="#expertise">Explore Core Expertise ↓</a>
                            <a class="btn" href="#background">Professional Background ↗</a>
                        </div>
                    </div>
                    <aside class="role-card reveal visible">
                        <div class="role-top">
                            <div>
                                <div class="role-kicker">Current Focus · Career Profile</div>
                                <h2>At a Glance</h2>
                            </div>
                        </div>
                        <div class="role-list">
                            <div><b>Senior Product Manager</b><span>Driving fintech innovation and execution at M2P Fintech.</span></div>
                            <div><b>MBA Candidate</b><span>Advancing business acumen at Manipal Academy of Higher Education (MAHE).</span></div>
                            <div><b>Data Analytics &amp; BI</b><span>Skilled in SQL, Python (Pandas), and Power BI for decision-making.</span></div>
                            <div><b>Market Investing</b><span>Active follower of the Indian stock market and long-term blue-chip investor via Zerodha.</span></div>
                        </div>
                    </aside>
                </div>
                <div class="quick reveal visible">
                    <div class="stat stat-blue"><strong>M2P</strong><span>Fintech Product Management</span></div>
                    <div class="stat stat-purple"><strong>MAHE</strong><span>MBA Candidate</span></div>
                    <div class="stat stat-mint"><strong>Data</strong><span>SQL, Python, Power BI</span></div>
                    <div class="stat stat-rose"><strong>Noida</strong><span>Current Base (Relocated from Mumbai)</span></div>
                </div>
            </div>
        </section>

        <section aria-labelledby="expertise-title" class="ecosystem-wrap slide-page" id="expertise">
            <div class="wrap">
                <div class="ecosystem-panel reveal visible">
                    <div class="eco-shell">
                        <div class="eco-topbar">
                            <div class="eco-dots"><i></i><i></i><i></i></div>
                            <div class="eco-brand">
                                <span>MANOJ PANT</span><span>·</span><span>CORE COMPETENCIES &amp; SKILLS</span>
                            </div>
                        </div>
                        <div class="eco-stage">
                            <div class="eco-heading">
                                <h2 id="expertise-title">PRODUCT &amp; <span>ANALYTICS EXPERTISE</span></h2>
                                <p class="eco-detail"><strong>Combining robust product management methodologies with hands-on technical proficiency in data science, analytics platforms, and fintech systems design.</strong></p>
                            </div>
                            <div class="eco-board">
                                <div class="eco-core">
                                    <b>Product &amp; Data<br/>Leadership</b>
                                    <span>M2P Fintech · MBA · Analytics</span>
                                </div>
                                <div class="eco-node eco-01" style="--accent:#7557d9;--soft:#f1edff"><span class="eco-number">01</span><span class="eco-copy"><b>Product Strategy</b><span>Roadmapping &amp; Vision</span></span></div>
                                <div class="eco-node eco-02" style="--accent:#278f73;--soft:#eaf8f3"><span class="eco-number">02</span><span class="eco-copy"><b>Data Analytics</b><span>Exploratory Data Analysis</span></span></div>
                                <div class="eco-node eco-03" style="--accent:#b97215;--soft:#fff4e3"><span class="eco-number">03</span><span class="eco-copy"><b>Python &amp; Pandas</b><span>Data Processing &amp; Scripting</span></span></div>
                                <div class="eco-node eco-04" style="--accent:#1f64d8;--soft:#eaf2ff"><span class="eco-number">04</span><span class="eco-copy"><b>Advanced SQL</b><span>Queries &amp; Database Mgmt</span></span></div>
                                <div class="eco-node eco-05" style="--accent:#b63e74;--soft:#fff0f6"><span class="eco-number">05</span><span class="eco-copy"><b>Power BI</b><span>Business Intelligence</span></span></div>
                                <div class="eco-node eco-06" style="--accent:#1f64d8;--soft:#eaf2ff"><span class="eco-number">06</span><span class="eco-copy"><b>Fintech Domain</b><span>Payments &amp; Banking Ecosystem</span></span></div>
                                <div class="eco-node eco-07" style="--accent:#177e8b;--soft:#eaf8fa"><span class="eco-number">07</span><span class="eco-copy"><b>Market Investing</b><span>Equities &amp; Blue-chip Portfolios</span></span></div>
                                <div class="eco-node eco-08" style="--accent:#1f64d8;--soft:#eaf2ff"><span class="eco-number">08</span><span class="eco-copy"><b>Agile Delivery</b><span>Scrum &amp; Execution</span></span></div>
                                <div class="eco-node eco-09" style="--accent:#b97215;--soft:#fff4e3"><span class="eco-number">09</span><span class="eco-copy"><b>Stakeholder Mgmt</b><span>Cross-functional Leadership</span></span></div>
                                <div class="eco-node eco-10" style="--accent:#b63e74;--soft:#fff0f6"><span class="eco-number">10</span><span class="eco-copy"><b>Business Acumen</b><span>Management Accounting</span></span></div>
                                <div class="eco-node eco-11" style="--accent:#1f64d8;--soft:#eaf2ff"><span class="eco-number">11</span><span class="eco-copy"><b>User Research</b><span>Discovery &amp; Feedback Loops</span></span></div>
                                <div class="eco-node eco-12" style="--accent:#7557d9;--soft:#f1edff"><span class="eco-number">12</span><span class="eco-copy"><b>Academic Rigor</b><span>MBA Coursework &amp; Exams</span></span></div>
                            </div>
                            <div class="eco-footnote">Core professional pillars bridging product management, analytics, and business strategy</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section white slide-page" id="background">
            <div class="wrap">
                <div class="section-head">
                    <div>
                        <span class="eyebrow">Professional &amp; Academic Journey</span>
                        <h2>Background &amp; Experience</h2>
                    </div>
                    <p>Overview of career progression, ongoing educational milestones, and relocation to Noida.</p>
                </div>
                <div class="story-grid">
                    <div class="story reveal">
                        <span class="eyebrow">Current Role</span>
                        <h3>Senior Product Manager at M2P Fintech</h3>
                        <p>Leading product initiatives, bridging technical constraints with business objectives, and managing complex product lifecycles in the fintech space.</p>
                        <ul>
                            <li>Spearheading product features and executing growth strategies.</li>
                            <li>Collaborating closely with engineering, compliance, and business teams.</li>
                            <li>Recently relocated from Mumbai to Noida, continuing remote/onsite collaboration seamlessly.</li>
                        </ul>
                    </div>
                    <div class="story reveal">
                        <span class="eyebrow">Education &amp; Growth</span>
                        <h3>MBA from Manipal Academy of Higher Education</h3>
                        <p>Pursuing higher education alongside active professional commitments, focusing on management accounting, database management, and programming with R and Python.</p>
                        <ul>
                            <li>Certified in Exploratory Data Analysis from the University of Illinois Urbana-Champaign.</li>
                            <li>Strong emphasis on quantitative analysis, SQL, and business intelligence dashboards.</li>
                            <li>Active investor in blue-chip equities via Zerodha, maintaining a strong grasp of market economics.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="slide-page" id="contact" style="border-bottom: none;">
        <div class="wrap" style="align-items: center;">
            <div class="footer-wrap">
                <div class="footer-cta">
                    <span class="eyebrow footer-eyebrow">Get in touch</span>
                    <h2>Let's connect and discuss product opportunities</h2>
                    <p>Whether you're looking to talk fintech product management, data analytics, or strategic collaborations in the Delhi NCR region, feel free to reach out.</p>
                    <div class="footer-cta-btn">Connect with Manoj Pant →</div>
                </div>
            </div>
        </div>
    </footer>

    <script is:inline>
        const header=document.querySelector('header');
        function getHeaderOffset(){return (header?.getBoundingClientRect().height || 0)+10;}
        function scrollToSection(id,updateHash=true){
            const target=document.getElementById(id); if(!target)return;
            const top=target.getBoundingClientRect().top+window.scrollY-getHeaderOffset();
            window.scrollTo({top:Math.max(0,top),behavior:'smooth'});
            if(updateHash)history.replaceState({section:id},'', '#'+id);
        }
        document.querySelectorAll('a[href^="#"]').forEach(a=>a.addEventListener('click',e=>{
            const href=a.getAttribute('href')||'';
            if(!href.startsWith('#')||href==='#')return;
            const id=href.slice(1),target=document.getElementById(id); if(!target)return;
            e.preventDefault(); scrollToSection(id,true);
        }));
        window.addEventListener('scroll',()=>{const h=document.documentElement,max=h.scrollHeight-h.clientHeight; document.getElementById('progress').style.width=(max>0?(h.scrollTop/max)*100:0)+'%'},{passive:true});
    </script>
</Layout>