---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Manoj Pant | Senior Product Manager">
    <style>
        html { scroll-behavior: smooth; }
        body { margin: 0; }
        .portfolio-shell { scroll-behavior: smooth; }
        .slide { height: calc(100vh - 96px); min-height: calc(100vh - 96px); scroll-margin-top: 96px; scroll-snap-align: start; overflow: hidden; }
        .section-pad { padding: 34px 42px 24px; }
        .content-wide { width: 100%; padding-left: 42px; padding-right: 42px; }
        .eyebrow { letter-spacing: .22em; }
        .gold { color: #b58b43; }
        .dark { background: #172033; }
        .soft { background: #f7f8fa; }
        .line { border-color: rgba(148,163,184,.28); }
        .card { background: white; border: 1px solid #e5e7eb; border-radius: 16px; }
        .dark-card { background: rgba(255,255,255,.055); border: 1px solid rgba(255,255,255,.13); border-radius: 16px; }
        .metric { font-variant-numeric: tabular-nums; }
        .nav-row a { min-height: 38px; display:flex; align-items:center; justify-content:center; }
        @media (max-width: 900px) {
            .section-pad, .content-wide { padding-left: 22px; padding-right: 22px; }
        }
        @media (max-width: 640px) {
            .slide { height: auto; min-height: calc(100vh - 96px); overflow: visible; }
        }
    </style>

    <!-- =========================================================
         SINGLE-FILE PORTFOLIO
         Every "slide" below is a <section>. No separate files.
         ========================================================= -->

    <!-- HEADER / 10 NAV BUTTONS IN TWO ROWS -->
    <header class="sticky top-0 z-50 h-[96px] dark text-white shadow-lg overflow-hidden">
        <div class="content-wide py-3">
            <div class="flex items-center justify-between gap-5 mb-3">
                <div>
                    <div class="text-[18px] sm:text-[20px] font-black tracking-tight">MANOJ PANT</div>
                    <div class="text-[10px] sm:text-[11px] text-slate-300 uppercase tracking-[.18em]">Senior Product Manager · Technical Product Management</div>
                </div>
                <a href="#contact" class="hidden sm:inline-flex px-4 py-2 rounded-lg border border-[#b58b43] text-[11px] font-black uppercase tracking-wider hover:bg-[#b58b43] transition">Let's Connect</a>
            </div>
            <div class="nav-row grid grid-cols-5 gap-1.5 text-[9px] sm:text-[10px] font-black uppercase tracking-wider">
                <a href="#overview" class="rounded-md bg-white/10 hover:bg-[#b58b43] transition">Overview</a>
                <a href="#story" class="rounded-md bg-white/10 hover:bg-[#b58b43] transition">Product Story</a>
                <a href="#journey" class="rounded-md bg-white/10 hover:bg-[#b58b43] transition">Journey</a>
                <a href="#portfolio" class="rounded-md bg-white/10 hover:bg-[#b58b43] transition">Portfolio</a>
                <a href="#integrated" class="rounded-md bg-white/10 hover:bg-[#b58b43] transition">Integrated Channels</a>
                <a href="#lifecycle" class="rounded-md bg-white/10 hover:bg-[#b58b43] transition">Lifecycle</a>
                <a href="#architecture" class="rounded-md bg-white/10 hover:bg-[#b58b43] transition">Architecture</a>
                <a href="#casestudies" class="rounded-md bg-white/10 hover:bg-[#b58b43] transition">Case Studies</a>
                <a href="#analytics-ai" class="rounded-md bg-white/10 hover:bg-[#b58b43] transition">Analytics & AI</a>
                <a href="#contact" class="rounded-md bg-[#b58b43] text-white hover:bg-[#c59a57] transition">Contact</a>
            </div>
        </div>
    </header>

    <main class="portfolio-shell snap-y snap-mandatory overflow-y-auto h-[calc(100vh-96px)]">

        <!-- =====================================================
             SLIDE 01 — OVERVIEW
             ===================================================== -->
        <section id="overview" class="slide dark text-white flex flex-col">
            <div class="section-pad flex-1 flex items-center">
                <div class="w-full grid lg:grid-cols-[1.45fr_.75fr] gap-8 items-center">
                    <div>
                        <div class="gold text-[11px] font-black eyebrow uppercase mb-4">Senior Product Manager · Enterprise Product Leadership</div>
                        <h1 class="text-[38px] sm:text-[54px] xl:text-[64px] leading-[.98] font-black tracking-tight max-w-[980px]">
                            Building enterprise products from problem to measurable impact.
                        </h1>
                        <p class="mt-5 text-[15px] sm:text-[17px] leading-relaxed text-slate-300 max-w-[900px]">
                            10+ years across FinTech, Telecom, HealthTech and Enterprise IT, combining product strategy,
                            business analysis, technical solutioning, data & analytics, workflow automation and Agile delivery.
                        </p>
                        <div class="mt-7 flex flex-wrap gap-2.5">
                            <span class="px-3 py-2 rounded-lg bg-white/8 border border-white/10 text-[11px] font-bold">Product Strategy</span>
                            <span class="px-3 py-2 rounded-lg bg-white/8 border border-white/10 text-[11px] font-bold">Enterprise SaaS</span>
                            <span class="px-3 py-2 rounded-lg bg-white/8 border border-white/10 text-[11px] font-bold">Technical PM</span>
                            <span class="px-3 py-2 rounded-lg bg-white/8 border border-white/10 text-[11px] font-bold">Data & Analytics</span>
                            <span class="px-3 py-2 rounded-lg bg-white/8 border border-white/10 text-[11px] font-bold">AI / Automation</span>
                        </div>
                    </div>

                    <div class="dark-card p-6 sm:p-7">
                        <div class="text-[11px] uppercase tracking-[.18em] text-slate-400 font-black mb-4">Product Profile</div>
                        <div class="grid grid-cols-2 gap-3">
                            <div class="border-t border-white/10 pt-4">
                                <div class="metric text-[28px] font-black">10+</div>
                                <div class="text-[10px] uppercase tracking-wider text-slate-400">Years</div>
                            </div>
                            <div class="border-t border-white/10 pt-4">
                                <div class="metric text-[28px] font-black">4</div>
                                <div class="text-[10px] uppercase tracking-wider text-slate-400">Industries</div>
                            </div>
                            <div class="border-t border-white/10 pt-4">
                                <div class="metric text-[28px] font-black">12+</div>
                                <div class="text-[10px] uppercase tracking-wider text-slate-400">Enterprise Apps</div>
                            </div>
                            <div class="border-t border-white/10 pt-4">
                                <div class="metric text-[28px] font-black">0→1</div>
                                <div class="text-[10px] uppercase tracking-wider text-slate-400">Products</div>
                            </div>
                        </div>
                        <div class="mt-5 pt-4 border-t border-white/10 text-[12px] leading-relaxed text-slate-300">
                            <strong class="text-white">Core strength:</strong> translating complex business problems into
                            structured product requirements, scalable workflows, technical designs and measurable outcomes.
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-wide pb-4 flex justify-between text-[10px] uppercase tracking-[.18em] text-slate-400">
                <span>01 / Overview</span><a href="#story" class="hover:text-white">Next: Product Story →</a>
            </div>
        </section>

        <!-- =====================================================
             SLIDE 02 — PRODUCT STORY
             ===================================================== -->
        <section id="story" class="slide soft flex flex-col">
            <div class="section-pad flex-1 flex flex-col justify-center">
                <div class="gold text-[11px] font-black eyebrow uppercase">Product Story</div>
                <h2 class="text-[32px] sm:text-[44px] font-black text-[#111827] tracking-tight mt-2">A product career built in layers.</h2>
                <p class="mt-3 text-[14px] sm:text-[15px] text-slate-600 max-w-[980px] leading-relaxed">
                    The progression is not a jump from analytics into product management. It is a continuous build-up of
                    analytical thinking, business analysis, technical understanding, stakeholder leadership and product ownership.
                </p>

                <div class="mt-7 grid md:grid-cols-4 gap-4">
                    <div class="card p-5">
                        <div class="gold text-[10px] font-black uppercase tracking-wider">01 · Foundation</div>
                        <h3 class="mt-2 text-[18px] font-black">Data & Analytics</h3>
                        <p class="mt-2 text-[12px] text-slate-600 leading-relaxed">SQL, Power BI, Tableau, KPI frameworks, reporting automation, data validation and operational insights.</p>
                    </div>
                    <div class="card p-5">
                        <div class="gold text-[10px] font-black uppercase tracking-wider">02 · Problem Solving</div>
                        <h3 class="mt-2 text-[18px] font-black">Business Analysis</h3>
                        <p class="mt-2 text-[12px] text-slate-600 leading-relaxed">Requirement elicitation, BRD/FRD, process mapping, gap analysis, business cases and stakeholder workshops.</p>
                    </div>
                    <div class="card p-5">
                        <div class="gold text-[10px] font-black uppercase tracking-wider">03 · Product Ownership</div>
                        <h3 class="mt-2 text-[18px] font-black">Product Management</h3>
                        <p class="mt-2 text-[12px] text-slate-600 leading-relaxed">Discovery, roadmap, prioritization, PRD, user stories, acceptance criteria, UAT, releases and adoption.</p>
                    </div>
                    <div class="card p-5">
                        <div class="gold text-[10px] font-black uppercase tracking-wider">04 · Enterprise Leadership</div>
                        <h3 class="mt-2 text-[18px] font-black">Technical PM</h3>
                        <p class="mt-2 text-[12px] text-slate-600 leading-relaxed">APIs, integrations, DFDs, ER mapping, architecture collaboration, regulated workflows and multi-client delivery.</p>
                    </div>
                </div>

                <div class="mt-5 grid md:grid-cols-3 gap-4">
                    <div class="dark p-4 rounded-xl text-white">
                        <div class="text-[10px] uppercase tracking-wider text-slate-400">Think</div>
                        <div class="mt-1 text-[15px] font-black">Data + Customer + Business</div>
                    </div>
                    <div class="dark p-4 rounded-xl text-white">
                        <div class="text-[10px] uppercase tracking-wider text-slate-400">Design</div>
                        <div class="mt-1 text-[15px] font-black">Workflow + Technology + Experience</div>
                    </div>
                    <div class="dark p-4 rounded-xl text-white">
                        <div class="text-[10px] uppercase tracking-wider text-slate-400">Deliver</div>
                        <div class="mt-1 text-[15px] font-black">Agile + Governance + Measurable Impact</div>
                    </div>
                </div>
            </div>
            <div class="content-wide pb-4 flex justify-between text-[10px] uppercase tracking-[.18em] text-slate-400">
                <a href="#overview" class="hover:text-slate-800">← Prev</a><span>02 / Product Story</span><a href="#journey" class="hover:text-slate-800">Next →</a>
            </div>
        </section>

        <!-- =====================================================
             SLIDE 03 — JOURNEY
             ===================================================== -->
        <section id="journey" class="slide bg-white flex flex-col">
            <div class="section-pad flex-1 flex flex-col justify-center">
                <div class="gold text-[11px] font-black eyebrow uppercase">Career Journey</div>
                <h2 class="text-[32px] sm:text-[42px] font-black text-[#111827] tracking-tight mt-2">From reporting and analytics to enterprise product leadership.</h2>

                <div class="mt-7 grid md:grid-cols-4 gap-4">
                    <article class="card p-5 border-t-4 border-t-[#b58b43]">
                        <div class="text-[10px] font-black gold uppercase tracking-wider">2016–2019</div>
                        <h3 class="mt-2 text-[19px] font-black">Nokia Networks</h3>
                        <div class="text-[11px] font-bold text-slate-500 mt-1">Reporting Analyst</div>
                        <ul class="mt-3 space-y-1.5 text-[12px] text-slate-600">
                            <li>• Power BI / Tableau / SQL</li><li>• KPI & executive reporting</li><li>• Reporting automation</li><li>• Operational analytics</li>
                        </ul>
                    </article>
                    <article class="card p-5 border-t-4 border-t-[#b58b43]">
                        <div class="text-[10px] font-black gold uppercase tracking-wider">2019–2023</div>
                        <h3 class="mt-2 text-[19px] font-black">Nokia Networks</h3>
                        <div class="text-[11px] font-bold text-slate-500 mt-1">Business Analyst</div>
                        <ul class="mt-3 space-y-1.5 text-[12px] text-slate-600">
                            <li>• BRD / FRD / process flows</li><li>• Requirement analysis</li><li>• Business cases & KPIs</li><li>• Agile enterprise programs</li>
                        </ul>
                    </article>
                    <article class="card p-5 border-t-4 border-t-[#b58b43]">
                        <div class="text-[10px] font-black gold uppercase tracking-wider">2023–2024</div>
                        <h3 class="mt-2 text-[19px] font-black">Ayu Health</h3>
                        <div class="text-[11px] font-bold text-slate-500 mt-1">Product Manager</div>
                        <ul class="mt-3 space-y-1.5 text-[12px] text-slate-600">
                            <li>• 0→1 Ayu DocConnect</li><li>• Doctor onboarding</li><li>• Payout automation</li><li>• Adoption & workflow optimization</li>
                        </ul>
                    </article>
                    <article class="card p-5 border-t-4 border-t-[#b58b43]">
                        <div class="text-[10px] font-black gold uppercase tracking-wider">2024–2026</div>
                        <h3 class="mt-2 text-[19px] font-black">Phoneme → M2P</h3>
                        <div class="text-[11px] font-bold text-slate-500 mt-1">Product Manager → Senior PM</div>
                        <ul class="mt-3 space-y-1.5 text-[12px] text-slate-600">
                            <li>• Enterprise platforms</li><li>• Lending / payments / AML</li><li>• APIs & integrations</li><li>• Multi-client product delivery</li>
                        </ul>
                    </article>
                </div>

                <div class="mt-6 p-4 rounded-xl bg-[#172033] text-white flex flex-wrap items-center justify-between gap-4">
                    <div><span class="gold text-[10px] uppercase tracking-wider font-black">Career pattern</span><div class="text-[15px] font-black mt-1">Data → Analysis → Product → Technical Product Leadership</div></div>
                    <div class="text-[12px] text-slate-300">Analytics foundation remains a product advantage.</div>
                </div>
            </div>
            <div class="content-wide pb-4 flex justify-between text-[10px] uppercase tracking-[.18em] text-slate-400">
                <a href="#story">← Prev</a><span>03 / Journey</span><a href="#portfolio">Next →</a>
            </div>
        </section>

        <!-- =====================================================
             SLIDE 04 — PORTFOLIO MAP
             ===================================================== -->
        <section id="portfolio" class="slide soft flex flex-col">
            <div class="section-pad flex-1">
                <div class="gold text-[11px] font-black eyebrow uppercase">Product Portfolio</div>
                <h2 class="text-[32px] sm:text-[42px] font-black text-[#111827] mt-2">Products across enterprise platforms, healthcare and analytics.</h2>
                <p class="mt-2 text-[14px] text-slate-600">A portfolio view before going deep into individual case studies.</p>

                <div class="mt-6 grid lg:grid-cols-3 gap-5">
                    <div class="dark text-white rounded-2xl p-6">
                        <div class="gold text-[10px] font-black uppercase tracking-wider">FinTech · Enterprise</div>
                        <h3 class="text-[22px] font-black mt-2">Integrated Channels Suite</h3>
                        <p class="text-[12px] text-slate-300 mt-2 leading-relaxed">Multi-module banking ecosystem covering lending, AML/KYC, reconciliation, treasury, documents, audit and adjacent banking workflows.</p>
                        <div class="mt-4 flex flex-wrap gap-1.5">
                            <span class="dark-card px-2 py-1 text-[10px]">LOS/LMS</span><span class="dark-card px-2 py-1 text-[10px]">AML/KYC</span><span class="dark-card px-2 py-1 text-[10px]">Reconciliation</span><span class="dark-card px-2 py-1 text-[10px]">Treasury</span>
                        </div>
                    </div>
                    <div class="card p-6">
                        <div class="gold text-[10px] font-black uppercase tracking-wider">HealthTech · 0→1</div>
                        <h3 class="text-[22px] font-black mt-2">Ayu DocConnect</h3>
                        <p class="text-[12px] text-slate-600 mt-2 leading-relaxed">Doctor onboarding, treatment workflows, engagement and payout operations across hospital networks.</p>
                        <div class="mt-4 grid grid-cols-2 gap-2">
                            <div class="bg-slate-50 rounded-lg p-3"><b class="text-[18px]">40→75%</b><div class="text-[9px] uppercase text-slate-500">Adoption</div></div>
                            <div class="bg-slate-50 rounded-lg p-3"><b class="text-[18px]">10→2</b><div class="text-[9px] uppercase text-slate-500">Days TAT</div></div>
                        </div>
                    </div>
                    <div class="card p-6">
                        <div class="gold text-[10px] font-black uppercase tracking-wider">Telecom · Analytics</div>
                        <h3 class="text-[22px] font-black mt-2">Enterprise Insights</h3>
                        <p class="text-[12px] text-slate-600 mt-2 leading-relaxed">Power BI, Tableau and SQL-driven reporting, KPI frameworks, financial tracking, workflow analytics and operational decision support.</p>
                        <div class="mt-4 flex flex-wrap gap-1.5">
                            <span class="bg-slate-100 px-2 py-1 rounded text-[10px]">Power BI</span><span class="bg-slate-100 px-2 py-1 rounded text-[10px]">SQL</span><span class="bg-slate-100 px-2 py-1 rounded text-[10px]">KPIs</span><span class="bg-slate-100 px-2 py-1 rounded text-[10px]">Automation</span>
                        </div>
                    </div>
                </div>

                <div class="mt-5 grid grid-cols-2 md:grid-cols-5 gap-3">
                    <div class="card p-3 text-center"><b class="text-[12px]">LOS–LMS</b><div class="text-[9px] text-slate-500 mt-1">Lending</div></div>
                    <div class="card p-3 text-center"><b class="text-[12px]">UPI Collections</b><div class="text-[9px] text-slate-500 mt-1">Payments</div></div>
                    <div class="card p-3 text-center"><b class="text-[12px]">AML/KYC</b><div class="text-[9px] text-slate-500 mt-1">Financial Crime</div></div>
                    <div class="card p-3 text-center"><b class="text-[12px]">CKYC/DMS</b><div class="text-[9px] text-slate-500 mt-1">Onboarding</div></div>
                    <div class="card p-3 text-center"><b class="text-[12px]">Payout Automation</b><div class="text-[9px] text-slate-500 mt-1">Workflow</div></div>
                </div>
            </div>
            <div class="content-wide pb-4 flex justify-between text-[10px] uppercase tracking-[.18em] text-slate-400">
                <a href="#journey">← Prev</a><span>04 / Portfolio</span><a href="#integrated">Next →</a>
            </div>
        </section>

        <!-- =====================================================
             SLIDE 05 — INTEGRATED CHANNELS
             ===================================================== -->
        <section id="integrated" class="slide dark text-white flex flex-col">
            <div class="section-pad flex-1 flex flex-col justify-center">
                <div class="gold text-[11px] font-black eyebrow uppercase">Flagship Product · M2P</div>
                <div class="flex flex-wrap items-end justify-between gap-4">
                    <h2 class="text-[32px] sm:text-[46px] font-black tracking-tight mt-2">Integrated Channels Suite</h2>
                    <span class="px-3 py-2 rounded-lg border border-[#b58b43] text-[10px] uppercase tracking-wider font-black">Enterprise Banking Platform</span>
                </div>

                <div class="mt-6 grid lg:grid-cols-[1.1fr_1fr] gap-6">
                    <div>
                        <div class="text-[12px] uppercase tracking-wider text-slate-400 font-black">Product challenge</div>
                        <p class="mt-2 text-[15px] leading-relaxed text-slate-200">
                            Banking organizations operate across multiple workflows, systems, regulatory controls and external
                            integrations. The product approach was to provide configurable domain applications with shared
                            patterns and integration-ready capabilities rather than isolated point solutions.
                        </p>

                        <div class="mt-5 grid grid-cols-3 gap-2">
                            <div class="dark-card p-3"><b class="text-[18px]">12+</b><div class="text-[9px] text-slate-400 uppercase">Applications</div></div>
                            <div class="dark-card p-3"><b class="text-[18px]">Banks</b><div class="text-[9px] text-slate-400 uppercase">& NBFCs</div></div>
                            <div class="dark-card p-3"><b class="text-[18px]">API</b><div class="text-[9px] text-slate-400 uppercase">Integration</div></div>
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-2 text-[10px]">
                        <div class="dark-card p-3"><b>LOS</b><div class="text-slate-400 mt-1">Origination</div></div>
                        <div class="dark-card p-3"><b>LMS</b><div class="text-slate-400 mt-1">Management</div></div>
                        <div class="dark-card p-3"><b>AML/KYC</b><div class="text-slate-400 mt-1">Compliance</div></div>
                        <div class="dark-card p-3"><b>CKYC</b><div class="text-slate-400 mt-1">Identity</div></div>
                        <div class="dark-card p-3"><b>DMS</b><div class="text-slate-400 mt-1">Documents</div></div>
                        <div class="dark-card p-3"><b>Reconciliation</b><div class="text-slate-400 mt-1">Controls</div></div>
                        <div class="dark-card p-3"><b>Treasury</b><div class="text-slate-400 mt-1">Liquidity</div></div>
                        <div class="dark-card p-3"><b>GST</b><div class="text-slate-400 mt-1">Tax workflow</div></div>
                        <div class="dark-card p-3"><b>Audit</b><div class="text-slate-400 mt-1">Governance</div></div>
                    </div>
                </div>

                <div class="mt-5 p-4 rounded-xl bg-white/5 border border-white/10">
                    <div class="text-[10px] uppercase tracking-wider text-slate-400 font-black">Product proposition</div>
                    <div class="mt-1 text-[16px] font-black">Configurable workflows + API-driven integrations + domain applications + enterprise governance</div>
                </div>
            </div>
            <div class="content-wide pb-4 flex justify-between text-[10px] uppercase tracking-[.18em] text-slate-400">
                <a href="#portfolio" class="hover:text-white">← Prev</a><span>05 / Integrated Channels</span><a href="#lifecycle" class="hover:text-white">Next →</a>
            </div>
        </section>

        <!-- =====================================================
             SLIDE 06 — PRODUCT LIFECYCLE
             ===================================================== -->
        <section id="lifecycle" class="slide soft flex flex-col">
            <div class="section-pad flex-1 flex flex-col justify-center">
                <div class="gold text-[11px] font-black eyebrow uppercase">Product Lifecycle</div>
                <h2 class="text-[32px] sm:text-[42px] font-black tracking-tight text-[#111827] mt-2">From problem discovery to production adoption.</h2>

                <div class="mt-6 grid grid-cols-2 lg:grid-cols-4 gap-3">
                    <div class="card p-4"><span class="gold font-black text-[10px]">01</span><h3 class="font-black mt-1">Discover</h3><p class="text-[11px] text-slate-600 mt-1">Stakeholder interviews, workshops, current-state mapping, pain points and objectives.</p></div>
                    <div class="card p-4"><span class="gold font-black text-[10px]">02</span><h3 class="font-black mt-1">Define</h3><p class="text-[11px] text-slate-600 mt-1">Problem statement, scope, BRD/PRD, use cases, user stories and acceptance criteria.</p></div>
                    <div class="card p-4"><span class="gold font-black text-[10px]">03</span><h3 class="font-black mt-1">Prioritize</h3><p class="text-[11px] text-slate-600 mt-1">Business value, urgency, risk, dependencies, effort and roadmap sequencing.</p></div>
                    <div class="card p-4"><span class="gold font-black text-[10px]">04</span><h3 class="font-black mt-1">Design</h3><p class="text-[11px] text-slate-600 mt-1">Figma, process flows, DFD, ER mapping, API specifications and workflow rules.</p></div>
                    <div class="card p-4"><span class="gold font-black text-[10px]">05</span><h3 class="font-black mt-1">Build</h3><p class="text-[11px] text-slate-600 mt-1">Backlog, sprint planning, engineering collaboration, QA and dependency management.</p></div>
                    <div class="card p-4"><span class="gold font-black text-[10px]">06</span><h3 class="font-black mt-1">Validate</h3><p class="text-[11px] text-slate-600 mt-1">UAT, business validation, defect triage, compliance checks and stakeholder demos.</p></div>
                    <div class="card p-4"><span class="gold font-black text-[10px]">07</span><h3 class="font-black mt-1">Launch</h3><p class="text-[11px] text-slate-600 mt-1">Deployment, migration, training, manuals, rollout planning and production readiness.</p></div>
                    <div class="card p-4"><span class="gold font-black text-[10px]">08</span><h3 class="font-black mt-1">Improve</h3><p class="text-[11px] text-slate-600 mt-1">Adoption, KPI monitoring, feedback, enhancements, operational analytics and roadmap refinement.</p></div>
                </div>

