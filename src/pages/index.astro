    .tech-panel-title {
      margin: 15px 0 0;
      color: #fff;
      font-size: 22px;
      line-height: 1.03;
      font-weight: 950;
      letter-spacing: -.035em;
    }

    .tech-panel-sub {
      margin: 7px 0 0;
      color: #9fb8d0;
      font-size: 9px;
      line-height: 1.35;
    }

    .tech-layers {
      display: grid;
      gap: 7px;
      margin-top: 18px;
      position: relative;
      z-index: 2;
    }

    .tech-layer {
      min-height: 55px;
      display: grid;
      grid-template-columns: 25px 105px minmax(0,1fr);
      gap: 10px;
      align-items: center;
      padding: 10px 12px;
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 12px;
      background: rgba(255,255,255,.035);
    }

    .tech-layer .number {
      color: var(--amber-bright);
      font-size: 8px;
    }

    .tech-layer strong {
      color: #fff;
      font-size: 9.5px;
      line-height: 1.1;
      white-space: nowrap;
    }

    .tech-layer span {
      color: #9fb8d0;
      font-size: 7.8px;
      line-height: 1.2;
      white-space: nowrap;
    }

    .tool-row {
      margin-top: 10px;
      display: grid;
      grid-template-columns: repeat(5,1fr);
      gap: 6px;
    }

    .tool {
      min-height: 38px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 9px;
      color: #dbe6f1;
      font-size: 7.5px;
      font-weight: 850;
      white-space: nowrap;
    }

    /* ======================================================================
       OUTCOMES SLIDE
       ====================================================================== */

    .outcomes-intro {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 19px;
    }

    .outcomes-intro .section-head { margin-bottom: 0; }

    .outcomes-note {
      width: 290px;
      flex: 0 0 290px;
      padding: 13px 14px;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: var(--bg);
    }

    .outcomes-note strong {
      display: block;
      color: var(--navy-900);
      font-size: 9px;
      line-height: 1;
      white-space: nowrap;
    }

    .outcomes-note span {
      display: block;
      margin-top: 5px;
      color: var(--body);
      font-size: 8px;
      line-height: 1.3;
    }

    .outcomes-grid {
      display: grid;
      grid-template-columns: repeat(6,minmax(0,1fr));
      gap: 9px;
    }

    .outcome-card {
      height: 246px;
      padding: 20px;
      border-radius: 18px;
      background: var(--navy-900);
      color: #fff;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }

    .outcome-card::after {
      content: "";
      position: absolute;
      width: 120px;
      height: 120px;
      right: -55px;
      top: -55px;
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 50%;
    }

    .outcome-card strong {
      color: var(--amber-bright);
      font-size: 29px;
      line-height: 1;
      font-weight: 950;
      letter-spacing: -.035em;
      white-space: nowrap;
      position: relative;
      z-index: 2;
    }

    .outcome-card h3 {
      margin: 0;
      color: #fff;
      font-size: 13px;
      line-height: 1.16;
      font-weight: 900;
      position: relative;
      z-index: 2;
    }

    .outcome-card span {
      color: #8fa8c0;
      font-size: 7.5px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
      white-space: nowrap;
      position: relative;
      z-index: 2;
    }

    .outcome-summary {
      margin-top: 12px;
      display: grid;
      grid-template-columns: repeat(4,1fr);
      gap: 8px;
    }

    .outcome-summary-item {
      padding: 11px 13px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #fff;
    }

    .outcome-summary-item strong {
      display: block;
      color: var(--navy-900);
      font-size: 9px;
      line-height: 1;
      white-space: nowrap;
    }

    .outcome-summary-item span {
      display: block;
      margin-top: 4px;
      color: var(--body);
      font-size: 7.5px;
      line-height: 1.2;
    }

    /* ======================================================================
       CONNECT SLIDE
       ====================================================================== */

    .contact-grid {
      display: grid;
      grid-template-columns: minmax(0,1.12fr) minmax(360px,.88fr);
      gap: 45px;
      align-items: center;
    }

    .contact-title {
      margin: 16px 0 12px;
      color: #fff;
      font-size: clamp(45px,4.2vw,64px);
      line-height: .97;
      font-weight: 950;
      letter-spacing: -.06em;
      white-space: nowrap;
    }

    .contact-copy {
      max-width: 850px;
      margin: 0;
      color: #b8cbe0;
      font-size: 15px;
      line-height: 1.42;
    }

    .contact-focus {
      margin-top: 20px;
      display: flex;
      gap: 7px;
      flex-wrap: nowrap;
    }

    .contact-focus .pill {
      border-color: rgba(255,255,255,.13);
      background: rgba(255,255,255,.045);
      color: #fff;
    }

    .contact-card {
      padding: 25px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 23px;
      background: rgba(255,255,255,.035);
      box-shadow: 0 18px 40px rgba(0,0,0,.1);
    }

    .contact-link {
      min-height: 49px;
      margin-top: 9px;
      padding: 0 15px;
      display: flex;
      align-items: center;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 12px;
      color: #fff;
      text-decoration: none;
      font-size: 11px;
      line-height: 1;
      font-weight: 850;
      white-space: nowrap;
    }

    .contact-link.primary {
      background: var(--amber);
      border-color: var(--amber);
      box-shadow: 0 9px 20px rgba(196,123,13,.17);
    }

    .contact-link:hover { background-color: rgba(255,255,255,.07); }
    .contact-link.primary:hover { background-color: #d18718; }

    .contact-foot {
      margin-top: 28px;
      padding-top: 13px;
      border-top: 1px solid rgba(255,255,255,.1);
      display: flex;
      justify-content: space-between;
      gap: 20px;
      color: #7894b0;
      font-size: 8px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    /* ======================================================================
       RESPONSIVE / HEIGHT CONTROL
       ====================================================================== */

    @media (max-width: 1280px) {
      :root { --header-h: 106px; --max: 1220px; }
      .wrap { padding: 0 25px; }
      .head { grid-template-columns: 205px minmax(0,1fr) 130px; gap: 12px; }
      #nav a { font-size: 11px; }
      .overview-grid { gap: 25px; }
      .overview-title { font-size: 53px; }
      .overview-visual { min-height: 475px; }
      .portfolio-card { height: 395px; }
      .portfolio-card p { font-size: 8.2px; }
    }

    @media (max-height: 850px) and (min-width: 900px) {
      :root { --header-h: 96px; }
      .slide { min-height: 0; padding: 21px 0; }
      .section-head { margin-bottom: 15px; }
      .section-head h2 { margin-top: 8px; margin-bottom: 5px; font-size: 39px; }
      .section-head p { font-size: 12px; }
      .overview-title { font-size: 50px; margin-top: 12px; }
      .overview-lead { font-size: 14px; }
      .overview-visual { min-height: 425px; }
      .operating-map { height: 350px; }
      .ecosystem-story, .challenge-lead, .metrics-story { min-height: 450px; }
      .eco-card { min-height: 94px; }
      .challenge-card { min-height: 140px; }
      .strategy-step { height: 160px; }
      .scope-card { height: 175px; }
      .metric-group { min-height: 140px; }
      .formula-bar { margin-top: 9px; }
      .portfolio-card { height: 355px; }
      .outcome-card { height: 205px; }
      .tech-panel { min-height: 415px; }
    }

    @media (max-width: 1040px) {
      :root { --header-h: 92px; }
      .head { grid-template-columns: 175px minmax(0,1fr) 112px; }
      .brand-logo { width: 42px; height: 42px; flex-basis: 42px; }
      .brand-copy b { font-size: 15px; }
      .brand-copy small { font-size: 8px; }
      #nav { height: 72px; gap: 4px; }
      #nav a { font-size: 9.5px; }
      .btn { min-height: 40px; padding: 0 12px; font-size: 10px; }
      .wrap { padding: 0 20px; }
      .overview-grid, .ecosystem-grid-layout, .challenge-layout, .metrics-layout, .tech-layout, .contact-grid { gap: 18px; }
      .overview-title { font-size: 43px; }
      .overview-lead { font-size: 13px; }
      .career-step span { font-size: 7px; }
      .overview-visual { min-height: 420px; }
      .portfolio-grid { gap: 6px; }
      .portfolio-card { padding: 13px; }
      .portfolio-card h3 { font-size: 13px; }
      .portfolio-card p { font-size: 7.5px; }
      .supporting-item span { font-size: 6.5px; }
    }

    @media (max-width: 820px) {
      html { overflow: auto; }
      body { overflow: auto; }
      header { height: auto; position: sticky; }
      .head { grid-template-columns: 1fr; padding: 12px 18px; }
      .nav-cta { display: none; }
      #nav { height: auto; grid-template-columns: repeat(2,1fr); grid-template-rows: none; }
      #nav a { padding: 10px 5px; }
      main { height: auto; overflow: visible; scroll-snap-type: none; }
      .slide { min-height: auto; height: auto; overflow: visible; scroll-snap-align: none; padding: 55px 0; }
      .section-head h2, .section-head p { white-space: normal; }
      .overview-grid, .ecosystem-grid-layout, .challenge-layout, .metrics-layout, .tech-layout, .contact-grid { grid-template-columns: 1fr; }
      .overview-visual { min-height: 420px; }
      .ecosystem-story, .challenge-lead, .metrics-story { min-height: auto; }
      .strategy-flow { grid-template-columns: repeat(2,1fr); }
      .strategy-step { height: auto; min-height: 150px; }
      .strategy-step:not(:last-child)::after { display: none; }
      .strategy-bottom { grid-template-columns: 1fr; }
      .scope-grid, .portfolio-grid { grid-template-columns: repeat(2,1fr); }
      .portfolio-card { height: auto; min-height: 330px; }
      .supporting-row { grid-template-columns: repeat(2,1fr); }
      .outcomes-grid { grid-template-columns: repeat(2,1fr); }
      .outcome-summary { grid-template-columns: repeat(2,1fr); }
      .formula-bar { grid-template-columns: repeat(2,1fr); }
    }

    @media (max-width: 560px) {
      .wrap { padding: 0 16px; }
      .overview-stats, .career-strip, .ecosystem-grid, .challenge-cards, .metrics-grid, .scope-grid, .portfolio-grid, .outcomes-grid { grid-template-columns: 1fr; }
      .career-step { border-right: 0; border-bottom: 1px solid var(--line); }
      .career-step:last-child { border-bottom: 0; }
      .portfolio-intro, .outcomes-intro { display: block; }
      .portfolio-note, .outcomes-note { width: auto; margin-top: 12px; }
      .contact-title { white-space: normal; }
      .contact-focus { flex-wrap: wrap; }
      .strategy-bottom, .priority-grid, .formula-bar, .outcome-summary { grid-template-columns: 1fr; }
      .tech-layer { grid-template-columns: 25px 1fr; }
      .tech-layer span { grid-column: 2; }
    }
    /* ======================================================================
       TYPOGRAPHY / READABILITY PASS
       ====================================================================== */

    /* Section titles may wrap when needed; never clip meaningful content. */
    .section-head h2 {
      white-space: normal;
      overflow: visible;
      text-overflow: unset;
      font-size: clamp(34px, 3vw, 48px);
      line-height: 1.02;
      max-width: 1180px;
    }

    .section-head p {
      white-space: normal;
      overflow: visible;
      text-overflow: unset;
      font-size: 14px;
      line-height: 1.42;
      max-width: 980px;
    }

    /* OVERVIEW */
    .overview-title {
      max-width: 880px;
      font-size: clamp(46px, 4.35vw, 66px);
      line-height: .98;
    }
    .overview-lead { font-size: 16px; line-height: 1.48; }
    .focus-row .pill { font-size: 11px; }
    .overview-stat span { font-size: 9px; }
    .career-step strong { font-size: 11.5px; }
    .career-step span { font-size: 9px; }

    /* ECOSYSTEM: wider statement column so the headline reads as a clean
       3-line statement instead of a narrow 5-line block. */
    .ecosystem-grid-layout {
      grid-template-columns: minmax(560px,.9fr) minmax(0,1.1fr);
      gap: 32px;
    }
    .ecosystem-story { padding: 30px; min-height: 525px; }
    .ecosystem-story h3 {
      max-width: 620px;
      font-size: 34px;
      line-height: 1.04;
      letter-spacing: -.04em;
    }
    .ecosystem-story p { font-size: 13.5px; line-height: 1.52; }
    .story-point { font-size: 11.5px; }
    .ecosystem-story-foot { font-size: 9px; }
    .eco-card { min-height: 112px; padding: 18px; }
    .eco-card strong { font-size: 14px; }
    .eco-card span { max-width: 225px; font-size: 11px; line-height: 1.4; }

    /* CHALLENGE */
    .challenge-lead h3 { font-size: 34px; }
    .challenge-lead p { font-size: 13.5px; }
    .challenge-card h3 { font-size: 15px; }
    .challenge-card p { font-size: 11px; line-height: 1.46; }
    .challenge-card .response { font-size: 9px; line-height: 1.25; white-space: normal; }

    /* STRATEGY: 4 x 2 gives every step enough width for readable copy. */
    .strategy-flow { grid-template-columns: repeat(4,minmax(0,1fr)); gap: 10px; }
    .strategy-step { height: 158px; padding: 17px 16px; }
    .strategy-step:not(:last-child)::after { display: none; }
    .strategy-step strong { font-size: 14px; }
    .strategy-step p { font-size: 10.5px; line-height: 1.42; }
    .strategy-principle strong { font-size: 14px; }
    .strategy-principle span { font-size: 10.5px; }
    .priority-item strong { font-size: 10px; }
    .priority-item span { font-size: 9px; line-height: 1.3; }

    /* PM SCOPE */
    .scope-card strong { font-size: 15px; }
    .scope-card p { font-size: 10.5px; line-height: 1.45; }
    .scope-tag { font-size: 8.5px; }
    .scope-footer strong { font-size: 10.5px; }
    .scope-footer span { font-size: 9.5px; white-space: normal; }

    /* PRODUCT METRICS */
    .metrics-story h3 { font-size: 33px; }
    .metrics-story p { font-size: 13.5px; }
    .metric-equation strong { font-size: 10.5px; }
    .metric-equation span { font-size: 9.5px; }
    .metric-group h3 { font-size: 15px; }
    .metric-group > p { font-size: 10.5px; line-height: 1.35; }
    .metric-list div { font-size: 10px; }
    .formula strong { font-size: 9px; }
    .formula span { font-size: 8.5px; line-height: 1.28; }

    /* PORTFOLIO */
    .portfolio-card h3 { font-size: 16px; line-height: 1.08; }
    .portfolio-block label { font-size: 8px; }
    .portfolio-block p { font-size: 10px; line-height: 1.42; }
    .portfolio-outcome { padding: 10px 11px; }
    .portfolio-outcome p { font-size: 10px; }
    .portfolio-tag { font-size: 8px; }
    .case-link { font-size: 9.5px; }
    .supporting-item strong { font-size: 8.5px; }
    .supporting-item span { font-size: 8px; line-height: 1.3; }

    /* TECH & DATA */
    .capability-row strong { font-size: 11px; }
    .capability-row span { font-size: 10px; line-height: 1.32; white-space: normal; }
    .tech-panel-title { font-size: 24px; line-height: 1.06; }
    .tech-panel-sub { font-size: 10.5px; }
    .tech-layer strong { font-size: 10.5px; }
    .tech-layer span { font-size: 9.5px; line-height: 1.25; white-space: normal; }
    .tool { font-size: 8.5px; }

    /* OUTCOMES */
    .outcomes-note strong { font-size: 10px; }
    .outcomes-note span { font-size: 9px; }
    .outcome-card strong { font-size: 29px; }
    .outcome-card h3 { font-size: 14px; line-height: 1.18; }
    .outcome-card span { font-size: 8.5px; line-height: 1.2; white-space: normal; }
    .outcome-summary-item strong { font-size: 10px; }
    .outcome-summary-item span { font-size: 8.5px; }

    /* CONNECT */
    .contact-title {
      white-space: normal;
      max-width: 900px;
      font-size: clamp(44px, 4vw, 60px);
      line-height: 1;
    }
    .contact-copy { font-size: 15px; line-height: 1.48; }
    .contact-link { font-size: 11.5px; }

    /* DESKTOP HEIGHT SAFETY */
    @media (max-height: 850px) and (min-width: 900px) {
      .ecosystem-story h3 { font-size: 30px; }
      .eco-card { min-height: 96px; padding: 15px; }
      .eco-card span { font-size: 10px; }
      .strategy-step { height: 135px; padding: 14px; }
      .strategy-step p { font-size: 9.5px; }
      .scope-card { height: 190px; }
      .metric-group { min-height: 145px; }
      .portfolio-card { height: 375px; }
      .outcome-card { height: 220px; }
      .contact-title { font-size: 48px; }
    }

    @media (max-width: 1280px) and (min-width: 821px) {
      .ecosystem-grid-layout { grid-template-columns: minmax(470px,.9fr) minmax(0,1.1fr); }
      .ecosystem-story h3 { font-size: 31px; }
      .eco-card span { font-size: 10px; }
      .portfolio-block p { font-size: 9.5px; }
    }

    @media (max-width: 820px) {
      .ecosystem-grid-layout { grid-template-columns: 1fr; }
      .strategy-flow { grid-template-columns: repeat(2,minmax(0,1fr)); }
      .strategy-step { height: auto; min-height: 145px; }
      .section-head h2 { font-size: clamp(32px, 7vw, 44px); }
    }


    /* ======================================================================
       FINAL CLEAN-UI SYSTEM — CONSISTENT TYPOGRAPHY / CONTRAST / ALIGNMENT
       This layer intentionally overrides earlier experimental sizing without
       deleting the original content or component structure.
       ====================================================================== */

    :root {
      --font-ui: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      --text-strong: #173a63;
      --text-body: #4f6780;
      --text-soft: #667d93;
      --text-on-dark: #f8fbff;
      --text-on-dark-soft: #c7d6e6;
      --pastel-blue: #edf5ff;
      --pastel-mint: #edf9f5;
      --pastel-lavender: #f4f0ff;
      --pastel-amber: #fff6e8;
      --pastel-teal: #edf8fa;
      --pastel-sand: #fbf7ef;
      --footer-ink: #244d76;
    }

    html, body, button, input, textarea, select, a {
      font-family: var(--font-ui);
    }

    body {
      color: var(--text-body);
      font-size: 14px;
      line-height: 1.5;
    }

    .wrap {
      max-width: 1480px;
      padding-left: 42px;
      padding-right: 42px;
    }

    /* One typographic hierarchy across every section. */
    .eyebrow {
      font-size: 11px;
      line-height: 1.1;
      letter-spacing: .14em;
    }

    .section-head {
      margin-bottom: 18px;
    }

    .section-head h2 {
      color: var(--text-strong);
      font-size: clamp(36px, 3.05vw, 48px);
      line-height: 1.04;
      letter-spacing: -.045em;
      font-weight: 850;
      margin: 10px 0 8px;
      white-space: normal;
      overflow: visible;
    }

    .section-head p {
      color: var(--text-body);
      font-size: 14px;
      line-height: 1.48;
      white-space: normal;
      overflow: visible;
      max-width: 980px;
    }

    .dark .section-head h2 { color: var(--text-on-dark); }
    .dark .section-head p { color: var(--text-on-dark-soft); }

    /* Overview: role already exists in the static header, so no duplicate
       orange role label is allowed inside the slide. */
    #overview .overview-title {
      max-width: 820px;
      color: var(--text-strong);
      font-size: clamp(46px, 4.25vw, 64px);
      line-height: .99;
      letter-spacing: -.055em;
    }

    #overview .overview-lead {
      max-width: 820px;
      color: var(--text-body);
      font-size: 16px;
      line-height: 1.5;
    }

    #overview .overview-stat strong { color: var(--text-strong); }
    #overview .overview-stat span { color: var(--text-soft); font-size: 10px; }
    #overview .career-step strong { color: var(--text-strong); font-size: 12px; }
    #overview .career-step span { color: var(--text-soft); font-size: 10px; line-height: 1.35; }

    /* Ecosystem: give the narrative column enough width for a 3-line headline,
       while keeping the 3x3 card matrix compact and readable. */
    #ecosystem .ecosystem-grid-layout {
      grid-template-columns: minmax(570px, .95fr) minmax(0, 1.05fr);
      gap: 28px;
      align-items: center;
    }

    #ecosystem .ecosystem-story {
      min-height: 500px;
      padding: 30px 32px;
      border-radius: 24px;
    }

    #ecosystem .ecosystem-story h3 {
      max-width: 560px;
      margin: 15px 0 13px;
      font-size: 34px;
      line-height: 1.04;
      letter-spacing: -.045em;
    }

    #ecosystem .ecosystem-story p {
      max-width: 560px;
      color: #c6d5e5;
      font-size: 13.5px;
      line-height: 1.5;
    }

    #ecosystem .story-point {
      color: #f1f6fb;
      font-size: 11px;
      line-height: 1.3;
      white-space: normal;
    }

    #ecosystem .ecosystem-story-foot {
      color: #9eb5cb;
      font-size: 9px;
    }

    #ecosystem .ecosystem-panel {
      padding: 12px;
      border-radius: 24px;
    }

    #ecosystem .eco-card {
      min-height: 105px;
      padding: 17px 18px;
      border-radius: 15px;
    }

    #ecosystem .eco-card strong {
      color: var(--text-strong);
      font-size: 14px;
      line-height: 1.2;
    }

