---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Manoj Pant | Senior Product Manager">
    <style>
        :root {
            --navy: #102f55;
            --navy-2: #163d6a;
            --ink: #102a4d;
            --ink-2: #365774;
            --muted: #627c97;
            --line: #d8e4ef;
            --line-2: #e8eff5;
            --bg: #f3f7fb;
            --paper: #fff;
            --blue: #2468d7;
            --blue-soft: #eaf2ff;
            --lav: #7658d9;
            --lav-soft: #f1edff;
            --mint: #17886f;
            --mint-soft: #e8f7f2;
            --amber: #be7615;
            --amber-soft: #fff2df;
            --rose: #bb3f76;
            --rose-soft: #fff0f6;
            --header-h: 96px;
            --shadow: 0 12px 30px rgba(22,52,82,.07);
        }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; scroll-padding-top: calc(var(--header-h) + 10px); }
        body { margin: 0; background: var(--bg); color: var(--ink); font-family: Inter, ui-sans-serif, system-ui, sans-serif; overflow: hidden; }
        
        /* HEADER */
        header { position: sticky; top: 0; z-index: 100; background: var(--navy); color: #fff; border-bottom: 1px solid rgba(255,255,255,.10); box-shadow: 0 10px 24px rgba(8,28,51,.18); }
        .head { height: var(--header-h); display: grid; grid-template-columns: 240px minmax(500px, 1fr) 260px; gap: 16px; align-items: center; width: min(1480px, calc(100% - 48px)); margin: 0 auto; }
        .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
        .brand-logo { width: 40px; height: 40px; border-radius: 10px; background: #234f7f; border: 1px solid rgba(255,255,255,.15); display: flex; align-items: center; justify-content: center; font-weight: 950; color: #fff; font-size: 13px; }
        .brand-copy b { display: block; font-size: 17px; line-height: 1.1; color: #fff; }
        .brand-copy small { display: block; margin-top: 3px; color: #c1d2e4; font-size: 9.5px; font-weight: 900; letter-spacing: .10em; text-transform: uppercase; }
        
        #nav { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); grid-template-rows: repeat(2, 32px); gap: 6px; align-items: center; }
        #nav a { height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 8px; color: #eaf1f7; font-size: 11px; font-weight: 900; text-decoration: none; transition: .15s ease; }
        #nav a:hover, #nav a.active { background: #234f7f; color: #fff; }
        
        .head-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
        .btn { display: inline-flex; align-items: center; justify-content: center; padding: 8px 12px; border: 1px solid var(--line); border-radius: 9px; background: #fff; color: var(--ink); font-size: 11.5px; font-weight: 950; text-decoration: none; transition: .15s ease; }
        .btn.primary { background: var(--navy); border-color: var(--navy); color: #fff; }
        .btn.portfolio-top { grid-column: 1/-1; background: #2a5c8d; color: #fff; border-color: #547ca5; }

        /* MAIN SHELL & SLIDE PAGES */
        .portfolio-shell { scroll-behavior: smooth; height: calc(100vh - var(--header-h)); overflow-y: auto; scroll-snap-type: y mandatory; }
        .slide-page { height: calc(100vh - var(--header-h)); min-height: calc(100vh - var(--header-h)); display: flex; flex-direction: column; overflow: hidden; border-bottom: 1px solid var(--line-2); scroll-snap-align: start; }
        .slide-page.white { background: #fff; }
        .slide-page.soft { background: #f6f9fc; }
        .slide-page.dark { background: var(--navy); color: #fff; }
        .slide-page > .wrap { height: 100%; width: min(1480px, calc(100% - 48px)); margin: 0 auto; padding: 16px 0; display: flex; flex-direction: column; justify-content: center; min-height: 0; flex: 1; }

        .eyebrow { font-size: 11px; line-height: 1.15; color: var(--blue); font-weight: 950; letter-spacing: .17em; text-transform: uppercase; }
        .dark .eyebrow { color: #83b9ff; }
        .section-head { display: grid; gap: 4px; margin-bottom: 12px; flex: none; }
        .section-head h2 { margin: 2px 0 0; font-size: 34px; line-height: 1.03; letter-spacing: -.045em; color: var(--ink); font-weight: 950; }
        .dark .section-head h2 { color: #fff; }
        .section-head p { margin: 0; color: var(--ink-2); font-size: 14px; line-height: 1.4; }
        .dark .section-head p { color: #cbd5e1; }

        .card { border: 1px solid var(--line); border-radius: 16px; background: #fff; box-shadow: var(--shadow); padding: 16px; }
        .dark-card { border: 1px solid rgba(255,255,255,.13); border-radius: 16px; background: rgba(255,255,255,.055); padding: 16px; }
        
        @media screen and (max-width: 1180px) {
            :root { --header-h: 124px; }
            .head { grid-template-columns: 190px minmax(400px, 1fr) 230px; }
        }
        @media screen and (max-width: 900px) {
            :root { --header-h: 170px; }
            body { overflow: auto; }
            .portfolio-shell { height: auto; overflow-y: visible; scroll-snap-type: none; }
            .slide-page { height: auto; min-height: calc(100vh - var(--header-h)); overflow: visible; }
            .head { grid-template-columns: 1fr; height: auto; padding: 10px 0; }
            .head-actions { width: 100%; }
        }
    </style>

    <!-- HEADER / NAVIGATION -->
    <header>
        <div class="head">
            <a class="brand" href="#overview">
                <span class="brand-logo">MP</span>
                <span class="brand-copy"><b>Manoj Pant</b><small>Senior Product Manager</small></span>
            </a>
            <nav id="nav">
                <a href="#overview">Overview</a>
                <a href="#story">Product Story</a>
                <a href="#journey">Journey</a>
                <a href="#portfolio">Portfolio</a>
                <a href="#integrated">Integrated Channels</a>
                <a href="#lifecycle">Lifecycle</a>
                <a href="#architecture">Architecture</a>
                <a href="#casestudies">Case Studies</a>
                <a href="#analytics">Analytics & AI</a>
                <a href="#contact">Contact</a>
            </nav>
            <div class="head-actions">
                <a class="btn primary" href="mailto:manoj.pant.pm@outlook.com">Let's Connect</a>
                <a class="btn" href="#integrated">Explore Suite →</a>
                <a class="btn portfolio-top" href="#overview">↑ Back to Top</a>
            </div>
        </div>
    </header>

    <main class="portfolio-shell">

        <!-- SLIDE 01 — OVERVIEW -->
        <section class="slide-page white" id="overview">
            <div class="wrap">
                <div style="display: grid; grid-template-columns: 1.2fr .8fr; gap: 24px; align-items: center;">
                    <div>
                        <span class="eyebrow">Senior Product Manager · Enterprise Product Leadership</span>
                        <h1 style="font-size: clamp(42px, 4.5vw, 64px); line-height: .95; letter-spacing: -.05em; margin: 12px 0; font-weight: 950; color: var(--ink);">
                            Building enterprise products from problem to impact.
                        </h1>
                        <p style="font-size: 16px; line-height: 1.45; color: var(--ink-2); margin: 0;">
                            10+ years across FinTech, Telecom, HealthTech and Enterprise IT, combining product strategy, business analysis, technical solutioning, data & analytics, workflow automation and Agile delivery.
                        </p>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px;">
                            <span class="btn" style="background: var(--blue-soft); color: var(--blue); border-color: #c8def7;">Product Strategy</span>
                            <span class="btn" style="background: var(--lav-soft); color: var(--lav); border-color: #dcd0ff;">Enterprise SaaS</span>
                            <span class="btn" style="background: var(--mint-soft); color: var(--mint); border-color: #bfeade;">Technical PM</span>
                            <span class="btn" style="background: var(--amber-soft); color: var(--amber); border-color: #f7dec0;">Data & Analytics</span>
                        </div>
                    </div>
                    <div class="card" style="border-top: 5px solid var(--blue);">
                        <span class="eyebrow">Product Profile</span>
                        <h2 style="font-size: 22px; margin: 6px 0 14px; color: var(--ink);">At a Glance</h2>
                        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;">
                            <div style="background: #f8fbff; padding: 12px; border-radius: 12px; border: 1px solid var(--line);">
                                <strong style="font-size: 26px; line-height: 1; color: var(--ink);">10+</strong>
                                <span style="display: block; font-size: 10px; color: var(--muted); font-weight: 800; margin-top: 3px; text-transform: uppercase;">Years Experience</span>
                            </div>
                            <div style="background: #f8fbff; padding: 12px; border-radius: 12px; border: 1px solid var(--line);">
                                <strong style="font-size: 26px; line-height: 1; color: var(--ink);">4</strong>
                                <span style="display: block; font-size: 10px; color: var(--muted); font-weight: 800; margin-top: 3px; text-transform: uppercase;">Industries</span>
                            </div>
                            <div style="background: #f8fbff; padding: 12px; border-radius: 12px; border: 1px solid var(--line);">
                                <strong style="font-size: 26px; line-height: 1; color: var(--ink);">12+</strong>
                                <span style="display: block; font-size: 10px; color: var(--muted); font-weight: 800; margin-top: 3px; text-transform: uppercase;">Enterprise Apps</span>
                            </div>
                            <div style="background: #f8fbff; padding: 12px; border-radius: 12px; border: 1px solid var(--line);">
                                <strong style="font-size: 26px; line-height: 1; color: var(--ink);">0→1</strong>
                                <span style="display: block; font-size: 10px; color: var(--muted); font-weight: 800; margin-top: 3px; text-transform: uppercase;">Product Discovery</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SLIDE 02 — PRODUCT STORY -->
        <section class="slide-page soft" id="story">
            <div class="wrap">
                <div class="section-head">
                    <span class="eyebrow">02 · Product Story</span>
                    <h2>A product career built in layers.</h2>
                    <p>The progression is not a jump from analytics into product management, but a continuous build-up of analytical thinking, business analysis, technical understanding, and product ownership.</p>
                </div>
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;">
                    <div class="card" style="border-left: 4px solid var(--blue);">
                        <span class="eyebrow">01 · Foundation</span>
                        <h3 style="font-size: 17px; margin: 6px 0 4px;">Data & Analytics</h3>
                        <p style="font-size: 12px; color: var(--ink-2); margin: 0;">SQL, Power BI, Tableau, KPI frameworks, reporting automation, and operational insights.</p>
                    </div>
                    <div class="card" style="border-left: 4px solid var(--lav);">
                        <span class="eyebrow">02 · Problem Solving</span>
                        <h3 style="font-size: 17px; margin: 6px 0 4px;">Business Analysis</h3>
                        <p style="font-size: 12px; color: var(--ink-2); margin: 0;">Requirement elicitation, BRD/FRD, process mapping, gap analysis, and business cases.</p>
                    </div>
                    <div class="card" style="border-left: 4px solid var(--mint);">
                        <span class="eyebrow">03 · Product Ownership</span>
                        <h3 style="font-size: 17px; margin: 6px 0 4px;">Product Management</h3>
                        <p style="font-size: 12px; color: var(--ink-2); margin: 0;">Discovery, roadmaps, prioritization, PRDs, user stories, acceptance criteria, and UAT.</p>
                    </div>
                    <div class="card" style="border-left: 4px solid var(--amber);">
                        <span class="eyebrow">04 · Enterprise Leadership</span>
                        <h3 style="font-size: 17px; margin: 6px 0 4px;">Technical PM</h3>
                        <p style="font-size: 12px; color: var(--ink-2); margin: 0;">APIs, integrations, DFDs, ER mapping, architecture collaboration, and regulated workflows.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SLIDE 03 — CAREER JOURNEY -->
        <section class="slide-page white" id="journey">
            <div class="wrap">
                <div class="section-head">
                    <span class="eyebrow">03 · Career Journey</span>
                    <h2>A career built across data, technology and products.</h2>
                    <p>From reporting and analytics to enterprise product leadership across top organizations.</p>
                </div>
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;">
                    <div class="card" style="border-top: 4px solid var(--blue);">
                        <span class="eyebrow">2016 – 2023</span>
                        <h3 style="font-size: 18px; margin: 6px 0 2px;">Nokia Networks</h3>
                        <span style="font-size: 11px; font-weight: 800; color: var(--muted);">Reporting Analyst → Business Analyst</span>
                        <p style="font-size: 11.5px; color: var(--ink-2); margin: 8px 0 0;">Power BI, Tableau, SQL, requirements, business cases, KPI frameworks and telecom enterprise programs.</p>
                    </div>
                    <div class="card" style="border-top: 4px solid var(--lav);">
                        <span class="eyebrow">2023 – 2024</span>
                        <h3 style="font-size: 18px; margin: 6px 0 2px;">Ayu Health</h3>
                        <span style="font-size: 11px; font-weight: 800; color: var(--muted);">Product Manager</span>
                        <p style="font-size: 11.5px; color: var(--ink-2); margin: 8px 0 0;">Product Management across healthcare workflows, provider products, CRM, automation and 0→1 product development.</p>
                    </div>
                    <div class="card" style="border-top: 4px solid var(--mint);">
                        <span class="eyebrow">2024</span>
                        <h3 style="font-size: 18px; margin: 6px 0 2px;">Phoneme Solutions</h3>
                        <span style="font-size: 11px; font-weight: 800; color: var(--muted);">Product Manager</span>
                        <p style="font-size: 11.5px; color: var(--ink-2); margin: 8px 0 0;">Product requirements, workflow optimization, CRM-enabled healthcare claims and AI-powered OCR enhancements.</p>
                    </div>
                    <div class="card" style="border-top: 4px solid var(--amber);">
                        <span class="eyebrow">2024 – 2026</span>
                        <h3 style="font-size: 18px; margin: 6px 0 2px;">M2P Solutions</h3>
                        <span style="font-size: 11px; font-weight: 800; color: var(--muted);">Senior Product Manager</span>
                        <p style="font-size: 11.5px; color: var(--ink-2); margin: 8px 0 0;">Senior Product Manager across enterprise banking, payments, lending, automation, AI and scalable digital platforms.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SLIDE 04 — PORTFOLIO MAP -->
        <section class="slide-page soft" id="portfolio">
            <div class="wrap">
                <div class="section-head">
                    <span class="eyebrow">04 · Selected Product Work</span>
                    <h2>Product & platform case studies.</h2>
                    <p>Selected work spanning enterprise SaaS, digital banking, payments, healthcare, telecom analytics and workflow automation.</p>
                </div>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;">
                    <div class="card" style="display: flex; flex-direction: column; justify-content: between;">
                        <div>
                            <span class="eyebrow">FinTech · Enterprise Platforms</span>
                            <h3 style="font-size: 20px; margin: 6px 0 8px;">Integrated Channels Suite</h3>
                            <p style="font-size: 12.5px; color: var(--ink-2); margin: 0;">Digital banking platform integrating 12+ enterprise applications using API-first architecture and configurable workflows.</p>
                        </div>
                        <div style="margin-top: 16px;">
                            <a class="btn primary" href="#integrated" style="width: 100%;">View Case Study →</a>
                        </div>
                    </div>
                    <div class="card" style="display: flex; flex-direction: column; justify-content: between;">
                        <div>
                            <span class="eyebrow">HealthTech · 0→1 Product</span>
                            <h3 style="font-size: 20px; margin: 6px 0 8px;">Ayu DocConnect</h3>
                            <p style="font-size: 12.5px; color: var(--ink-2); margin: 0;">Cloud-enabled doctor workflow and engagement platform covering onboarding, treatment operations, and payout automation.</p>
                        </div>
                        <div style="margin-top: 16px;">
                            <span class="btn" style="width: 100%; color: var(--muted); background: #f8fafc;">Case study overview</span>
                        </div>
                    </div>
                    <div class="card" style="display: flex; flex-direction: column; justify-content: between;">
                        <div>
                            <span class="eyebrow">Telecom Analytics</span>
                            <h3 style="font-size: 20px; margin: 6px 0 8px;">Enterprise Insights</h3>
                            <p style="font-size: 12.5px; color: var(--ink-2); margin: 0;">Power BI, Tableau and SQL-driven reporting, KPI frameworks, financial tracking, and operational decision support.</p>
                        </div>
                        <div style="margin-top: 16px;">
                            <span class="btn" style="width: 100%; color: var(--muted); background: #f8fafc;">Case study overview</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SLIDE 05 — INTEGRATED CHANNELS -->
        <section class="slide-page dark" id="integrated">
            <div class="wrap">
                <div class="section-head">
                    <span class="eyebrow">05 · Flagship Product (M2P)</span>
                    <h2>Integrated Channels Suite</h2>
                    <p>Digital banking platform integrating 12+ enterprise applications using API-first architecture.</p>
                </div>
                <div style="display: grid; grid-template-columns: 1.1fr .9fr; gap: 20px; align-items: center;">
                    <div>
                        <p style="font-size: 14.5px; line-height: 1.5; color: #cbd5e1; margin: 0;">
                            Banking organizations operate across multiple workflows, systems, regulatory controls and external integrations. The product approach was to provide configurable domain applications with shared patterns and integration-ready capabilities rather than isolated point solutions.
                        </p>
                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 16px;">
                            <div class="dark-card" style="padding: 12px;"><strong style="font-size: 20px;">12+</strong><span style="display: block; font-size: 9.5px; color: #94a3b8; text-transform: uppercase; margin-top: 2px;">Applications</span></div>
                            <div class="dark-card" style="padding: 12px;"><strong style="font-size: 20px;">Banks</strong><span style="display: block; font-size: 9.5px; color: #94a3b8; text-transform: uppercase; margin-top: 2px;">& NBFCs</span></div>
                            <div class="dark-card" style="padding: 12px;"><strong style="font-size: 20px;">API-First</strong><span style="display: block; font-size: 9.5px; color: #94a3b8; text-transform: uppercase; margin-top: 2px;">Architecture</span></div>
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">
                        <div class="dark-card" style="padding: 10px; text-align: center;"><b style="font-size: 12px;">LOS / LMS</b><div style="font-size: 9px; color: #94a3b8; margin-top: 2px;">Origination</div></div>
                        <div class="dark-card" style="padding: 10px; text-align: center;"><b style="font-size: 12px;">AML / KYC</b><div style="font-size: 9px; color: #94a3b8; margin-top: 2px;">Compliance</div></div>
                        <div class="dark-card" style="padding: 10px; text-align: center;"><b style="font-size: 12px;">Reconciliation</b><div style="font-size: 9px; color: #94a3b8; margin-top: 2px;">Controls</div></div>
                        <div class="dark-card" style="padding: 10px; text-align: center;"><b style="font-size: 12px;">CKYC & DMS</b><div style="font-size: 9px; color: #94a3b8; margin-top: 2px;">Documents</div></div>
                        <div class="dark-card" style="padding: 10px; text-align: center;"><b style="font-size: 12px;">Treasury</b><div style="font-size: 9px; color: #94a3b8; margin-top: 2px;">Liquidity</div></div>
                        <div class="dark-card" style="padding: 10px; text-align: center;"><b style="font-size: 12px;">Audit</b><div style="font-size: 9px; color: #94a3b8; margin-top: 2px;">Governance</div></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SLIDE 06 — LIFECYCLE -->
        <section class="slide-page soft" id="lifecycle">
            <div class="wrap">
                <div class="section-head">
                    <span class="eyebrow">06 · Product Lifecycle</span>
                    <h2>From problem discovery to production adoption.</h2>
                    <p>Rigorous operating rhythm ensuring high-quality execution at every stage.</p>
                </div>
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;">
                    <div class="card"><span class="eyebrow">01</span><h3 style="font-size: 15px; margin: 4px 0 2px;">Discover</h3><p style="font-size: 11.5px; color: var(--ink-2); margin: 0;">Stakeholder interviews, workflows, and current-state mapping.</p></div>
                    <div class="card"><span class="eyebrow">02</span><h3 style="font-size: 15px; margin: 4px 0 2px;">Define</h3><p style="font-size: 11.5px; color: var(--ink-2); margin: 0;">Scope definition, BRD/PRD, use cases, and acceptance criteria.</p></div>
                    <div class="card"><span class="eyebrow">03</span><h3 style="font-size: 15px; margin: 4px 0 2px;">Prioritize</h3><p style="font-size: 11.5px; color: var(--ink-2); margin: 0;">Business value, risk, dependencies, and roadmap sequencing.</p></div>
                    <div class="card"><span class="eyebrow">04</span><h3 style="font-size: 15px; margin: 4px 0 2px;">Design</h3><p style="font-size: 11.5px; color: var(--ink-2); margin: 0;">Figma mockups, process flows, DFD, and API specifications.</p></div>
                    <div class="card"><span class="eyebrow">05</span><h3 style="font-size: 15px; margin: 4px 0 2px;">Build</h3><p style="font-size: 11.5px; color: var(--ink-2); margin: 0;">Backlog management, sprint planning, and QA coordination.</p></div>
                    <div class="card"><span class="eyebrow">06</span><h3 style="font-size: 15px; margin: 4px 0 2px;">Validate</h3><p style="font-size: 11.5px; color: var(--ink-2); margin: 0;">UAT, business validation, defect triage, and compliance checks.</p></div>
                    <div class="card"><span class="eyebrow">07</span><h3 style="font-size: 15px; margin: 4px 0 2px;">Launch</h3><p style="font-size: 11.5px; color: var(--ink-2); margin: 0;">Deployment, migration, training manuals, and rollout governance.</p></div>
                    <div class="card"><span class="eyebrow">08</span><h3 style="font-size: 15px; margin: 4px 0 2px;">Improve</h3><p style="font-size: 11.5px; color: var(--ink-2); margin: 0;">Adoption tracking, KPI monitoring, and feedback loops.</p></div>
                </div>
            </div>
        </section>

        <!-- SLIDE 07 — ARCHITECTURE -->
        <section class="slide-page white" id="architecture">
            <div class="wrap">
                <div class="section-head">
                    <span class="eyebrow">07 · Technical PM</span>
                    <h2>Translating business requirements into technical capabilities.</h2>
                    <p>Connecting front-end bank channels to core processing systems and external financial rails.</p>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="card">
                        <span class="eyebrow">System Interaction</span>
                        <h3 style="font-size: 18px; margin: 6px 0 10px;">Data Flow & Integration</h3>
                        <p style="font-size: 12.5px; color: var(--ink-2); line-height: 1.45; margin: 0;">
                            Designed seamless interface boundaries between branch operational channels, modular backend workflows, and core banking systems (CBS, NPCI/UPI, CIBIL, CKYC). Ensured robust exception handling, idempotency, and automated retries.
                        </p>
                    </div>
                    <div class="card">
                        <span class="eyebrow">Technical Artifacts</span>
                        <h3 style="font-size: 18px; margin: 6px 0 10px;">Core Deliverables</h3>
                        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 10px;">
                            <div style="background: #f8fafc; padding: 8px; border-radius: 8px; border: 1px solid var(--line); font-size: 11px; font-weight: 800;">Data Flow Diagrams (DFD)</div>
                            <div style="background: #f8fafc; padding: 8px; border-radius: 8px; border: 1px solid var(--line); font-size: 11px; font-weight: 800;">Entity-Relationship Mapping</div>
