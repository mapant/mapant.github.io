---
import Layout from '../layouts/Layout.astro';

const products = [
  {
    number: '01',
    company: 'M2P Fintech',
    title: 'Integrated Channels Suite',
    description:
      'A modular enterprise platform bringing together banking, lending, payments, compliance and operational capabilities through configurable workflows and integrations.',
    tags: ['Banking', 'Lending', 'Payments', 'AML/KYC'],
    url: '/projects/integrated-channels'
  },
  {
    number: '02',
    company: 'Ayu Health',
    title: 'Ayu DocConnect',
    description:
      'A 0→1 digital healthcare product focused on doctor acquisition, onboarding, engagement and treatment-related workflows across mobile platforms.',
    tags: ['0→1 Product', 'Mobile', 'Provider Experience', 'Adoption'],
    url: '/projects/ayu-docconnect'
  },
  {
    number: '03',
    company: 'Phoneme / Ayu',
    title: 'Provider Payout Automation',
    description:
      'A rules-driven workflow product for provider onboarding, payout calculations, approvals and operational processing.',
    tags: ['Workflow Automation', 'Rules', 'Operations', 'Healthcare'],
    url: '/projects/provider-payout'
  },
  {
    number: '04',
    company: 'Nokia Networks',
    title: 'Telecom Cost Optimization',
    description:
      'A data-driven financial and operational optimization initiative using KPI frameworks, analytics, executive dashboards and workflow automation.',
    tags: ['Analytics', 'Cost Optimization', 'KPIs', 'Automation'],
    url: '/projects/telecom-cost-optimization'
  },
  {
    number: '05',
    company: 'Nokia Networks',
    title: 'Global Service Delivery Analytics',
    description:
      'Enterprise analytics and reporting designed to improve visibility into service performance, operational KPIs and global delivery operations.',
    tags: ['Data Analytics', 'Power BI', 'KPIs', 'Enterprise Reporting'],
    url: '/projects/global-service-delivery'
  },
];

const approach = [
  ['01', 'Discover', 'Understand users, business problems, processes and opportunities.'],
  ['02', 'Define', 'Translate problems into product requirements, journeys and capabilities.'],
  ['03', 'Build', 'Work with design, engineering and cross-functional teams to deliver.'],
  ['04', 'Measure', 'Use product and business metrics to evaluate adoption and outcomes.'],
];

const capabilities = [
  ['Product', 'Strategy · Roadmaps · Discovery · Prioritization · Agile Delivery'],
  ['Technical', 'APIs · Integrations · Workflow Design · DFD · ER Models · Architecture Collaboration'],
  ['Data', 'SQL · Power BI · Tableau · KPI Frameworks · Product Analytics'],
  ['Enterprise', 'Banking · Lending · Payments · Healthcare · Telecom · Enterprise Platforms'],
];
---

<Layout title="Manoj Pant | Senior Product Manager | Product Portfolio">
  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      background: #f8fafc;
      color: #172033;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .portfolio-scroll {
      scroll-snap-type: y mandatory;
    }

    .portfolio-slide {
      min-height: calc(100vh - 104px);
      scroll-snap-align: start;
      scroll-margin-top: 104px;
    }

    @media (max-width: 768px) {
      .portfolio-slide {
        min-height: auto;
        scroll-snap-align: none;
      }
    }
  </style>

  <header class="sticky top-0 z-50 h-[104px] bg-[#172033] text-white shadow-xl overflow-hidden">
    <div class="max-w-[1500px] mx-auto px-5 sm:px-8 h-full flex flex-col justify-center gap-3">
      <div class="flex items-center justify-between gap-6">
        <a href="#overview" class="font-black tracking-tight text-lg sm:text-xl">
          MP<span class="text-[#c9a76a]">.</span>
        </a>

        <div class="hidden md:flex items-center gap-3 text-[11px] uppercase tracking-[0.18em] text-slate-300">
          <span>Manoj Pant</span>
          <span class="text-[#c9a76a]">•</span>
          <span>Senior Product Manager</span>
        </div>
      </div>

      <nav class="grid grid-cols-5 gap-1.5 sm:gap-2 text-[9px] sm:text-[10px] font-black uppercase tracking-wider">
        {[
          ['overview', 'Overview'],
          ['portfolio', 'Portfolio'],
          ['approach', 'Product Approach'],
          ['tech', 'Tech & Data'],
          ['contact', 'Contact'],
        ].map(([href, label], i) => (
          <a
            href={`#${href}`}
            class={`rounded-lg px-2 sm:px-3 py-2 text-center border transition ${
              i === 0
                ? 'bg-[#c9a76a] text-[#172033] border-[#c9a76a]'
                : 'border-slate-700 text-slate-200 hover:border-[#c9a76a] hover:text-white'
            }`}
          >
            {label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <main class="portfolio-scroll h-[calc(100vh-104px)] overflow-y-auto bg-slate-50">

    <!-- OVERVIEW -->
    <section id="overview" class="portfolio-slide flex items-center px-5 sm:px-8 lg:px-12 py-10 lg:py-14">
      <div class="w-full max-w-[1500px] mx-auto">
        <div class="grid lg:grid-cols-[1.45fr_0.8fr] gap-8 xl:gap-14 items-center">

          <div>
            <div class="text-[11px] font-black uppercase tracking-[0.2em] text-[#b58b43] mb-5">
              Senior Product Manager
            </div>

            <h1 class="text-[42px] sm:text-[56px] lg:text-[68px] xl:text-[76px] leading-[0.98] font-black tracking-[-0.04em] text-[#172033] max-w-5xl">
              Building products that solve complex business problems.
            </h1>

            <p class="mt-7 text-base sm:text-lg lg:text-xl leading-relaxed text-slate-600 max-w-4xl">
              Senior Product Manager with <strong class="text-[#172033]">10+ years of experience</strong>
              across FinTech, Healthcare, Telecom and Enterprise IT, combining product strategy,
              business analysis, technology, data and execution to build enterprise products.
            </p>

            <div class="flex flex-wrap gap-x-5 gap-y-2 mt-6 text-sm font-bold text-[#172033]">
              <span>Product Strategy</span>
              <span class="text-[#b58b43]">•</span>
              <span>Enterprise Platforms</span>
              <span class="text-[#b58b43]">•</span>
              <span>Digital Products</span>
              <span class="text-[#b58b43]">•</span>
              <span>Data & Analytics</span>
              <span class="text-[#b58b43]">•</span>
              <span>Workflow Automation</span>
            </div>

            <div class="flex flex-wrap gap-3 mt-8">
              <a href="#portfolio" class="rounded-xl bg-[#b58b43] text-white px-6 py-3.5 text-sm font-black shadow-sm hover:opacity-90 transition">
                Explore Product Portfolio →
              </a>
              <a href="#approach" class="rounded-xl border border-slate-300 bg-white px-6 py-3.5 text-sm font-black text-[#172033] hover:border-[#b58b43] transition">
                Product Approach
              </a>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 lg:gap-4">
            {[
              ['10+', 'Years Experience'],
              ['12+', 'Enterprise Applications'],
              ['4', 'Industry Ecosystems'],
              ['0→1', 'Product Development'],
            ].map(([value, label]) => (
              <div class="rounded-2xl bg-white border border-slate-200 p-5 sm:p-6 shadow-sm">
                <div class="text-3xl sm:text-4xl font-black text-[#172033]">{value}</div>
                <div class="mt-2 text-[10px] sm:text-xs font-black uppercase tracking-wider text-slate-500">{label}</div>
              </div>
            ))}

            <div class="col-span-2 rounded-2xl bg-[#172033] text-white p-5 sm:p-6">
              <div class="text-[10px] font-black uppercase tracking-[0.18em] text-[#d2b06c]">
                Product focus
              </div>
              <div class="mt-3 text-xl sm:text-2xl font-black leading-tight">
                Strategy → Product → Technology → Data → Measurable Outcomes
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- PORTFOLIO -->
    <section id="portfolio" class="portfolio-slide px-5 sm:px-8 lg:px-12 py-10 lg:py-12 flex items-center">
      <div class="w-full max-w-[1500px] mx-auto">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5 mb-7">
          <div>
            <div class="text-[11px] font-black uppercase tracking-[0.2em] text-[#b58b43]">
              Selected Product Portfolio
            </div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mt-2">
              Products across industries and problem spaces.
            </h2>
          </div>
          <p class="text-sm sm:text-base text-slate-600 max-w-2xl leading-relaxed">
            A focused selection of products and initiatives spanning banking, lending,
            payments, healthcare, telecom analytics and enterprise automation.
          </p>
        </div>

        <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4">
          {products.map((product) => (
            <article class="rounded-2xl bg-white border border-slate-200 p-5 sm:p-6 hover:-translate-y-1 hover:shadow-xl transition">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-black uppercase tracking-[0.18em] text-[#b58b43]">
                  {product.number} · {product.company}
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-black mt-3 text-[#172033]">
                {product.title}
              </h3>

              <p class="text-sm leading-relaxed text-slate-600 mt-3">
                {product.description}
              </p>

              <div class="flex flex-wrap gap-2 mt-5">
                {product.tags.map((tag) => (
                  <span class="rounded-full bg-slate-100 px-3 py-1.5 text-[10px] font-black text-slate-600">
                    {tag}
                  </span>
                ))}
              </div>

              <a href={product.url} class="inline-block mt-5 text-sm font-black text-[#172033] hover:text-[#b58b43] transition">
                View Case Study →
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- APPROACH -->
    <section id="approach" class="portfolio-slide bg-[#172033] text-white px-5 sm:px-8 lg:px-12 py-10 lg:py-12 flex items-center">
      <div class="w-full max-w-[1500px] mx-auto">
        <div class="max-w-4xl">
          <div class="text-[11px] font-black uppercase tracking-[0.2em] text-[#d2b06c]">
            Product Management Approach
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mt-3">
            From problem to product to measurable outcome.
          </h2>
          <p class="mt-5 text-base sm:text-lg leading-relaxed text-slate-300 max-w-3xl">
            I work across the product lifecycle — understanding the problem, defining the product,
            collaborating with technology teams, delivering the solution and measuring its impact.
          </p>
        </div>

        <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-4 mt-9">
          {approach.map(([number, title, description]) => (
            <article class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 sm:p-6">
              <div class="text-sm font-black text-[#d2b06c]">{number}</div>
              <h3 class="text-xl font-black mt-5">{title}</h3>
              <p class="text-sm leading-relaxed text-slate-300 mt-3">{description}</p>
            </article>
          ))}
        </div>

        <div class="mt-7 rounded-2xl border border-white/10 bg-white/[0.04] px-5 py-4">
          <div class="text-xs font-black uppercase tracking-widest text-[#d2b06c]">
            Product mindset
          </div>
          <div class="text-base sm:text-lg font-bold mt-2">
            Customer problem + Business value + Technical feasibility + Measurable outcome
          </div>
        </div>
      </div>
    </section>

    <!-- TECH & DATA -->
    <section id="tech" class="portfolio-slide px-5 sm:px-8 lg:px-12 py-10 lg:py-12 flex items-center">
      <div class="w-full max-w-[1500px] mx-auto">
        <div class="max-w-4xl">
          <div class="text-[11px] font-black uppercase tracking-[0.2em] text-[#b58b43]">
            Product & Technical Depth
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mt-2">
            Where product meets technology and data.
          </h2>
          <p class="mt-4 text-base sm:text-lg leading-relaxed text-slate-600 max-w-3xl">
            A product-management foundation supported by technical understanding, analytics
            and enterprise delivery experience.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-4 mt-8">
          {capabilities.map(([title, content]) => (
            <article class="rounded-2xl bg-white border border-slate-200 p-5 sm:p-6">
              <h3 class="text-lg font-black text-[#172033]">{title}</h3>
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed mt-2">{content}</p>
            </article>
          ))}
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-5">
          {[
            ['SQL', 'Data & analysis'],
            ['Power BI', 'Decision dashboards'],
            ['APIs', 'Product integrations'],
            ['Figma', 'Product prototyping'],
          ].map(([name, label]) => (
            <div class="rounded-xl bg-slate-100 p-4">
              <div class="font-black text-[#172033]">{name}</div>
              <div class="text-[10px] uppercase tracking-wide font-bold text-slate-500 mt-1">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- IMPACT -->
    <section id="impact" class="portfolio-slide px-5 sm:px-8 lg:px-12 py-10 lg:py-12 flex items-center">
      <div class="w-full max-w-[1500px] mx-auto">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5 mb-8">
          <div>
            <div class="text-[11px] font-black uppercase tracking-[0.2em] text-[#b58b43]">
              Selected Outcomes
            </div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mt-2">
              Outcomes matter more than features.
            </h2>
          </div>
          <p class="text-sm sm:text-base text-slate-600 max-w-2xl leading-relaxed">
            A few documented outcomes from the products and initiatives represented in my experience.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {[
            ['40% → 75%', 'Doctor adoption', 'Ayu Health'],
            ['10 → 2 days', 'Provider payout turnaround', 'Provider Automation'],
            ['20%', 'Operational efficiency improvement', 'Enterprise initiatives'],
            ['25%', 'Telecom operating-cost reduction', 'Nokia Networks'],
          ].map(([metric, label, company]) => (
            <article class="rounded-2xl bg-[#172033] text-white p-6">
              <div class="text-3xl sm:text-4xl font-black text-[#d2b06c]">{metric}</div>
              <div class="mt-3 font-black text-base">{label}</div>
              <div class="mt-2 text-xs text-slate-400 uppercase tracking-wide font-bold">{company}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="portfolio-slide bg-[#172033] text-white px-5 sm:px-8 lg:px-12 py-10 lg:py-12 flex items-center">
      <div class="w-full max-w-[1500px] mx-auto">
        <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-8 items-end">
          <div>
            <div class="text-[11px] font-black uppercase tracking-[0.2em] text-[#d2b06c]">
              Senior Product Manager
            </div>

            <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight mt-3">
              Building products where business, technology and outcomes meet.
            </h2>

            <p class="mt-6 text-base sm:text-lg leading-relaxed text-slate-300 max-w-3xl">
              My experience spans the journey from data and business analysis to 0→1 product
              development and enterprise platform management.
            </p>

            <div class="flex flex-wrap gap-2 mt-6">
              {['Product Strategy', 'Enterprise Platforms', 'Technical Product Management', 'Data & Analytics'].map((tag) => (
                <span class="rounded-full border border-white/10 px-3 py-2 text-xs font-bold text-slate-200">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-6">
            <div class="text-xs font-black uppercase tracking-widest text-[#d2b06c]">
              Connect
            </div>
            <div class="mt-5 space-y-3">
              <a href="mailto:manoj.pmpm@gmail.com" class="block rounded-xl border border-white/10 px-4 py-3 font-bold hover:border-[#d2b06c] transition">
                manoj.pmpm@gmail.com
              </a>
              <a href="https://www.linkedin.com/in/manoj-pant-35129495/" target="_blank" rel="noreferrer" class="block rounded-xl border border-white/10 px-4 py-3 font-bold hover:border-[#d2b06c] transition">
                LinkedIn →
              </a>
            </div>
          </div>
        </div>

        <footer class="mt-10 pt-5 border-t border-white/10 flex flex-col sm:flex-row justify-between gap-3 text-xs text-slate-500">
          <span>© {new Date().getFullYear()} Manoj Pant</span>
          <span>Senior Product Manager · Product Portfolio</span>
        </footer>
      </div>
    </section>

  </main>
</Layout>