---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Manoj Pant | Senior Product Manager">
    <!-- NAVIGATION -->
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
        <div class="max-w-[1150px] mx-auto px-6 h-[70px] flex items-center justify-between">
            <div class="text-[21px] font-bold tracking-wide text-[#172033]">
                MANOJ PANT
            </div>
            <div class="hidden md:flex gap-7 text-[14px] text-gray-600">
                <a href="#about" class="hover:text-[#b58b43] transition-colors">About</a>
                <a href="#journey" class="hover:text-[#b58b43] transition-colors">Journey</a>
                <a href="#projects" class="hover:text-[#b58b43] transition-colors">Projects</a>
                <a href="#capabilities" class="hover:text-[#b58b43] transition-colors">Capabilities</a>
                <a href="#contact" class="hover:text-[#b58b43] transition-colors">Contact</a>
            </div>
        </div>
    </nav>

    <!-- HERO -->
    <header class="bg-white py-[100px] lg:py-[100px] pt-[90px]">
        <div class="max-w-[1150px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-[70px] items-center">
            <div>
                <div class="text-[#b58b43] text-[14px] font-bold tracking-[2px] uppercase mb-[18px]">
                    Senior Product Manager
                </div>
                <h1 class="text-[40px] sm:text-[46px] lg:text-[58px] leading-[1.05] mb-[20px] text-[#111827] font-bold">
                    Building enterprise products from problem to impact.
                </h1>
                <div class="text-[24px] font-semibold text-[#374151] mb-[22px]">
                    Product Strategy · Enterprise Platforms · AI · Data & Analytics
                </div>
                <p class="text-[17px] text-[#5b6472] max-w-[720px] mb-[30px]">
                    Senior Product Manager with 10+ years of experience across
                    FinTech, Telecom, HealthTech and Enterprise IT, building
                    digital platforms, workflow automation, AI-enabled products
                    and data-driven solutions.
                </p>
                <div class="flex gap-[14px] flex-wrap">
                    <a class="px-5 py-3 rounded-lg text-[14px] font-semibold bg-[#172033] text-white border border-[#172033] hover:bg-[#2d3748] transition-colors" href="#projects">
                        Explore My Product Work
                    </a>
                    <a class="px-5 py-3 rounded-lg text-[14px] font-semibold border border-[#d1d5db] text-[#172033] hover:bg-[#f3f4f6] transition-colors" href="mailto:manoj.pant.pm@outlook.com">
                        Contact Me
                    </a>
                </div>
            </div>

            <div class="bg-[#172033] text-white rounded-[18px] p-[35px] shadow-[0_20px_50px_rgba(0,0,0,0.12)]">
                <h3 class="text-[20px] mb-[25px]">Product Profile</h3>
                <div class="border-t border-white/18 py-[18px]">
                    <strong class="block text-[25px]">10+</strong>
                    <span class="text-[13px] text-[#cbd5e1]">Years of professional experience</span>
                </div>
                <div class="border-t border-white/18 py-[18px]">
                    <strong class="block text-[25px]">4</strong>
                    <span class="text-[13px] text-[#cbd5e1]">Industry domains</span>
                </div>
                <div class="border-t border-white/18 py-[18px]">
                    <strong class="block text-[25px]">8</strong>
                    <span class="text-[13px] text-[#cbd5e1]">Featured product & analytics projects</span>
                </div>
                <div class="border-t border-white/18 py-[18px]">
                    <strong class="block text-[25px]">0 → 1</strong>
                    <span class="text-[13px] text-[#cbd5e1]">Product discovery, validation & launch experience</span>
                </div>
            </div>
        </div>
    </header>

    <!-- ABOUT -->
    <section id="about" class="py-[85px]">
        <div class="max-w-[1150px] mx-auto px-6">
            <div class="text-[#b58b43] text-[13px] font-bold tracking-[2px] uppercase mb-[10px]">About</div>
            <h2 class="text-[38px] text-[#111827] mb-[16px] font-bold">From analytics and business analysis to product leadership.</h2>
            <p class="max-w-[750px] text-[#667085] mb-[45px]">
                My product journey combines data-driven decision making,
                business analysis, technical understanding and end-to-end
                product delivery. I work across product strategy, discovery,
                requirements, architecture collaboration, Agile delivery,
                analytics and continuous product improvement.
            </p>
        </div>
    </section>

    <!-- PRODUCT JOURNEY -->
    <section class="journey bg-[#f7f8fa] py-[85px]" id="journey">
        <div class="max-w-[1150px] mx-auto px-6">
            <div class="text-[#b58b43] text-[13px] font-bold tracking-[2px] uppercase mb-[10px]">Product Journey</div>
            <h2 class="text-[38px] text-[#111827] mb-[16px] font-bold">A career built across data, technology and products.</h2>
            <p class="max-w-[750px] text-[#667085] mb-[45px]">My career evolved from enterprise analytics and reporting into business analysis and then product management.</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[18px]">
                <div class="bg-white p-[25px] rounded-[12px] border border-[#e5e7eb]">
                    <div class="text-[#b58b43] text-[13px] font-bold mb-[10px]">2016 – 2023</div>
                    <h3 class="mb-[10px] text-[19px] font-bold">Nokia Networks</h3>
                    <p class="text-[#667085] text-[14px]">Reporting Analyst → Business Analyst. Power BI, Tableau, SQL, requirements, business cases, KPI frameworks and telecom enterprise programs.</p>
                </div>
                <div class="bg-white p-[25px] rounded-[12px] border border-[#e5e7eb]">
                    <div class="text-[#b58b43] text-[13px] font-bold mb-[10px]">2023 – 2024</div>
                    <h3 class="mb-[10px] text-[19px] font-bold">Ayu Health</h3>
                    <p class="text-[#667085] text-[14px]">Product Management across healthcare workflows, provider products, CRM, automation and 0→1 product development.</p>
                </div>
                <div class="bg-white p-[25px] rounded-[12px] border border-[#e5e7eb]">
                    <div class="text-[#b58b43] text-[13px] font-bold mb-[10px]">2024</div>
                    <h3 class="mb-[10px] text-[19px] font-bold">Phoneme Solutions</h3>
                    <p class="text-[#667085] text-[14px]">Product requirements, workflow optimization, CRM-enabled healthcare claims and AI-powered OCR enhancements.</p>
                </div>
                <div class="bg-white p-[25px] rounded-[12px] border border-[#e5e7eb]">
                    <div class="text-[#b58b43] text-[13px] font-bold mb-[10px]">2024 – 2026</div>
                    <h3 class="mb-[10px] text-[19px] font-bold">M2P Solutions</h3>
                    <p class="text-[#667085] text-[14px]">Senior Product Manager across enterprise banking, payments, lending, automation, AI and scalable digital platforms.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- PROJECTS -->
    <section class="projects bg-white py-[85px]" id="projects">
        <div class="max-w-[1150px] mx-auto px-6">
            <div class="text-[#b58b43] text-[13px] font-bold tracking-[2px] uppercase mb-[10px]">Selected Product Work</div>
            <h2 class="text-[38px] text-[#111827] mb-[16px] font-bold">Product & platform case studies</h2>
            <p class="max-w-[750px] text-[#667085] mb-[45px]">Selected work spanning enterprise SaaS, digital banking, payments, healthcare, telecom analytics and workflow automation.</p>

            <!-- M2P -->
            <div class="mb-[55px]">
                <div class="flex items-center gap-3 mb-[20px]">
                    <h3 class="text-[22px] font-bold">M2P Solutions</h3>
                    <span class="text-[#667085] text-[14px]">FinTech · Enterprise Platforms</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[22px]">
                    <div class="border border-[#e3e6eb] rounded-[13px] p-[27px] bg-white transition-all hover:-translate-y-1 hover:shadow-xl hover:border-[#c9a76a]">
                        <div class="text-[#b58b43] text-[13px] font-bold mb-[12px]">PROJECT 01</div>
                        <h4 class="text-[19px] font-bold mb-[12px] leading-snug">Integrated Channels Suite</h4>
                        <p class="text-[#667085] text-[14px] mb-[20px]">Digital banking platform integrating 12+ enterprise applications using API-first architecture and configurable workflows.</p>
                        <a class="text-[13px] font-bold text-[#172033]" href="/projects/integrated-channels/">View Case Study →</a>
                    </div>
                    <div class="border border-[#e3e6eb] rounded-[13px] p-[27px] bg-white transition-all hover:-translate-y-1 hover:shadow-xl hover:border-[#c9a76a]">
                        <div class="text-[#b58b43] text-[13px] font-bold mb-[12px]">PROJECT 02</div>
                        <h4 class="text-[19px] font-bold mb-[12px] leading-snug">Pulse – Workforce Management Platform</h4>
                        <p class="text-[#667085] text-[14px] mb-[20px]">Internal workforce platform covering attendance, timesheets, task allocation, performance and productivity.</p>
                        <span class="text-[13px] font-bold text-[#172033]">Case study coming →</span>
                    </div>
                    <div class="border border-[#e3e6eb] rounded-[13px] p-[27px] bg-white transition-all hover:-translate-y-1 hover:shadow-xl hover:border-[#c9a76a]">
                        <div class="text-[#b58b43] text-[13px] font-bold mb-[12px]">PROJECT 03</div>
                        <h4 class="text-[19px] font-bold mb-[12px] leading-snug">UPI-Based Payments & Collections</h4>
                        <p class="text-[#667085] text-[14px] mb-[20px]">0→1 UPI collections platform covering payment allocation, transaction workflows and automated reconciliation.</p>
                        <span class="text-[13px] font-bold text-[#172033]">Case study coming →</span>
                    </div>
                </div>
            </div>

            <!-- AYU -->
            <div class="mb-[55px]">
                <div class="flex items-center gap-3 mb-[20px]">
                    <h3 class="text-[22px] font-bold">Ayu Health</h3>
                    <span class="text-[#667085] text-[14px]">HealthTech · Digital Healthcare</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[22px]">
                    <div class="border border-[#e3e6eb] rounded-[13px] p-[27px] bg-white transition-all hover:-translate-y-1 hover:shadow-xl hover:border-[#c9a76a]">
                        <div class="text-[#b58b43] text-[13px] font-bold mb-[12px]">PROJECT 04</div>
                        <h4 class="text-[19px] font-bold mb-[12px] leading-snug">Ayu DocConnect</h4>
                        <p class="text-[#667085] text-[14px] mb-[20px]">Doctor workflow and engagement platform covering onboarding, engagement, treatment operations and workflow coordination.</p>
                        <span class="text-[13px] font-bold text-[#172033]">Case study coming →</span>
                    </div>
                    <div class="border border-[#e3e6eb] rounded-[13px] p-[27px] bg-white transition-all hover:-translate-y-1 hover:shadow-xl hover:border-[#c9a76a]">
                        <div class="text-[#b58b43] text-[13px] font-bold mb-[12px]">PROJECT 05</div>
                        <h4 class="text-[19px] font-bold mb-[12px] leading-snug">Prior Authorization & Patient Care</h4>
                        <p class="text-[#667085] text-[14px] mb-[20px]">Structured healthcare workflows covering authorization, insurance, TPA approvals, documentation and patient care.</p>
                        <span class="text-[13px] font-bold text-[#172033]">Case study coming →</span>
                    </div>
                </div>
            </div>

            <!-- NOKIA -->
            <div class="mb-[55px]">
                <div class="flex items-center gap-3 mb-[20px]">
                    <h3 class="text-[22px] font-bold">Nokia Networks</h3>
                    <span class="text-[#667085] text-[14px]">Telecom · Analytics · Enterprise Programs</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[22px]">
                    <div class="border border-[#e3e6eb] rounded-[13px] p-[27px] bg-white transition-all hover:-translate-y-1 hover:shadow-xl hover:border-[#c9a76a]">
                        <div class="text-[#b58b43] text-[13px] font-bold mb-[12px]">PROJECT 06</div>
                        <h4 class="text-[19px] font-bold mb-[12px] leading-snug">Telecom Cost Optimization</h4>
                        <p class="text-[#667085] text-[14px] mb-[20px]">KPI-driven cost optimization initiative improving utilization visibility, reporting and operational efficiency.</p>
                        <span class="text-[13px] font-bold text-[#172033]">Case study coming →</span>
                    </div>
                    <div class="border border-[#e3e6eb] rounded-[13px] p-[27px] bg-white transition-all hover:-translate-y-1 hover:shadow-xl hover:border-[#c9a76a]">
                        <div class="text-[#b58b43] text-[13px] font-bold mb-[12px]">PROJECT 07</div>
                        <h4 class="text-[19px] font-bold mb-[12px] leading-snug">Enterprise Reporting & Insights</h4>
                        <p class="text-[#667085] text-[14px] mb-[20px]">Power BI and Tableau reporting platform providing KPI tracking, reporting automation and operational insights.</p>
                        <span class="text-[13px] font-bold text-[#172033]">Case study coming →</span>
                    </div>
                    <div class="border border-[#e3e6eb] rounded-[13px] p-[27px] bg-white transition-all hover:-translate-y-1 hover:shadow-xl hover:border-[#c9a76a]">
                        <div class="text-[#b58b43] text-[13px] font-bold mb-[12px]">PROJECT 08</div>
                        <h4 class="text-[19px] font-bold mb-[12px] leading-snug">Network Rollout Financial Tracking</h4>
                        <p class="text-[#667085] text-[14px] mb-[20px]">Financial tracking platform combining operational and financial data to monitor costs, budgets, milestones and variances.</p>
                        <span class="text-[13px] font-bold text-[#172033]">Case study coming →</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CAPABILITIES -->
    <section class="capabilities bg-[#f7f8fa] py-[85px]" id="capabilities">
        <div class="max-w-[1150px] mx-auto px-6">
            <div class="text-[#b58b43] text-[13px] font-bold tracking-[2px] uppercase mb-[10px]">Capabilities</div>
            <h2 class="text-[38px] text-[#111827] mb-[16px] font-bold">What I bring to product teams</h2>
            <p class="max-w-[750px] text-[#667085] mb-[45px]">A combination of product strategy, technical understanding, analytics and enterprise delivery.</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[18px]">
                <div class="bg-white p-[24px] rounded-[12px] border border-[#e5e7eb]">
                    <h3 class="text-[17px] font-bold mb-[12px]">Product Strategy</h3>
                    <p class="text-[#667085] text-[14px]">Vision, product strategy, roadmaps, discovery, market research and competitive analysis.</p>
                </div>
                <div class="bg-white p-[24px] rounded-[12px] border border-[#e5e7eb]">
                    <h3 class="text-[17px] font-bold mb-[12px]">Product Delivery</h3>
                    <p class="text-[#667085] text-[14px]">PRDs, BRDs, user stories, prioritization, Agile delivery, UAT, releases and stakeholder management.</p>
                </div>
                <div class="bg-white p-[24px] rounded-[12px] border border-[#e5e7eb]">
                    <h3 class="text-[17px] font-bold mb-[12px]">Technology & Architecture</h3>
                    <p class="text-[#667085] text-[14px]">API-first architecture, microservices, integrations, data flows, cloud-ready platforms and scalable workflows.</p>
                </div>
                <div class="bg-white p-[24px] rounded-[12px] border border-[#e5e7eb]">
                    <h3 class="text-[17px] font-bold mb-[12px]">AI & Data</h3>
                    <p class="text-[#667085] text-[14px]">AI/GenAI use cases, rapid prototyping, product analytics, SQL, Power BI, Tableau and data strategy.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTACT -->
    <section class="contact bg-[#172033] text-white py-[85px]" id="contact">
        <div class="max-w-[1150px] mx-auto px-6">
            <div class="text-[#b58b43] text-[13px] font-bold tracking-[2px] uppercase mb-[10px]">Contact</div>
            <h2 class="text-[38px] text-white mb-[16px] font-bold">Let's connect.</h2>
            <p class="text-[#cbd5e1] max-w-[700px] mb-[25px]">
                I'm interested in Product Management opportunities involving enterprise platforms, digital products, AI, data and technology-led transformation.
            </p>
            <div class="flex gap-[25px] flex-wrap">
                <a href="mailto:manoj.pant.pm@outlook.com" class="text-white border-b border-[#b58b43] pb-[3px]">Email</a>
                <a href="https://www.linkedin.com/in/manoj-pant-35129495/" target="_blank" class="text-white border-b border-[#b58b43] pb-[3px]">LinkedIn</a>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-[#101623] text-[#94a3b8] text-center p-[22px] text-[13px]">
        © 2026 Manoj Pant · Senior Product Manager Portfolio
    </footer>
</Layout>