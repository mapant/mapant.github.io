---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Manoj Pant | Senior Product Manager">
    <!-- NAVIGATION -->
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50 h-[70px] flex items-center">
        <div class="max-w-[1250px] w-full mx-auto px-6 flex items-center justify-between">
            <div class="text-[20px] font-extrabold tracking-tight text-[#172033]">
                MANOJ PANT
            </div>
            <div class="hidden md:flex gap-8 text-[13px] font-bold text-gray-600 uppercase tracking-wider">
                <a href="#hero" class="hover:text-[#b58b43] transition-colors">Overview</a>
                <a href="#about" class="hover:text-[#b58b43] transition-colors">About</a>
                <a href="#journey" class="hover:text-[#b58b43] transition-colors">Journey</a>
                <a href="#projects" class="hover:text-[#b58b43] transition-colors">Projects</a>
                <a href="#capabilities" class="hover:text-[#b58b43] transition-colors">Capabilities</a>
                <a href="#contact" class="hover:text-[#b58b43] transition-colors">Contact</a>
            </div>
        </div>
    </nav>

    <main class="snap-y snap-mandatory overflow-y-scroll h-[calc(100vh-70px)]">
        
        <!-- HERO / SLIDE 1 -->
        <section id="hero" class="snap-start h-[calc(100vh-70px)] flex flex-col justify-between bg-white py-10">
            <div class="max-w-[1250px] w-full mx-auto px-6 grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-12 items-center my-auto">
                <div>
                    <div class="text-[#b58b43] text-[12px] font-black tracking-[0.2em] uppercase mb-4">
                        Senior Product Manager
                    </div>
                    <h1 class="text-[42px] sm:text-[52px] lg:text-[62px] leading-[1.02] tracking-tight mb-5 text-[#111827] font-black">
                        Building enterprise products from problem to impact.
                    </h1>
                    <div class="text-[19px] font-bold text-[#374151] mb-5">
                        Product Strategy · Enterprise Platforms · AI · Data & Analytics
                    </div>
                    <p class="text-[15px] text-[#5b6472] max-w-[700px] mb-8 leading-relaxed">
                        Senior Product Manager with 10+ years of experience across FinTech, Telecom, HealthTech and Enterprise IT, building digital platforms, workflow automation, AI-enabled products and data-driven solutions.
                    </p>
                    <div class="flex gap-4 flex-wrap">
                        <a class="px-5 py-3 rounded-xl text-[13px] font-black bg-[#172033] text-white border border-[#172033] hover:bg-[#2d3748] transition-all shadow-md" href="#projects">
                            Explore My Product Work →
                        </a>
                        <a class="px-5 py-3 rounded-xl text-[13px] font-black border border-gray-300 text-[#172033] hover:bg-gray-50 transition-all" href="mailto:manoj.pant.pm@outlook.com">
                            Contact Me
                        </a>
                    </div>
                </div>

                <div class="bg-[#172033] text-white rounded-2xl p-7 shadow-2xl border border-slate-800">
                    <h3 class="text-[18px] font-bold mb-5 tracking-wide text-slate-200">Product Profile</h3>
                    <div class="border-t border-white/15 py-3.5 flex justify-between items-center">
                        <div>
                            <strong class="block text-[22px] font-black">10+</strong>
                            <span class="text-[11px] text-[#cbd5e1] uppercase tracking-wider font-semibold">Experience</span>
                        </div>
                        <div class="text-right">
                            <strong class="block text-[22px] font-black">4</strong>
                            <span class="text-[11px] text-[#cbd5e1] uppercase tracking-wider font-semibold">Industries</span>
                        </div>
                    </div>
                    <div class="border-t border-white/15 py-3.5 flex justify-between items-center">
                        <div>
                            <strong class="block text-[22px] font-black">8</strong>
                            <span class="text-[11px] text-[#cbd5e1] uppercase tracking-wider font-semibold">Featured Projects</span>
                        </div>
                        <div class="text-right">
                            <strong class="block text-[22px] font-black">0 → 1</strong>
                            <span class="text-[11px] text-[#cbd5e1] uppercase tracking-wider font-semibold">Discovery & Launch</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Navigation Bar -->
            <footer class="max-w-[1250px] w-full mx-auto px-6 py-4 border-t border-gray-100 flex justify-between items-center text-[12px] font-extrabold uppercase tracking-widest text-slate-400">
                <span>01 / Overview</span>
                <div class="flex gap-6">
                    <span class="text-slate-300">Prev</span>
                    <a href="#about" class="text-[#172033] hover:text-[#b58b43] transition-colors">Next: About →</a>
                </div>
            </footer>
        </section>

        <!-- ABOUT / SLIDE 2 -->
        <section id="about" class="snap-start h-[calc(100vh-70px)] flex flex-col justify-between bg-[#f8fafc] py-10">
            <div class="max-w-[1250px] w-full mx-auto px-6 my-auto">
                <div class="text-[#b58b43] text-[12px] font-black tracking-[0.2em] uppercase mb-3">About</div>
                <h2 class="text-[34px] sm:text-[44px] text-[#111827] mb-5 font-black tracking-tight max-w-[900px]">From analytics and business analysis to product leadership.</h2>
                <p class="max-w-[850px] text-[#667085] text-[16px] leading-relaxed">
                    My product journey combines data-driven decision making, business analysis, technical understanding and end-to-end product delivery. I work across product strategy, discovery, requirements, architecture collaboration, Agile delivery, analytics and continuous product improvement.
                </p>
            </div>
            <footer class="max-w-[1250px] w-full mx-auto px-6 py-4 border-t border-gray-200/60 flex justify-between items-center text-[12px] font-extrabold uppercase tracking-widest text-slate-400">
                <span>02 / About</span>
                <div class="flex gap-6">
                    <a href="#hero" class="text-slate-600 hover:text-[#b58b43] transition-colors">← Prev</a>
                    <a href="#journey" class="text-[#172033] hover:text-[#b58b43] transition-colors">Next: Journey →</a>
                </div>
            </footer>
        </section>

        <!-- PRODUCT JOURNEY / SLIDE 3 -->
        <section id="journey" class="snap-start h-[calc(100vh-70px)] flex flex-col justify-between bg-white py-10">
            <div class="max-w-[1250px] w-full mx-auto px-6 my-auto">
                <div class="text-[#b58b43] text-[12px] font-black tracking-[0.2em] uppercase mb-2">Product Journey</div>
                <h2 class="text-[32px] sm:text-[40px] text-[#111827] mb-3 font-black tracking-tight">A career built across data, technology and products.</h2>
                <p class="max-w-[750px] text-[#667085] text-[14px] mb-8">My career evolved from enterprise analytics and reporting into business analysis and then product management.</p>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                    <div class="bg-[#f8fafc] p-6 rounded-xl border border-gray-200">
                        <div class="text-[#b58b43] text-[12px] font-black mb-2">2016 – 2023</div>
                        <h3 class="mb-2 text-[17px] font-black text-[#172033]">Nokia Networks</h3>
                        <p class="text-[#667085] text-[13px] leading-relaxed">Reporting Analyst → Business Analyst. Power BI, Tableau, SQL, requirements, business cases, KPI frameworks and telecom enterprise programs.</p>
                    </div>
                    <div class="bg-[#f8fafc] p-6 rounded-xl border border-gray-200">
                        <div class="text-[#b58b43] text-[12px] font-black mb-2">2023 – 2024</div>
                        <h3 class="mb-2 text-[17px] font-black text-[#172033]">Ayu Health</h3>
                        <p class="text-[#667085] text-[13px] leading-relaxed">Product Management across healthcare workflows, provider products, CRM, automation and 0→1 product development.</p>
                    </div>
                    <div class="bg-[#f8fafc] p-6 rounded-xl border border-gray-200">
                        <div class="text-[#b58b43] text-[12px] font-black mb-2">2024</div>
                        <h3 class="mb-2 text-[17px] font-black text-[#172033]">Phoneme Solutions</h3>
                        <p class="text-[#667085] text-[13px] leading-relaxed">Product requirements, workflow optimization, CRM-enabled healthcare claims and AI-powered OCR enhancements.</p>
                    </div>
                    <div class="bg-[#f8fafc] p-6 rounded-xl border border-gray-200">
                        <div class="text-[#b58b43] text-[12px] font-black mb-2">2024 – 2026</div>
                        <h3 class="mb-2 text-[17px] font-black text-[#172033]">M2P Solutions</h3>
                        <p class="text-[#667085] text-[13px] leading-relaxed">Senior Product Manager across enterprise banking, payments, lending, automation, AI and scalable digital platforms.</p>
                    </div>
                </div>
            </div>
            <footer class="max-w-[1250px] w-full mx-auto px-6 py-4 border-t border-gray-100 flex justify-between items-center text-[12px] font-extrabold uppercase tracking-widest text-slate-400">
                <span>03 / Journey</span>
                <div class="flex gap-6">
                    <a href="#about" class="text-slate-600 hover:text-[#b58b43] transition-colors">← Prev</a>
                    <a href="#projects" class="text-[#172033] hover:text-[#b58b43] transition-colors">Next: Projects →</a>
                </div>
            </footer>
        </section>

        <!-- PROJECTS / SLIDE 4 -->
        <section id="projects" class="snap-start h-[calc(100vh-70px)] flex flex-col justify-between bg-[#f8fafc] py-10">
            <div class="max-w-[1250px] w-full mx-auto px-6 my-auto overflow-y-auto max-h-[75vh]">
                <div class="text-[#b58b43] text-[12px] font-black tracking-[0.2em] uppercase mb-2">Selected Product Work</div>
                <h2 class="text-[32px] sm:text-[38px] text-[#111827] mb-3 font-black tracking-tight">Product & platform case studies</h2>
                <p class="max-w-[750px] text-[#667085] text-[14px] mb-6">Selected work spanning enterprise SaaS, digital banking, payments, healthcare, telecom analytics and workflow automation.</p>

                <!-- M2P -->
                <div class="mb-6">
                    <div class="flex items-center gap-3 mb-3">
                        <h3 class="text-[18px] font-black text-[#172033]">M2P Solutions</h3>
                        <span class="text-[#667085] text-[12px] font-semibold">FinTech · Enterprise Platforms</span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="border border-gray-200 rounded-xl p-5 bg-white transition-all hover:shadow-lg hover:border-[#c9a76a] flex flex-col justify-between">
                            <div>
                                <div class="text-[#b58b43] text-[11px] font-black mb-1.5">PROJECT 01</div>
                                <h4 class="text-[16px] font-black mb-2 leading-snug">Integrated Channels Suite</h4>
                                <p class="text-[#667085] text-[12.5vpx] mb-4 leading-normal">Digital banking platform integrating 12+ enterprise applications using API-first architecture.</p>
                            </div>
                            <a class="text-[12px] font-black text-[#172033] hover:text-[#b58b43]" href="/projects/integrated-channels/">View Case Study →</a>
                        </div>
                        <div class="border border-gray-200 rounded-xl p-5 bg-white transition-all hover:shadow-lg flex flex-col justify-between">
                            <div>
                                <div class="text-[#b58b43] text-[11px] font-black mb-1.5">PROJECT 02</div>
                                <h4 class="text-[16px] font-black mb-2 leading-snug">Pulse – Workforce Management</h4>
                                <p class="text-[#667085] text-[12.5px] mb-4 leading-normal">Internal workforce platform covering attendance, timesheets, task allocation and performance.</p>
                            </div>
                            <span class="text-[12px] font-bold text-slate-400">Case study coming →</span>
                        </div>
                        <div class="border border-gray-200 rounded-xl p-5 bg-white transition-all hover:shadow-lg flex flex-col justify-between">
                            <div>
                                <div class="text-[#b58b43] text-[11px] font-black mb-1.5">PROJECT 03</div>
                                <h4 class="text-[16px] font-black mb-2 leading-snug">UPI Payments & Collections</h4>
                                <p class="text-[#667085] text-[12.5px] mb-4 leading-normal">0→1 UPI collections platform covering payment allocation and automated reconciliation.</p>
                            </div>
                            <span class="text-[12px] font-bold text-slate-400">Case study coming →</span>
                        </div>
                    </div>
                </div>
            </div>
            <footer class="max-w-[1250px] w-full mx-auto px-6 py-4 border-t border-gray-200/60 flex justify-between items-center text-[12px] font-extrabold uppercase tracking-widest text-slate-400">
                <span>04 / Projects</span>
                <div class="flex gap-6">
                    <a href="#journey" class="text-slate-600 hover:text-[#b58b43] transition-colors">← Prev</a>
                    <a href="#capabilities" class="text-[#172033] hover:text-[#b58b43] transition-colors">Next: Capabilities →</a>
                </div>
            </footer>
        </section>

        <!-- CAPABILITIES / SLIDE 5 -->
        <section id="capabilities" class="snap-start h-[calc(100vh-70px)] flex flex-col justify-between bg-white py-10">
            <div class="max-w-[1250px] w-full mx-auto px-6 my-auto">
                <div class="text-[#b58b43] text-[12px] font-black tracking-[0.2em] uppercase mb-2">Capabilities</div>
                <h2 class="text-[32px] sm:text-[40px] text-[#111827] mb-3 font-black tracking-tight">What I bring to product teams</h2>
                <p class="max-w-[750px] text-[#667085] text-[14px] mb-8">A combination of product strategy, technical understanding, analytics and enterprise delivery.</p>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                    <div class="bg-[#f8fafc] p-6 rounded-xl border border-gray-200">
                        <h3 class="text-[17px] font-black mb-2 text-[#172033]">Product Strategy</h3>
                        <p class="text-[#667085] text-[13px] leading-relaxed">Vision, product strategy, roadmaps, discovery, market research and competitive analysis.</p>
                    </div>
                    <div class="bg-[#f8fafc] p-6 rounded-xl border border-gray-200">
                        <h3 class="text-[17px] font-black mb-2 text-[#172033]">Product Delivery</h3>
                        <p class="text-[#667085] text-[13px] leading-relaxed">PRDs, BRDs, user stories, prioritization, Agile delivery, UAT, releases and stakeholder management.</p>
                    </div>
                    <div class="bg-[#f8fafc] p-6 rounded-xl border border-gray-200">
                        <h3 class="text-[17px] font-black mb-2 text-[#172033]">Technology & Architecture</h3>
                        <p class="text-[#667085] text-[13px] leading-relaxed">API-first architecture, microservices, integrations, data flows, cloud-ready platforms and scalable workflows.</p>
                    </div>
                    <div class="bg-[#f8fafc] p-6 rounded-xl border border-gray-200">
                        <h3 class="text-[17px] font-black mb-2 text-[#172033]">AI & Data</h3>
                        <p class="text-[#667085] text-[13px] leading-relaxed">AI/GenAI use cases, rapid prototyping, product analytics, SQL, Power BI, Tableau and data strategy.</p>
                    </div>
                </div>
            </div>
            <footer class="max-w-[1250px] w-full mx-auto px-6 py-4 border-t border-gray-100 flex justify-between items-center text-[12px] font-extrabold uppercase tracking-widest text-slate-400">
                <span>05 / Capabilities</span>
                <div class="flex gap-6">
                    <a href="#projects" class="text-slate-600 hover:text-[#b58b43] transition-colors">← Prev</a>
                    <a href="#contact" class="text-[#172033] hover:text-[#b58b43] transition-colors">Next: Contact →</a>
                </div>
            </footer>
        </section>

        <!-- CONTACT / SLIDE 6 -->
        <section id="contact" class="snap-start h-[calc(100vh-70px)] flex flex-col justify-between bg-[#172033] text-white py-10">
            <div class="max-w-[1250px] w-full mx-auto px-6 my-auto">
                <div class="text-[#b58b43] text-[12px] font-black tracking-[0.2em] uppercase mb-3">Contact</div>
                <h2 class="text-[36px] sm:text-[46px] text-white mb-4 font-black tracking-tight">Let's connect.</h2>
                <p class="text-[#cbd5e1] max-w-[700px] mb-8 text-[16px] leading-relaxed">
                    I'm interested in Product Management opportunities involving enterprise platforms, digital products, AI, data and technology-led transformation.
                </p>
                <div class="flex gap-8 flex-wrap text-[15px] font-bold">
                    <a href="mailto:manoj.pant.pm@outlook.com" class="text-white border-b-2 border-[#b58b43] pb-1 hover:text-[#b58b43] transition-colors">Email Me</a>
                    <a href="https://www.linkedin.com/in/manoj-pant-35129495/" target="_blank" class="text-white border-b-2 border-[#b58b43] pb-1 hover:text-[#b58b43] transition-colors">LinkedIn Profile →</a>
                </div>
            </div>
            <footer class="max-w-[1250px] w-full mx-auto px-6 py-4 border-t border-slate-800 flex justify-between items-center text-[12px] font-extrabold uppercase tracking-widest text-slate-500">
                <span>06 / Contact</span>
                <div class="flex gap-6">
                    <a href="#capabilities" class="text-slate-400 hover:text-white transition-colors">← Prev</a>
                    <span class="text-slate-600">End of Portfolio</span>
                </div>
            </footer>
        </section>

    </main>
</Layout>