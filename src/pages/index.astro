---
import Layout from '../layouts/Layout.astro';

const products = [
  {
    number: '01',
    company: 'M2P Fintech',
    title: 'Integrated Channels Suite',
    description: 'A modular enterprise platform bringing together banking, lending, payments, compliance and operational capabilities through configurable workflows and integrations.',
    tags: ['Banking', 'Lending', 'Payments', 'AML/KYC'],
    url: '/projects/integrated-channels',
    tint: 'tint-blue'
  },
  {
    number: '02',
    company: 'Ayu Health',
    title: 'Ayu DocConnect',
    description: 'A 0→1 digital healthcare product focused on doctor acquisition, onboarding, engagement and treatment-related workflows across mobile platforms.',
    tags: ['0→1 Product', 'Mobile', 'Provider Experience', 'Adoption'],
    url: '/projects/ayu-docconnect',
    tint: 'tint-mint'
  },
  {
    number: '03',
    company: 'Phoneme / Ayu',
    title: 'Provider Payout Automation',
    description: 'A rules-driven workflow product for provider onboarding, payout calculations, approvals and operational processing.',
    tags: ['Workflow Automation', 'Rules', 'Operations', 'Healthcare'],
    url: '/projects/provider-payout',
    tint: 'tint-amber'
  },
  {
    number: '04',
    company: 'Nokia Networks',
    title: 'Telecom Cost Optimization',
    description: 'A data-driven financial and operational optimization initiative using KPI frameworks, analytics, executive dashboards and workflow automation.',
    tags: ['Analytics', 'Cost Optimization', 'KPIs', 'Automation'],
    url: '/projects/telecom-cost-optimization',
    tint: 'tint-lav'
  },
  {
    number: '05',
    company: 'Nokia Networks',
    title: 'Global Service Delivery Analytics',
    description: 'Enterprise analytics and reporting designed to improve visibility into service performance, operational KPIs and global delivery operations.',
    tags: ['Data Analytics', 'Power BI', 'KPIs', 'Enterprise Reporting'],
    url: '/projects/global-service-delivery',
    tint: 'tint-lav'
  }
];

const approach = [
  ['01', 'Discover', 'Understand users, business problems, processes and opportunities.'],
  ['02', 'Define', 'Translate problems into product requirements, journeys and capabilities.'],
  ['03', 'Build', 'Work with design, engineering and cross-functional teams to deliver.'],
  ['04', 'Measure', 'Use product and business metrics to evaluate adoption and outcomes.']
];

const capabilities = [
  ['Product', 'Strategy · Roadmaps · Discovery · Prioritization · Agile Delivery'],
  ['Technical', 'APIs · Integrations · Workflow Design · DFD · ER Models · Architecture Collaboration'],
  ['Data', 'SQL · Power BI · Tableau · KPI Frameworks · Product Analytics'],
  ['Enterprise', 'Banking · Lending · Payments · Healthcare · Telecom · Enterprise Platforms']
];

const outcomes = [
  ['40% → 75%', 'Doctor adoption', 'Ayu Health'],
  ['10 → 2 days', 'Provider payout turnaround', 'Provider Automation'],
  ['20%', 'Operational efficiency improvement', 'Enterprise initiatives'],
  ['25%', 'Telecom operating-cost reduction', 'Nokia Networks']
];
---

<Layout title="Manoj Pant | Senior Product Manager | Product Portfolio">
    <style>
        :root {
            --navy: #102f55; --navy-2: #163d6a; 
            --ink: #102a4d; --ink-2: #365774; --muted: #627c97; 
            --line: #d8e4ef; --line-2: #e8eff5;
            --bg: #f8fafc; --paper: #fff; 
            --blue: #2468d7; --blue-soft: #f0f6fc;
            --lav: #7658d9; --lav-soft: #f4f1ff; 
            --mint: #17886f; --mint-soft: #f0fbf7;
            --amber: #be7615; --amber-soft: #fff9f0;
            --teal: #167d87;
            --radius: 8px;
            --max: 1200px;
            --header-h: 70px;
            --shadow: 0 4px 16px rgba(16, 47, 85, 0.04); 
            --sans: Inter, ui-sans-serif, system-ui, sans-serif;
        }

        * { box-sizing: border-box; }

        html { scroll-behavior: smooth; }
        body { 
            margin: 0; background: var(--bg); color: var(--ink); 
            font-family: var(--sans); font-size: 14px; line-height: 1.5; 
            overflow-x: hidden; 
        }
        
        main {
            height: calc(100vh - var(--header-h));
            overflow-y: auto;
            scroll-snap-type: y mandatory;
        }
        
        .slide-page { 
            min-height: calc(100vh - var(--header-h)); 
            scroll-snap-align: start; 
            display: flex; 
            flex-direction: column; 
            justify-content: center; 
            padding: 40px 0; 
        }

        .wrap { width: 100%; padding: 0 40px; margin: 0 auto; max-width: var(--max); }

        /* NAVIGATION */
        header { 
            position: sticky; top: 0; z-index: 100; 
            background: var(--paper); color: var(--navy); 
            border-bottom: 1px solid var(--line); 
            height: var(--header-h);
        }
        .head { 
            height: 100%; display: grid; 
            grid-template-columns: 220px 1fr auto; gap: 24px; align-items: center; 
        }
        .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
        .brand-logo { 
            width: 32px; height: 32px; border-radius: 6px; 
            background: var(--navy); color: #fff; display: flex; 
            align-items: center; justify-content: center; font-weight: 800; font-size: 13px;
        }
        .brand-copy b { display: block; font-size: 14px; color: var(--navy); letter-spacing: -0.01em; }
        .brand-copy small { display: block; color: var(--muted); font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }

        #nav { display: flex; gap: 4px; justify-content: center; }
        #nav a { 
            padding: 6px 14px; border-radius: 6px; color: var(--ink-2); 
            font-size: 12px; font-weight: 600; transition: 0.2s; text-decoration: none;
        }
        #nav a:hover, #nav a.active { background: var(--blue-soft); color: var(--blue); }

        .btn { 
            display: inline-flex; align-items: center; justify-content: center; 
            padding: 10px 18px; border-radius: 6px; font-size: 12px; font-weight: 700; 
            transition: 0.2s; text-decoration: none; cursor: pointer;
        }
        .btn.primary { background: var(--amber); color: #fff; }
        .btn.primary:hover { opacity: 0.9; }
        .btn.outline { border: 1px solid currentColor; background: transparent; }
        .btn.outline:hover { background: rgba(0,0,0,0.03); }

        /* GRIDS & CARDS */
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
        .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }

        .card { 
            padding: 24px; 
            border: 1px solid var(--line); 
            border-radius: var(--radius); 
            background: var(--paper); 
            box-shadow: var(--shadow); 
            height: 100%; 
            display: flex; 
            flex-direction: column; 
        }
        .card .eyebrow { 
            font-size: 10px; font-weight: 800; letter-spacing: 0.1em; 
            text-transform: uppercase; margin-bottom: 8px; 
        }
        .card h3 { font-size: 16px; margin: 0 0 10px; color: var(--navy); line-height: 1.3; font-weight: 800; }
        .card p { font-size: 13px; margin: 0 0 16px; color: var(--ink-2); flex: 1; line-height: 1.5; }

        .card.tint-blue { background: var(--blue-soft); border-color: #d1e4f9; }
        .card.tint-blue .eyebrow { color: var(--blue); }

        .card.tint-mint { background: var(--mint-soft); border-color: #c7efe2; }
        .card.tint-mint .eyebrow { color: var(--mint); }

        .card.tint-amber { background: var(--amber-soft); border-color: #fce3c0; }
        .card.tint-amber .eyebrow { color: var(--amber); }

        .card.tint-lav { background: var(--lav-soft); border-color: #e2d9ff; }
        .card.tint-lav .eyebrow { color: var(--lav); }

        .tag-cloud { display: flex; flex-wrap: wrap; gap: 6px; }
        .tag { 
            padding: 4px 10px; background: #fff; border: 1px solid rgba(0,0,0,0.06); 
            border-radius: 4px; font-size: 10px; font-weight: 700; color: var(--ink-2); 
            letter-spacing: 0.02em;
        }

        /* TYPOGRAPHY */
        .section-head { margin-bottom: 32px; max-width: 700px; }
        .section-head .eyebrow { display: block; font-size: 10px; font-weight: 800; color: var(--amber); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px; }
        .section-head h2 { font-size: 28px; letter-spacing: -0.02em; color: var(--navy); font-weight: 800; margin: 0 0 12px; line-height: 1.15; }
        .section-head p { font-size: 14px; color: var(--ink-2); margin: 0; line-height: 1.5; }

        .hero-title { font-size: 38px; font-weight: 800; color: var(--navy); line-height: 1.1; letter-spacing: -0.02em; margin: 20px 0; max-width: 800px; }
        .hero-lead { font-size: 15px; color: var(--ink-2); line-height: 1.6; max-width: 700px; margin: 0 0 24px; }

        .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 32px; max-width: 800px; }
        .stat-box { background: #fff; border: 1px solid var(--line); padding: 20px; border-radius: var(--radius); }
        .stat-box strong { display: block; font-size: 24px; color: var(--navy); font-weight: 800; line-height: 1; }
        .stat-box span { display: block; font-size: 9px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); font-weight: 700; margin-top: 6px; }

        .dark-section { background: var(--navy); color: #fff; }
        .dark-section .section-head h2 { color: #fff; }
        .dark-section .section-head p { color: #a9b9cc; }
        .dark-section .card { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.08); }
        .dark-section .card h3 { color: #fff; }
        .dark-section .card p { color: #a9b9cc; }
        
        @media screen and (max-width:1024px){
            .grid-3, .grid-4 { grid-template-columns: repeat(2, 1fr); }
            .stat-grid { grid-template-columns: repeat(2, 1fr); }
        }
        @media screen and (max-width:768px){
            .head { grid-template-columns: 1fr; gap: 12px; }
            #nav { flex-wrap: wrap; }
            .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
            .slide-page { min-height: auto; scroll-snap-align: none; padding: 40px 0; }
            main { scroll-snap-type: none; }
        }
    </style>

    <header>
        <div class="wrap head">
            <a aria-label="Manoj Pant Portfolio" class="brand" href="#overview">
                <span aria-hidden="true" class="brand-logo">MP</span>
                <span class="brand-copy"><b>Manoj Pant</b><small>Senior Product Manager</small></span>
            </a>
            <nav aria-label="Portfolio sections" id="nav">
                <a href="#overview">Overview</a>
                <a href="#portfolio">Portfolio</a>
                <a href="#approach">Approach</a>
                <a href="#tech">Tech & Data</a>
                <a href="#impact">Outcomes</a>
                <a href="#contact">Contact</a>
            </nav>
            <div style="justify-self: end;">
                <a class="btn primary" style="padding: 8px 16px; font-size: 11px;" href="#portfolio">View Projects</a>
            </div>
        </div>
    </header>

    <main>
        <!-- 01. OVERVIEW -->
        <section class="slide-page" id="overview">
            <div class="wrap">
                <span class="eyebrow" style="color: var(--amber); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; font-size: 10px;">Senior Product Manager</span>
                <h1 class="hero-title">Building products that solve complex business problems.</h1>
                <p class="hero-lead">Senior Product Manager with <strong>10+ years of experience</strong> across FinTech, Healthcare, Telecom and Enterprise IT, combining product strategy, business analysis, technology, data and execution to build enterprise products.</p>
                
                <div class="tag-cloud" style="margin-top: 0; gap: 8px; border-bottom: 1px solid var(--line); padding-bottom: 24px; max-width: 800px;">
                    <span class="tag" style="background: transparent; border: none; padding: 0; color: var(--navy); font-size: 12px;">Product Strategy <span style="color:var(--amber); margin:0 6px;">•</span></span>
                    <span class="tag" style="background: transparent; border: none; padding: 0; color: var(--navy); font-size: 12px;">Enterprise Platforms <span style="color:var(--amber); margin:0 6px;">•</span></span>
                    <span class="tag" style="background: transparent; border: none; padding: 0; color: var(--navy); font-size: 12px;">Digital Products <span style="color:var(--amber); margin:0 6px;">•</span></span>
                    <span class="tag" style="background: transparent; border: none; padding: 0; color: var(--navy); font-size: 12px;">Data & Analytics <span style="color:var(--amber); margin:0 6px;">•</span></span>
                    <span class="tag" style="background: transparent; border: none; padding: 0; color: var(--navy); font-size: 12px;">Workflow Automation</span>
                </div>

                <div class="stat-grid">
                    <div class="stat-box"><strong>10+</strong><span>Years Experience</span></div>
                    <div class="stat-box"><strong>12+</strong><span>Enterprise Applications</span></div>
                    <div class="stat-box"><strong>4</strong><span>Industry Ecosystems</span></div>
                    <div class="stat-box"><strong>0→1</strong><span>Product Development</span></div>
                </div>
            </div>
        </section>

        <!-- 02. PORTFOLIO MAP -->
        <section class="slide-page" id="portfolio" style="background: #fff; border-top: 1px solid var(--line);">
            <div class="wrap">
                <div class="section-head">
                    <span class="eyebrow">Selected Product Portfolio</span>
                    <h2>Products across industries and problem spaces.</h2>
                    <p>A focused selection of products and initiatives spanning banking, lending, payments, healthcare, telecom analytics and enterprise automation.</p>
                </div>
                
                <div class="grid-3" style="margin-bottom: 20px;">
                    {products.slice(0, 3).map((product) => (
                        <article class={`card ${product.tint}`}>
                            <span class="eyebrow">{product.number} · {product.company}</span>
                            <h3>{product.title}</h3>
                            <p>{product.description}</p>
                            <div class="tag-cloud">
                                {product.tags.map((tag) => ( <span class="tag">{tag}</span> ))}
                            </div>
                            <a href={product.url} style="margin-top: 16px; font-size: 11px; font-weight: 700; color: var(--navy); text-decoration: none; display: inline-block;">View Case Study →</a>
                        </article>
                    ))}
                </div>
                <div class="grid-2">
                    {products.slice(3, 5).map((product) => (
                        <article class={`card ${product.tint}`}>
                            <span class="eyebrow">{product.number} · {product.company}</span>
                            <h3>{product.title}</h3>
                            <p>{product.description}</p>
                            <div class="tag-cloud">
                                {product.tags.map((tag) => ( <span class="tag">{tag}</span> ))}
                            </div>
                            <a href={product.url} style="margin-top: 16px; font-size: 11px; font-weight: 700; color: var(--navy); text-decoration: none; display: inline-block;">View Case Study →</a>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <!-- 03. APPROACH -->
        <section class="slide-page dark-section" id="approach">
            <div class="wrap">
                <div class="section-head">
                    <span class="eyebrow">Product Management Approach</span>
                    <h2>From problem to product to measurable outcome.</h2>
                    <p>I work across the product lifecycle — understanding the problem, defining the product, collaborating with technology teams, delivering the solution and measuring its impact.</p>
                </div>

                <div class="grid-4">
                    {approach.map(([number, title, description]) => (
                        <article class="card">
                            <span class="eyebrow" style="color: var(--amber);">{number}</span>
                            <h3>{title}</h3>
                            <p>{description}</p>
                        </article>
                    ))}
                </div>

                <div style="margin-top: 24px; padding: 20px; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03); border-radius: var(--radius); max-width: 800px;">
                    <div style="font-size: 9px; font-weight: 800; color: var(--amber); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 6px;">Product Mindset</div>
                    <div style="font-size: 14px; font-weight: 600; color: #fff;">Customer problem + Business value + Technical feasibility + Measurable outcome</div>
                </div>
            </div>
        </section>

        <!-- 04. TECH & DATA -->
        <section class="slide-page" id="tech">
            <div class="wrap">
                <div class="section-head">
                    <span class="eyebrow">Product & Technical Depth</span>
                    <h2>Where product meets technology and data.</h2>
                    <p>A product-management foundation supported by technical understanding, analytics and enterprise delivery experience.</p>
                </div>

                <div class="grid-4">
                    {capabilities.map(([title, content]) => (
                        <article class="card" style="box-shadow: none;">
                            <h3>{title}</h3>
                            <p>{content}</p>
                        </article>
                    ))}
                </div>

                <div class="grid-4" style="margin-top: 20px;">
                    {[
                        ['SQL', 'Data & analysis'],
                        ['Power BI', 'Decision dashboards'],
                        ['APIs', 'Product integrations'],
                        ['Figma', 'Product prototyping'],
                    ].map(([name, label]) => (
                        <div style="background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px;">
                            <div style="font-weight: 800; color: var(--navy); font-size: 14px;">{name}</div>
                            <div style="font-size: 9px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); font-weight: 700; margin-top: 4px;">{label}</div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- 05. IMPACT -->
        <section class="slide-page" id="impact" style="background: #fff; border-top: 1px solid var(--line);">
            <div class="wrap">
                <div class="section-head">
                    <span class="eyebrow">Selected Outcomes</span>
                    <h2>Outcomes matter more than features.</h2>
                    <p>A few documented outcomes from the products and initiatives represented in my experience.</p>
                </div>

                <div class="grid-4">
                    {outcomes.map(([metric, label, company]) => (
                        <article class="card dark-section" style="background: var(--navy); border: none;">
                            <div style="font-size: 28px; font-weight: 800; color: var(--amber); line-height: 1; margin-bottom: 10px;">{metric}</div>
                            <h3 style="color: #fff; margin-bottom: 6px;">{label}</h3>
                            <p style="font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-top: auto;">{company}</p>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <!-- 06. CONTACT -->
        <section class="slide-page dark-section" id="contact">
            <div class="wrap">
                <div class="grid-2" style="align-items: center;">
                    <div>
                        <span class="eyebrow" style="color: var(--amber);">Senior Product Manager</span>
                        <h2 style="font-size: 38px; line-height: 1.1; margin: 12px 0 20px;">Building products where business, technology and outcomes meet.</h2>
                        <p style="font-size: 15px; max-width: 500px; line-height: 1.6;">My experience spans the journey from data and business analysis to 0→1 product development and enterprise platform management.</p>
                        
                        <div class="tag-cloud" style="margin-top: 20px; gap: 6px;">
                            {['Product Strategy', 'Enterprise Platforms', 'Technical Product Management', 'Data & Analytics'].map((tag) => (
                                <span class="tag" style="background: transparent; border-color: rgba(255,255,255,0.15); color: #fff;">{tag}</span>
                            ))}
                        </div>
                    </div>
                    <div class="card" style="margin-left: auto; width: 100%; max-width: 360px; background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.08);">
                        <span class="eyebrow" style="color: var(--amber);">Connect & Download</span>
                        
                        <a href="/Manoj_Pant_Senior_Product_Manager_AI_10Yrs.pdf" download class="btn primary" style="justify-content: flex-start; padding: 12px 16px; margin-top: 12px; font-size: 13px;">
                            ↓ Download Resume (PDF)
                        </a>

                        <a href="mailto:manoj.pant.pm@outlook.com" class="btn outline" style="color: #fff; border-color: rgba(255,255,255,0.15); justify-content: flex-start; padding: 12px 16px; margin-top: 12px;">
                            manoj.pant.pm@outlook.com
                        </a>

                        <a href="https://www.linkedin.com/in/manoj-pant-35129495/" target="_blank" rel="noreferrer" class="btn outline" style="color: #fff; border-color: rgba(255,255,255,0.15); justify-content: flex-start; padding: 12px 16px; margin-top: 10px;">
                            LinkedIn Profile →
                        </a>
                    </div>
                </div>
                
                <div style="margin-top: 60px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.08); display: flex; justify-content: space-between; font-size: 10px; color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
                    <span>© {new Date().getFullYear()} Manoj Pant</span>
                    <span>Product Portfolio</span>
                </div>
            </div>
        </section>
    </main>

    <script is:inline>
        // Navigation highlighting logic
        const sections = document.querySelectorAll('.slide-page');
        const navLinks = document.querySelectorAll('#nav a');
        const mainScroll = document.querySelector('main');

        mainScroll.addEventListener('scroll', () => {
            let current = '';
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                if (mainScroll.scrollTop >= sectionTop - 100) {
                    current = section.getAttribute('id');
                }
            });
            navLinks.forEach(a => {
                a.classList.remove('active');
                if (a.getAttribute('href').includes(current)) {
                    a.classList.add('active');
                }
            });
        }, { passive: true });
    </script>
</Layout>