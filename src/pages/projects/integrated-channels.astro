---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Integrated Channels Suite | Digital Banking Platform | Manoj Pant">
<style is:global>
:root{
  --navy:#102f55;--navy-2:#163d6a;--navy-3:#214e7d;
  --ink:#102a4d;--ink-2:#365774;--muted:#627c97;--line:#d8e4ef;--line-2:#e8eff5;
  --bg:#f3f7fb;--paper:#fff;--blue:#2468d7;--blue-soft:#eaf2ff;
  --lav:#7658d9;--lav-soft:#f1edff;--mint:#17886f;--mint-soft:#e8f7f2;
  --amber:#be7615;--amber-soft:#fff2df;--rose:#bb3f76;--rose-soft:#fff0f6;
  --teal:#167d87;--teal-soft:#e9f7f8;--radius:16px;--max:1520px;--header-h:68px;
  --shadow:0 8px 24px rgba(22,52,82,.06);--sans:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--header-h) + 10px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:14px;line-height:1.4;overflow-x:hidden}
body.locked{overflow:hidden}
a{text-decoration:none;color:inherit}button,input{font:inherit}button{cursor:pointer}svg,img{max-width:100%;display:block}
.wrap{width:min(var(--max),calc(100% - 32px));margin:0 auto;height:100%;display:flex;flex-direction:column;justify-content:center}
.hidden{display:none!important}
#progress{position:fixed;top:0;left:0;height:3px;width:0;background:linear-gradient(90deg,var(--blue),var(--lav));z-index:300}

/* HEADER & 12-BUTTON NAV */
header{position:sticky;top:0;z-index:100;background:var(--navy);color:#fff;border-bottom:1px solid rgba(255,255,255,.12);box-shadow:0 4px 20px rgba(8,28,51,.2)}
.head{height:var(--header-h);display:flex;align-items:center;justify-content:space-between;gap:16px;max-width:100%!important;padding:0 20px}
.brand{display:flex;align-items:center;gap:10px;flex:none}
.brand-logo{width:36px;height:36px;border-radius:8px;background:#244f7f;display:flex;align-items:center;justify-content:center;font-weight:950;color:#fff;font-size:12px}
.brand-copy b{display:block;font-size:15px;line-height:1.1;color:#fff}
.brand-copy small{display:block;color:#c1d2e4;font-size:9.5px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}

#nav{display:flex;align-items:center;gap:4px;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none}
#nav::-webkit-scrollbar{display:none}
#nav a{padding:6px 9px;border-radius:6px;color:#d1e1f2;font-size:11px;font-weight:850;white-space:nowrap;transition:.15s ease}
#nav a:hover,#nav a.active{background:#234f7f;color:#fff}

.head-actions{display:flex;align-items:center;gap:8px;flex:none}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:7px 12px;border:1px solid rgba(255,255,255,.2);border-radius:8px;background:transparent;color:#fff;font-size:11.5px;font-weight:900;transition:.15s ease}
.btn:hover{background:rgba(255,255,255,.1)}
.btn.primary{background:#fff;color:var(--navy);border-color:#fff}
.btn.primary:hover{background:#f0f5fb}

/* STRICT SINGLE VIEWPORT SLIDE-PAGES */
.slide-page{height:calc(100vh - var(--header-h));min-height:600px;display:flex;flex-direction:column;justify-content:center;border-bottom:1px solid var(--line);position:relative;overflow:hidden;background:#fff}
.slide-page.alt{background:#f6f9fc}
.eyebrow{font-size:10.5px;line-height:1.1;color:var(--blue);font-weight:950;letter-spacing:.14em;text-transform:uppercase;margin-bottom:3px;display:block}
.section-head{margin-bottom:12px;flex:none}
.section-head h2{margin:0;font-size:26px;line-height:1.1;letter-spacing:-.02em;color:var(--ink);font-weight:950}
.section-head p{margin:4px 0 0;color:var(--ink-2);font-size:13px;line-height:1.35}

/* 1. OVERVIEW */
.hero-copy{display:grid;grid-template-columns:1.2fr .8fr;gap:24px;align-items:center}
.kicker{display:inline-flex;align-items:center;gap:8px;padding:5px 10px;border:1px solid #c8def7;border-radius:999px;background:var(--blue-soft);color:#17539c;font-size:10.5px;font-weight:950;letter-spacing:.08em;text-transform:uppercase}
.kicker-m2p{width:24px;height:24px;border-radius:6px;overflow:hidden;flex:none}
h1{font-size:clamp(36px, 3.8vw, 54px);line-height:1.02;letter-spacing:-.04em;margin:12px 0 10px;color:var(--ink);font-weight:950}
.lead{font-size:14.5px;line-height:1.4;color:#42627f;margin:0}
.lead strong{color:var(--ink);font-weight:900}
.hero-actions{display:flex;gap:8px;margin-top:14px}
.safe{margin:8px 0 0;color:#7087a0;font-size:10px;line-height:1.3}
.role-card{border:1px solid var(--line);border-radius:var(--radius);background:#fff;box-shadow:var(--shadow);padding:16px}
.role-top{display:flex;align-items:center;gap:10px}
.m2p-mark{width:40px;height:40px;flex:none}
.role-kicker{font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;color:#6d84a0;font-weight:950}
.role-top h2{margin:2px 0 0;font-size:20px;line-height:1.1;color:var(--ink)}
.role-list{display:grid;gap:6px;margin-top:10px}
.role-list>div{padding:8px 10px;border:1px solid var(--line);border-radius:10px;background:#fff}
.role-list>div:nth-child(1){background:var(--blue-soft)}.role-list>div:nth-child(2){background:var(--lav-soft)}.role-list>div:nth-child(3){background:var(--mint-soft)}.role-list>div:nth-child(4){background:var(--amber-soft)}
.role-list b{display:block;color:var(--ink);font-size:11.5px}
.role-list span{display:block;margin-top:2px;color:#54708d;font-size:10px;line-height:1.25}
.quick{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}
.stat{background:#fff;border:1px solid var(--line);border-top:3px solid var(--blue);border-radius:10px;padding:8px 10px}
.stat-purple{border-top-color:var(--lav)}.stat-mint{border-top-color:var(--mint)}.stat-rose{border-top-color:var(--rose)}
.stat strong{font-size:22px;line-height:1;color:var(--ink);letter-spacing:-.03em}
.stat span{margin-top:2px;font-size:9px;line-height:1.2;color:#607891;font-weight:800;display:block}

/* 2. ECOSYSTEM */
.ecosystem-panel{border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:var(--shadow);padding:10px;display:flex;flex-direction:column}
.eco-shell{border:1px solid #d9e5ef;border-radius:14px;background:#f8fbfd;display:flex;flex-direction:column;overflow:hidden}
.eco-topbar{height:30px;display:flex;align-items:center;justify-content:space-between;padding:0 12px;background:#fff;border-bottom:1px solid var(--line)}
.eco-dots{display:flex;gap:5px}.eco-dots i{width:7px;height:7px;border-radius:50%;background:#d2deea}
.eco-brand{display:flex;align-items:center;gap:6px;color:#566f89;font-size:8.5px;font-weight:950;letter-spacing:.1em;text-transform:uppercase}
.m2p-mini{width:18px;height:18px}.m2p-mini img{width:100%;height:100%}
.eco-stage{padding:12px 16px 8px;display:flex;flex-direction:column}
.eco-heading{text-align:center}
.eco-heading h2{margin:0;font-size:22px;line-height:1.1;letter-spacing:-.02em;color:var(--ink);font-weight:950}
.eco-heading h2 span{color:var(--blue)}
.eco-heading p{margin:4px auto 0;max-width:1100px;color:#365a79;font-size:11px;line-height:1.35}
.eco-board{position:relative;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-template-rows:repeat(5,46px);gap:6px;margin:10px auto 0;width:min(1200px,100%)}
.eco-lines{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:0}
.eco-core{z-index:2;grid-column:5/9;grid-row:2/5;align-self:center;justify-self:center;width:100%;height:100%;padding:8px;border:2px solid #b9cee4;border-radius:16px;background:#fff;box-shadow:0 10px 24px rgba(26,59,90,.08);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.core-logo{width:28px;height:28px;margin-bottom:4px}
.eco-core>b{font-size:16px;line-height:1.05;color:var(--ink);letter-spacing:-.02em}
.eco-core>span:last-child{margin-top:2px;font-size:9px;color:#607892}
.eco-node{z-index:3;display:flex;align-items:center;gap:6px;padding:4px 8px;border:1px solid #ccdbe8;border-left:4px solid var(--accent);border-radius:10px;background:var(--soft);box-shadow:0 3px 10px rgba(28,57,83,.04);color:var(--ink);height:100%;transition:.15s ease}
.eco-node:hover{transform:translateY(-1px);box-shadow:0 6px 14px rgba(28,57,83,.08)}
.eco-number{width:20px;height:20px;border-radius:6px;background:rgba(255,255,255,.9);display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:9.5px;font-weight:950;flex:none}
.eco-copy{min-width:0}
.eco-copy b{display:block;font-size:11px;line-height:1.1;white-space:nowrap}
.eco-copy span{display:block;font-size:8.5px;color:#627c97;white-space:nowrap}
.eco-footnote{text-align:center;margin-top:8px;font-size:9.5px;color:#56718d;font-weight:850}
.eco-12{grid-column:2/5;grid-row:1}.eco-01{grid-column:5/8;grid-row:1}.eco-02{grid-column:8/11;grid-row:1}
.eco-11{grid-column:1/4;grid-row:2}.eco-03{grid-column:10/13;grid-row:2}
.eco-10{grid-column:1/4;grid-row:3}.eco-04{grid-column:10/13;grid-row:3}
.eco-09{grid-column:1/4;grid-row:4}.eco-05{grid-column:10/13;grid-row:4}
.eco-08{grid-column:2/5;grid-row:5}.eco-07{grid-column:5/8;grid-row:5}.eco-06{grid-column:8/11;grid-row:5}

/* 3. CHALLENGE */
.story-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.story{border:1px solid var(--line);border-radius:var(--radius);padding:18px;background:var(--blue-soft);box-shadow:var(--shadow)}
.story:nth-child(2){background:var(--lav-soft)}
.story h3{font-size:19px;line-height:1.15;margin:4px 0 8px;color:var(--ink);letter-spacing:-.02em}
.story p{font-size:12.5px;line-height:1.4;color:#4f6d8a;margin:0}
.story ul{margin:8px 0 0;padding-left:16px;color:#506d89;font-size:12px;line-height:1.4}
.story li+li{margin-top:3px}
.story-flow{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}
.story-step{border:1px solid #d3dfeb;border-radius:10px;padding:10px;background:#fff}
.story-step b{display:block;color:var(--ink);font-size:11px}
.story-step span{display:block;margin-top:2px;color:#58728d;font-size:9.5px;line-height:1.25}
.challenge-response{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:12px}
.challenge-response>div{padding:12px;border:1px solid var(--line);border-radius:10px;background:#fff}
.challenge-response>div:nth-child(1){background:var(--blue-soft)}.challenge-response>div:nth-child(2){background:var(--mint-soft)}.challenge-response>div:nth-child(3){background:var(--rose-soft)}.challenge-response>div:nth-child(4){background:var(--amber-soft)}
.challenge-response b{display:block;color:var(--ink);font-size:12px}
.challenge-response span{display:block;margin-top:3px;color:#58718d;font-size:10.5px;line-height:1.3}

/* 4. STRATEGY */
.strategy{display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(2,1fr);gap:10px}
.strategy-card{border:1px solid var(--line);border-left:4px solid var(--tone);border-radius:12px;padding:14px;background:#fff;box-shadow:var(--shadow)}
.strategy-card:nth-child(1),.strategy-card:nth-child(5){background:var(--blue-soft)}.strategy-card:nth-child(2),.strategy-card:nth-child(6){background:var(--mint-soft)}.strategy-card:nth-child(3),.strategy-card:nth-child(7){background:var(--lav-soft)}.strategy-card:nth-child(4),.strategy-card:nth-child(8){background:var(--amber-soft)}
.strategy-card .num{font-size:18px;line-height:1;color:var(--blue);font-weight:950}
.strategy-card h3{margin:4px 0 4px;font-size:14.5px;line-height:1.1;color:var(--ink)}
.strategy-card p{margin:0;font-size:11.5px;line-height:1.35;color:#57718c}
.decision{margin-top:12px;border:1px solid var(--line);border-radius:12px;background:#fff;padding:12px}
.decision-title{display:block;font-size:11px;font-weight:950;color:var(--ink);letter-spacing:.1em}
.decision-row{display:grid;grid-template-columns:repeat(9,1fr);gap:5px;margin-top:6px}
.decision-step{padding:8px 4px;border:1px solid #cbdbea;border-radius:6px;background:var(--blue-soft);text-align:center;color:var(--ink);font-size:9.5px;font-weight:900}

/* 5. PM SCOPE */
.ownership{display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(2,1fr);gap:10px}
.own{border:1px solid var(--line);border-left:4px solid #9ab4cc;border-radius:12px;padding:14px;background:#fff;box-shadow:var(--shadow)}
.own:nth-child(1),.own:nth-child(5){background:var(--blue-soft)}.own:nth-child(2),.own:nth-child(6){background:var(--lav-soft)}.own:nth-child(3),.own:nth-child(7){background:var(--mint-soft)}.own:nth-child(4),.own:nth-child(8){background:var(--amber-soft)}
.pill{display:inline-flex;align-items:center;padding:3px 7px;border-radius:999px;background:#fff;border:1px solid #d5e1ec;color:#294d70;font-size:9.5px;font-weight:950}
.own h3{margin:6px 0 3px;font-size:14.5px;line-height:1.1;color:var(--ink)}
.own p{margin:0;color:#58718d;font-size:11px;line-height:1.3}
.own ul{margin:4px 0 0;padding-left:15px;color:#58718d;font-size:10.5px;line-height:1.3}
.scope-evidence{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:2px}
.scope-evidence-card{border:1px solid #cfdeea;border-radius:10px;background:#fff;padding:10px}
.scope-evidence-card b{display:block;font-size:14px;color:var(--blue);line-height:1}
.scope-evidence-card span{display:block;margin-top:2px;color:#5d7690;font-size:10px}

/* 6. ARCHITECTURE */
.arch-card{border:1px solid var(--line);border-radius:var(--radius);background:#fff;box-shadow:var(--shadow);padding:20px;height:100%;display:flex;flex-direction:column;justify-content:center}
.arch-map{display:grid;grid-template-columns:1fr 20px 2.2fr 20px 1fr;gap:10px;align-items:center}
.arch-column h4{margin:0 0 8px;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#607b97}
.arch-side{display:grid;gap:6px}
.mini-box{border:1px solid var(--line);border-radius:8px;background:#fbfdff;padding:9px;font-size:11px;line-height:1.2;color:#4f6b87;font-weight:850;text-align:center}
.arch-arrow{display:flex;align-items:center;justify-content:center;color:#8ba4bc;font-size:20px}
.arch-stack{display:grid;gap:6px}
.arch-layer{border:1px solid var(--line);border-left:4px solid var(--blue);border-radius:8px;background:var(--blue-soft);padding:10px 12px}
.arch-layer:nth-child(2){border-left-color:var(--lav);background:var(--lav-soft)}
.arch-layer:nth-child(3){border-left-color:var(--mint);background:var(--mint-soft)}
.arch-layer:nth-child(4){border-left-color:var(--amber);background:var(--amber-soft)}
.arch-layer:nth-child(5){border-left-color:var(--rose);background:var(--rose-soft)}
.arch-layer b{display:block;font-size:12px;color:var(--ink)}
.arch-layer span{display:block;margin-top:2px;font-size:10.5px;line-height:1.25;color:#58728d}
.arch-note{margin:10px 0 0;color:#71879f;font-size:10px;text-align:center}

.stack{display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(2,1fr);gap:10px;height:100%}
.stack-card{border:1px solid var(--line);border-top:4px solid #9eb7cf;border-radius:10px;padding:12px;background:#fff;display:flex;flex-direction:column;justify-content:center}
.stack-card:nth-child(2n){border-top-color:#9a86e8;background:var(--lav-soft)}
.stack-card:nth-child(3n){border-top-color:#75c8af;background:var(--mint-soft)}
.stack-card:nth-child(4n){border-top-color:#e1b16d;background:var(--amber-soft)}
.stack-card h3{margin:0 0 6px;font-size:13.5px;color:var(--ink)}
.chips{display:flex;flex-wrap:wrap;gap:5px}
.chip{padding:4px 8px;border:1px solid #d5e1eb;border-radius:5px;background:rgba(255,255,255,.9);font-size:10px;font-weight:850;color:#4e6985}

/* 7. DELIVERY (Operating Model 3x2 layout) */
.timeline{display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(2,1fr);gap:12px;height:100%}
.time{border:1px solid var(--line);border-radius:var(--radius);background:#fff;padding:16px;box-shadow:var(--shadow);display:flex;flex-direction:column;justify-content:center}
.time:nth-child(2),.time:nth-child(4){background:var(--blue-soft);border-top:4px solid var(--blue)}
.time>b{font-size:10px;color:var(--blue);font-weight:950}
.time h3{margin:6px 0 4px;font-size:16px;line-height:1.1;color:var(--ink)}
.time p{margin:0;font-size:12px;line-height:1.35;color:#58718d}
.time ul{margin:6px 0 0;padding-left:16px;font-size:11.5px;line-height:1.35;color:#58718d}

.implementation{display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(2,1fr);gap:10px;height:100%}
.impl{border:1px solid var(--line);border-left:4px solid #9bb4ce;border-radius:12px;background:#fff;padding:14px;display:flex;flex-direction:column;justify-content:center}
.impl:nth-child(2n){background:var(--lav-soft);border-left-color:var(--lav)}.impl:nth-child(3n){background:var(--mint-soft);border-left-color:var(--mint)}.impl:nth-child(4n){background:var(--amber-soft);border-left-color:var(--amber)}
.impl .pill{font-size:9.5px;margin-bottom:3px}
.impl h3{margin:3px 0 4px;font-size:14.5px;color:var(--ink)}
.impl p{margin:0;font-size:11px;line-height:1.3;color:#58718d}
.impl ul{margin:4px 0 0;padding-left:14px;font-size:10.5px;line-height:1.3;color:#58718d}

/* 8. PRODUCT EXPLORER (6 projects per slide) */
.app-grid{display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(2,1fr);gap:12px;height:100%}
.app-card{position:relative;display:flex;flex-direction:column;justify-content:center;padding:16px;border:1px solid var(--line);border-left:5px solid var(--app);border-radius:12px;background:#fff;box-shadow:var(--shadow);color:var(--ink);transition:.15s ease;text-align:left}
.app-card:hover{transform:translateY(-1px);box-shadow:0 10px 20px rgba(16,45,82,.1)}
.app-top{display:grid;grid-template-columns:28px 1fr 16px;gap:8px;align-items:center}
.app-index{width:28px;height:24px;display:flex;align-items:center;justify-content:center;border-radius:6px;background:#eef3f7;font-size:10.5px;font-weight:950;color:var(--ink)}
.app-domain{font-size:10px;line-height:1.1;letter-spacing:.08em;text-transform:uppercase;color:var(--blue);font-weight:900;background:var(--blue-soft);padding:3px 6px;border-radius:4px;display:inline-block;width:fit-content}
.app-go{text-align:right;font-size:14px;color:#7690aa}
.app-card h3{font-size:18px;line-height:1.1;letter-spacing:-.02em;margin:8px 0 4px;color:var(--ink);font-weight:950}
.app-card p{font-size:12px;line-height:1.35;color:#57708b;margin:0}
.mini-tags{display:flex;flex-wrap:wrap;gap:4px;margin-top:8px}
.mini-tags span{display:inline-flex;padding:3px 7px;border:1px solid #d7e2ec;border-radius:6px;background:#f4f8fb;color:#4f6884;font-size:9.5px;font-weight:850}
.app-foot{display:flex;justify-content:space-between;align-items:center;margin-top:8px;padding-top:8px;border-top:1px solid var(--line-2);font-size:9.5px;color:#698098}
.app-foot b{color:var(--blue)}

/* 9. IMPACT */
.impact-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.impact-card{border:1px solid var(--line);border-top:4px solid var(--blue);border-radius:12px;background:#fff;padding:14px;box-shadow:var(--shadow)}
.impact-purple{border-top-color:var(--lav)}.impact-mint{border-top-color:var(--mint)}.impact-rose{border-top-color:var(--rose)}
.impact-card strong{font-size:28px;line-height:1;color:var(--ink);letter-spacing:-.03em}
.impact-card b{display:block;margin-top:4px;font-size:12.5px;color:var(--ink)}
.impact-card span{display:block;margin-top:3px;font-size:11px;color:#607993;text-align:justify}
.outcome-grid{display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(2,1fr);gap:10px;margin-top:10px;height:calc(100% - 130px)}
.outcome-card{border:1px solid var(--line);border-radius:12px;background:#fff;padding:14px;display:flex;flex-direction:column;justify-content:center}
