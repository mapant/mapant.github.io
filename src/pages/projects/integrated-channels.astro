const sections=[...document.querySelectorAll('main section[id]')],links=[...document.querySelectorAll('nav a[href^="#"]')];
function updateActiveNav(){
 const marker=window.scrollY+60;
 let current=sections[0]?.id||'overview';
 for(const s of sections){if(s.offsetTop<=marker)current=s.id;else break;}
 links.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+current));
}
window.addEventListener('scroll',updateActiveNav,{passive:true});
window.addEventListener('resize',updateActiveNav);
updateActiveNav();
window.addEventListener('scroll',()=>{const h=document.documentElement,max=h.scrollHeight-h.clientHeight;document.getElementById('progress').style.width=(max>0?(h.scrollTop/max)*100:0)+'%'},{passive:true});
function handleHash(){
 if(location.hash.startsWith('#app/')){openApp(location.hash.slice(5),false);return}
 const id=location.hash.slice(1);
 if(id&&document.getElementById(id)){const t=document.getElementById(id);window.scrollTo({top:t.offsetTop-60,behavior:'smooth'});}
}
window.addEventListener('popstate',handleHash);window.addEventListener('hashchange',handleHash);handleHash();
