---
interface Props { name: string; id: string; refined?: boolean; }
const { name, id, refined = false } = Astro.props;
const paint = (color: string) => `url(#${id}-${color})`;
---
<svg class="portfolio-illustration-svg" viewBox={refined ? "-4 -4 188 148" : "0 0 180 130"} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-blue`} x2="1" y2="1"><stop stop-color="#9de5ff"/><stop offset="1" stop-color="#087fff"/></linearGradient>
    <linearGradient id={`${id}-purple`} x2="1" y2="1"><stop stop-color="#d7b5ff"/><stop offset="1" stop-color="#7928f3"/></linearGradient>
    <linearGradient id={`${id}-green`} x2="1" y2="1"><stop stop-color="#7cf4db"/><stop offset="1" stop-color="#00a58a"/></linearGradient>
    <linearGradient id={`${id}-amber`} x2="1" y2="1"><stop stop-color="#ffe5a0"/><stop offset="1" stop-color="#ff9200"/></linearGradient>
    <linearGradient id={`${id}-navy`} x2="1" y2="1"><stop stop-color="#123f76"/><stop offset="1" stop-color="#05264c"/></linearGradient>
    {refined && <marker id={`${id}-arrow`} viewBox="0 0 7 7" markerUnits="userSpaceOnUse" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0 0 7 3.5 0 7" fill="none" stroke="#168cff" stroke-width="1.5"/></marker>}
  </defs>
  {name === 'business' && <g fill={paint('blue')}>
    {[24,45,70,100].map((height,i)=><rect x={25+i*32} y={120-height} width="23" height={height} rx="3"/>)}
    <path d="M20 123h142" stroke="#9bccf3" stroke-width={refined ? 2.6 : 2}/>
  </g>}
  {name === 'workflow' && <g stroke-linejoin="round">
    {refined ? <g fill="none" stroke="#168cff" stroke-width="2.6" stroke-dasharray="4 3" marker-end={`url(#${id}-arrow)`}>
      <path d="M70 26.5H42V53"/>
      <path d="M42 93V110H90V103H101"/>
      <path d="M156 103H167V26.5H123"/>
    </g> : <g>
    <path d="M72 34H44V65m0 24v24h76V89m19-35h21v53h-22M110 21h44v12" fill="none" stroke="#168cff" stroke-width={refined ? 2.6 : 2} stroke-dasharray="4 3"/>
    <path d="m39 60 5 5 5-5m67 48 5 5-5 5m33-90 5 5 5-5" fill="none" stroke="#168cff" stroke-width={refined ? 2.6 : 2}/>
    </g>}
    <rect x="70" y="7" width="53" height="39" rx="7" fill={paint('blue')}/><rect x="14" y="53" width="56" height="40" rx="7" fill={paint('purple')}/><rect x="101" y="83" width="55" height="40" rx="7" fill={paint('blue')}/>
    <path d="M72 16h47M18 62h48m39 29h47" stroke="#fff" opacity=".65"/>
  </g>}
  {name === 'integration' && <g>
    <path d={refined ? "M87 49V57H56V63M87 57H140V73M85 104H92V111H100" : "M53 52v31h70V51m-35 7v42"} fill="none" stroke="#6881ff" stroke-width={refined ? 2.6 : 2} stroke-dasharray="4 3"/>
    <path d="M69 46C39 43 52 16 66 20 67-7 111-2 116 22c27-4 32 27 3 28z" fill={paint('blue')}/>
    {[refined ? 16 : 20,refined ? 100 : 108].map((x,i)=><g transform={`translate(${x} ${i ? (refined ? 85 : 78) : (refined ? 75 : 66)})`}><path d="m0 0 40-12 29 13v43l-40 13L0 44z" fill={paint('purple')}/><path d="m0 0 29 13 40-12M29 13v44M1 16l28 13 39-12M1 31l28 13 39-12" fill="none" stroke="#e6d7ff" stroke-width={refined ? 2.6 : 2}/>{[10,25,40].map(y=><circle cx="12" cy={y} r="2" fill="#fff"/>)}</g>)}
  </g>}
  {name === 'decision' && <g>
    <rect x="24" y="8" width="113" height="112" rx="16" fill="#fff0ce"/>
    {[29,58,87].map(y=><g><rect x="39" y={y} width="14" height="14" rx="3" fill="#ff9a00"/><path d={`m42 ${y+7} 3 3 5-6`} fill="none" stroke="#fff" stroke-width={refined ? 2.6 : 2}/><rect x="62" y={y+3} width="55" height="7" rx="3" fill={paint('amber')}/></g>)}
    <circle cx="143" cy="59" r="24" fill="#ff9400" stroke="#fff" stroke-width="3"/><circle cx="143" cy="51" r="6" fill="#fff"/><path d="M132 72v-5c0-10 22-10 22 0v5" fill="#fff"/>
  </g>}
  {name === 'automation' && <g>
    <path d={refined ? "M70 34A43 43 0 0 1 143 45M144 73A43 43 0 0 1 86 101" : "M65 32a43 43 0 0 1 72 5m7 22a43 43 0 0 1-54 43"} fill="none" stroke={paint('blue')} stroke-width="10"/><path d={refined ? "M132 41 146 48 145 32ZM94 91 82 102 99 108Z" : "m133 21 7 23-23-3m-28 48-7 19 23 3"} fill="#188cff"/>
    <g transform="translate(50 4)" fill="#168aff"><path d="m38 38 4-7 7 3 5-5 7 4-1 8 6 4-2 8-8 1-3 7-8-1-3-7-7-1-2-8z"/><circle cx="51" cy="45" r="9" fill="#e9f8ff"/></g>
    <rect x="20" y="78" width="61" height="43" rx="13" fill={paint('blue')}/><path d="M50 68v10" stroke="#238aff" stroke-width="3"/><circle cx="50" cy="67" r="4" fill="#69ccff"/><rect x="29" y="86" width="43" height="25" rx="9" fill="#9ce4ff"/><circle cx="40" cy="96" r="3" fill="#fff"/><circle cx="60" cy="96" r="3" fill="#fff"/><path d="M42 104h16" stroke="#fff" stroke-width={refined ? 2.6 : 2}/>
  </g>}
  {name === 'data' && <g>
    <path d="M32 28v70c0 26 91 26 91 0V28" fill={paint('purple')}/><ellipse cx="77" cy="28" rx="45" ry="16" fill="#d6bcff"/><path d="M32 52c0 25 91 25 91 0M32 77c0 25 91 25 91 0" fill="none" stroke="#f0e5ff" stroke-width="4"/>
    <rect x="96" y="60" width="65" height="64" rx="13" fill="#e5eaff"/>{[34,47,58].map((h,i)=><rect x={105+i*16} y={121-h} width="11" height={h} rx="4" fill={paint(i===1?'purple':'blue')}/>)}
  </g>}
  {name === 'alignment' && <g fill={paint('amber')}>
    <path d="M75 33a29 29 0 1 0 3 24" fill="none" stroke="#ffac16" stroke-width="6"/><circle cx="54" cy="47" r="16" fill="none" stroke="#ffb62b" stroke-width="5"/><path d="m54 47 33-31m-1-9 1 9 10 2" fill="none" stroke="#ff9d00" stroke-width="7"/>
    {[19,40,61].map((x,i)=><g><circle cx={x} cy={88-(i%2)*7} r="9"/><path d={`M${x-10} 121v-19c0-15 20-15 20 0v19z`}/></g>)}
    {[39,63,87].map((h,i)=><rect x={94+i*24} y={124-h} width="17" height={h} rx="2"/>)}<path d="m97 62 28-24 12 8 26-31m-14 1h15v15" fill="none" stroke="#ffb21c" stroke-width="6"/>
  </g>}
  {name === 'discover' && <g>
    <rect x="32" y="40" width="113" height="83" rx="8" fill="#dcf1ff"/>{[60,77,94,111].map(y=><path d={`M47 ${y}h68`} stroke="#a1d2ff" stroke-width="5"/>)}
    <path d="M78 7h74v49h-43L94 70V56H78z" fill={paint('blue')}/><path d="M91 20h49m-49 12h37m-37 12h24" stroke="#fff" stroke-width="3"/>
    <path d="M5 46h60v40H23L6 99z" fill="#91cdff"/>{[19,34,49].map(x=><g><circle cx={x} cy="59" r="3" fill="#128cff"/><circle cx={x} cy="72" r="3" fill="#128cff"/></g>)}
  </g>}
  {name === 'requirements' && <g>
    <rect x="31" y="17" width="100" height="109" rx="8" fill="#e4d3ff"/><rect x="49" y="5" width="98" height="112" rx="9" fill="#faf6ff" stroke="#b390ff"/>
    {[25,53,81].map(y=><g><rect x="61" y={y} width="16" height="16" rx="4" fill="#b68cff"/><path d={`m64 ${y+8} 3 3 7-8`} fill="none" stroke="#fff" stroke-width={refined ? 2.6 : 2}/><path d={`M87 ${y+4}h45m-45 8h31`} stroke="#c2a1ff" stroke-width="4"/></g>)}
    <path d="m127 111 24-70 13 5-24 70-17 9z" fill={paint('purple')}/>
  </g>}
  {name === 'design' && <g>
    <rect x="9" y="24" width="113" height="83" rx="7" fill="#f3fbff" stroke="#9dd5ef"/><path d="M10 32q0-8 8-8h96q8 0 8 8v8H10z" fill={paint('blue')}/><path d="M22 53h80m-80 11h40m-40 11h56m-56 11h38" stroke="#b9d6e7" stroke-width="5"/>
    <rect x="80" y="43" width="82" height="76" rx="7" fill="#f6fffc" stroke="#9fdfcd"/><path d="M81 50q0-7 7-7h67q7 0 7 7v9H81z" fill={paint('green')}/><path d="M91 72h58m-58 12h38m-38 12h52" stroke="#b6e8dc" stroke-width="5"/>
    <rect x="138" y="71" width="29" height="57" rx="5" fill="#fff" stroke="#5dcebd"/><path d="M144 83h17m-17 10h17m-17 10h17" stroke="#a5e6db" stroke-width="3"/>
  </g>}
  {name === 'architecture' && <g>
    <path d={refined ? "M88 40V68M33 68H143M33 68V92M88 68V92M143 68V92" : "M90 38v35M34 73h113M34 73v23m113-23v23M90 73v23"} fill="none" stroke="#64aaff" stroke-width={refined ? 2.6 : 2} stroke-dasharray="4 3"/>
    <path d="M69 40c-25-1-23-24-5-24C69-5 106 0 109 17c24-3 30 26 5 26z" fill={paint('blue')}/>
    {[15,70,125].map((x,i)=><g transform={`translate(${x} 83)`}><path d="M0 9v28c0 13 37 13 37 0V9" fill={paint(i===1?'blue':'purple')}/><ellipse cx="18" cy="9" rx="18" ry="7" fill="#c9e9ff"/><path d="M0 23c0 13 37 13 37 0" fill="none" stroke="#e6f7ff" stroke-width={refined ? 2.6 : 2}/></g>)}
  </g>}
  {name === 'ai' && <g>
    <path d={refined ? "M42 64H59M130 64H137M78 12V26M110 12V26M78 103V118M110 103V118" : "M37 40h108v54H37M64 12v100m49-100v100"} fill="none" stroke="#99bcff" stroke-width="3" stroke-dasharray="4 3"/>
    <rect x="59" y="26" width="71" height="77" rx="15" fill={paint('blue')}/><rect x="72" y="39" width="45" height="50" rx="8" fill="#e5edff"/><text x="94" y="74" text-anchor="middle" font-family="Segoe UI,Arial" font-size="30" font-weight="800" fill="#4364e5">AI</text>
    {[12,137].map(x=><g><rect x={x} y="54" width="30" height="38" rx="5" fill={paint('blue')}/><path d={`M${x+6} 65h18m-18 7h18m-18 7h11`} stroke="#fff" stroke-width={refined ? 2.6 : 2}/></g>)}
  </g>}
  {name === 'delivery' && <g>
    <rect x="9" y="12" width="163" height="108" rx="8" fill="#eff6ff" stroke="#b7d4f8"/>{['blue','purple','green'].map((color,i)=><g><rect x={16+i*52} y="18" width="46" height="18" rx="4" fill={paint(color)}/>{[44,68,92].map(y=><g><rect x={16+i*52} y={y} width="46" height="18" rx="3" fill="#fff"/><rect x={20+i*52} y={y+4} width="9" height="9" rx="2" fill={paint(color)}/><path d={`M${34+i*52} ${y+6}h21m-21 6h15`} stroke="#b5c9e1" stroke-width={refined ? 2.6 : 2}/></g>)}</g>)}
  </g>}
  {name === 'adoption' && <g>
    {[33,55,78].map((h,i)=><rect x={74+i*27} y={124-h} width="18" height={h} rx="4" fill={paint('green')}/>)}<path d="m65 57 32-26 13 5 36-30m-17 0h18v18" fill="none" stroke="#00bc99" stroke-width="6"/>
    {[21,45].map((x,i)=><g><circle cx={x} cy={83-i*9} r="11" fill={paint('green')}/><path d={`M${x-14} 125v-20c0-17 28-17 28 0v20`} fill={paint('green')}/></g>)}
  </g>}
  {['banking','docconnect','sales','telecom'].includes(name) && <g>
    <path d="M8 20 144 8l21 99L27 124z" fill={paint(name==='docconnect'?'green':name==='sales'?'purple':'blue')} opacity=".45"/>
    <rect x="17" y="21" width="134" height="94" rx="8" fill="#f1faff" stroke="#8ccfff" stroke-width="3"/><path d="M20 26h127v17H20z" fill={paint(name==='sales'?'purple':name==='docconnect'?'green':'blue')}/>
    <rect x="24" y="49" width="22" height="60" rx="3" fill="#d6ecff"/>{[57,71,85,99].map(y=><path d={`M29 ${y}h12`} stroke="#7cb9f5" stroke-width="3"/>)}
    {name==='telecom' ? <g fill="#148dff" stroke="#4ab5ff"><path d="m61 82 29-21 27 29 22-35M61 82l17 17 39-9m-27-29 14-13 35 7" fill="none" stroke-width={refined ? 2.6 : 2}/>{[[61,82],[90,61],[117,90],[139,55],[78,99],[104,48]].map(([x,y])=><circle cx={x} cy={y} r="5"/>)}</g> : <g>
      {[56,81,106].map((x,i)=><rect x={x} y="50" width="20" height="14" rx="3" fill={paint(i===1?'green':'blue')}/>)}
      {[77,88,99].map(y=><path d={`M56 ${y}h72`} stroke="#afd3ed" stroke-width="4"/>)}
    </g>}
    {name==='docconnect' && <g><rect x="116" y="41" width="45" height="86" rx="8" fill="#fff" stroke="#2ab5a0" stroke-width="3"/><circle cx="139" cy="69" r="12" fill="#c7f1e7"/><path d="M126 100v-6c0-17 26-17 26 0v6z" fill="#1fbea3"/><path d="M125 111h27m-21 8h15" stroke="#c1e6df" stroke-width="3"/></g>}
    {name==='sales' && <g><path d="m65 103 16-28 17 11 29-36m-11 0h12v12" fill="none" stroke="#8338e5" stroke-width="4"/><circle cx="128" cy="50" r="9" fill="#00c2a1"/></g>}
  </g>}
</svg>
<style>
  .portfolio-illustration-svg { display: block; width: 100%; height: 100%; overflow: visible; }
</style>
