---
import PortfolioDiagram from '../PortfolioDiagram.astro';
import PortfolioIllustration from '../PortfolioIllustration.astro';
import PortfolioIcon from '../PortfolioIcon.astro';
import { scopeCards } from '../../data/portfolio.js';
---
<section class="slide page scope-page" id="scope" aria-labelledby="scope-title">
  <div class="page-inner scope-layout">
    <article class="dark-story scope-story">
      <div class="eyebrow amber-line">PM SCOPE</div>
      <h2 id="scope-title"><span>Product management</span> <span>across strategy,</span> <em>systems and execution.</em></h2>
      <p>End-to-end ownership from problem discovery and requirements to solution design, build, deployment and continuous improvement, across multiple stakeholders, systems and regulated environments.</p>
      <div class="scope-principles"><span><PortfolioIcon name="users" /> <b>Business &amp; Customer</b><small>Needs &amp; Outcomes</small></span><span><PortfolioIcon name="target" /> <b>Strategy &amp; Planning</b><small>Vision &amp; Roadmap</small></span></div>
      <div class="scope-cycle"><PortfolioDiagram kind="lifecycle" /></div>
      <div class="scope-principles bottom"><span><PortfolioIcon name="users" /> <b>Cross-functional</b><small>Collaboration</small></span><span><PortfolioIcon name="shield" /> <b>Regulated &amp;</b><small>Compliant Delivery</small></span><span><PortfolioIcon name="chart" /> <b>Data-Driven</b><small>Decisions</small></span><span><PortfolioIcon name="refresh" /> <b>Continuous</b><small>Improvement</small></span></div>
      <div class="story-caption">FROM IDEAS AND REQUIREMENTS TO REAL-WORLD IMPACT</div>
    </article>
    <div class="scope-cards">
      {scopeCards.map((card, i) => <article class:list={['scope-card', `tone-${['blue','purple','green','amber','pink','blue','purple','green'][i]}`]}><div class="scope-card-head"><b>{card.n}</b><div><h3>{card.title}</h3><p>{card.description}</p></div><small>{card.eyebrow}</small></div><div class="scope-card-art" aria-hidden="true"><PortfolioIllustration name={['discover','requirements','design','architecture','automation','ai','delivery','adoption'][i]} id={`scope-${i}`} refined /></div><ul>{card.items.map((item) => <li>{item}</li>)}</ul><div class="scope-output"><span><PortfolioIcon name={['bulb','document','palette','gear','gear','brain','rocket','chart'][i]} /></span><div><b>KEY OUTPUTS:</b><small>{card.output}</small></div></div></article>)}
    </div>
  </div>
</section>

<style>
.scope-cycle { border:0; background:none; box-shadow:none; }
.scope-card-art { width:29%; height:6cqw; }
.scope-card-art :global(svg) { display:block; width:100%; height:100%; }

@media screen and (min-width:1280px) {

#scope .dark-story { padding:min(1.9cqw,3.3cqh); border-radius:1.35cqw; background:linear-gradient(145deg,#062a52 0%,#0b4381 64%,#5130db 100%); }
#scope .dark-story .eyebrow { font-size:min(.9cqw,1.9cqh); letter-spacing:.13em; }
#scope .dark-story h2 { margin:1cqh 0 1.5cqh; font-size:min(2.45cqw,5.2cqh); line-height:1.08; letter-spacing:-.045em; }
#scope .dark-story > p { margin:0 0 1cqh; font-size:min(1.03cqw,2.15cqh); line-height:1.42; }
#scope .dark-story .check-list { grid-template-columns:minmax(0,1fr); gap:.65cqh; margin:.7cqh 0; }
#scope .dark-story .check-list li { gap:.65cqw; font-size:min(.89cqw,1.9cqh); line-height:1.25; }
#scope .dark-story .check-list li::before { width:1.4cqw; height:1.4cqw; font-size:.95cqw; }
#scope .story-caption { flex:none; margin-top:0; padding-top:1.4cqh; font-size:min(.72cqw,1.55cqh); line-height:1.35; }

#scope .scope-layout { grid-template-columns:minmax(0,35.7fr) minmax(0,64.3fr); gap:1.45cqw; }
#scope .scope-story h2 { font-size:min(2.45cqw,5.2cqh); }
#scope .scope-story h2 > span, #scope .scope-story h2 > em { display:block; }
#scope .scope-principles { gap:1cqw; margin:.7cqh 0; }
#scope .scope-principles span { grid-template-columns:2.7cqw 1fr; font-size:2cqw; }
#scope .scope-principles b { font-size:.76cqw; }
#scope .scope-principles small { font-size:.75cqw; }
#scope .scope-cycle { display:block; flex:1; min-height:0; margin:.3cqh 0; border:0; border-radius:0; background:none; }
#scope .scope-principles.bottom { margin:.4cqh 0 1cqh; padding:1cqh 0; }
#scope .scope-principles.bottom span { grid-template-columns:1fr; font-size:1.85cqw; }
#scope .scope-principles.bottom b { font-size:.71cqw; margin-top:.2cqh; }
#scope .scope-principles.bottom small { font-size:.7cqw; }
#scope .scope-cards { grid-template:repeat(4,minmax(0,1fr))/repeat(2,minmax(0,1fr)); gap:.8cqw 1.2cqw; }
#scope .scope-card { position:relative; display:flex; flex-direction:column; gap:0; padding:.6cqw; border-radius:1cqw; }
#scope .scope-card-head { display:grid; grid-template-columns:3.2cqw minmax(0,1fr); gap:.4cqw; }
#scope .scope-card-head > div { display:block; padding-right:0; }
#scope .scope-card-head > b { grid-column:1; grid-row:1; width:2.8cqw; height:2.8cqw; border-radius:.7cqw; font-size:1.15cqw; }
#scope .scope-card-head h3 { padding:0; margin:0 0 .3cqh; font-size:1.02cqw; line-height:1.12; }
#scope .scope-card-head p { width:73%; margin:0; color:#3d628a; font-size:.72cqw; line-height:1.18; }
#scope .scope-card-head > small { position:absolute; top:.7cqw; right:.7cqw; max-width:48%; font-size:.62cqw; line-height:1.1; letter-spacing:.075em; }
#scope .scope-card ul { display:grid; grid-template-columns:minmax(0,1fr); gap:.15cqh; width:71%; padding:0 0 0 .8cqw; margin:.5cqh 0 .4cqh; }
#scope .scope-card li { font-size:.71cqw; line-height:1.15; }
#scope .scope-card li::marker { color:var(--tone); }
#scope .scope-card-art { position:absolute; right:3%; top:21%; width:29%; height:51%; margin:0; float:none; }
#scope .scope-output { display:flex; margin-top:auto; min-height:2.5cqw; padding:.25cqw .45cqw; gap:.6cqw; border-radius:.7cqw; }
#scope .scope-output > span { display:grid; place-items:center; flex:none; width:2.1cqw; height:2.1cqw; border-radius:50%; background:#ffffffc9; color:var(--tone); font-size:1.5cqw; }
#scope .scope-output > div { display:block; line-height:1.12; }
#scope .scope-output b { font-size:.61cqw; }
#scope .scope-output b::after { content:" "; white-space:pre; }
#scope .scope-output small { display:inline; font-size:.67cqw; line-height:1.13; }


#scope .scope-card-head p, #scope .scope-card li, #scope .scope-output small { color:#304b6c; }
#scope .scope-output :global(svg) { stroke-width:2.35; }

}
</style>
