---
import PortfolioIllustration from '../PortfolioIllustration.astro';
import PortfolioIcon from '../PortfolioIcon.astro';
import { expertise } from '../../data/portfolio.js';
---
<section class="slide page overview-page" id="overview" aria-labelledby="overview-title">
  <div class="page-inner overview-layout">
    <div class="overview-copy">
      <div class="eyebrow"><i></i> PRODUCT STRATEGY · AI &amp; GENAI · ENTERPRISE PLATFORMS</div>
      <h1 id="overview-title">Building products<br/>from <em>complex problems</em><br/><em>to measurable impact.</em></h1>
      <p class="overview-lead">Senior Product Manager with <strong>10+ years of experience</strong> across FinTech, Healthcare, Telecom and Enterprise IT — combining product strategy, business analysis, technology, data and execution to build scalable enterprise products.</p>
      <div class="overview-stats">
        <article class="stat stat-blue"><span class="icon"><PortfolioIcon name="shield" /></span><strong>10+</strong><small>YEARS EXPERIENCE</small></article>
        <article class="stat stat-green"><span class="icon"><PortfolioIcon name="building" /></span><strong>12+</strong><small>ENTERPRISE APPLICATIONS</small></article>
        <article class="stat stat-amber"><span class="icon"><PortfolioIcon name="network" /></span><strong>4</strong><small>INDUSTRY ECOSYSTEMS</small></article>
        <article class="stat stat-purple"><span class="icon"><PortfolioIcon name="chart" /></span><strong>0 → 1</strong><small>PRODUCT DEVELOPMENT</small></article>
      </div>
      <h2 class="mini-heading">CORE EXPERTISE</h2>
      <div class="expertise-grid">
        {expertise.map(([title, text], i) => <article class:list={['expertise-card', `tone-${i + 1}`]}><span class="expertise-icon"><PortfolioIcon name={['analytics', 'document', 'gear', 'gear', 'bulb', 'network'][i]} /></span><strong>{title}</strong><span>{text}</span></article>)}
      </div>
    </div>
    <div class="operating-model">
      <div class="model-heading"><span class="cube-icon"><PortfolioIcon name="cube" /></span><strong>PRODUCT OPERATING MODEL</strong><small>PROBLEM&nbsp; → &nbsp;PRODUCT&nbsp; → &nbsp;OUTCOME</small></div>
      <div class="model-stage">
        <svg class="model-connectors" viewBox="0 0 600 560" preserveAspectRatio="none" aria-hidden="true"><path d="M145 105L270 245M455 105L330 245M145 440L270 315M455 440L330 315"/><circle cx="145" cy="105" r="5"/><circle cx="455" cy="105" r="5"/><circle cx="145" cy="440" r="5"/><circle cx="455" cy="440" r="5"/></svg>
        <article class="model-card model-business"><span><PortfolioIcon name="building" /></span><div><strong>Business</strong><small>FinTech | Health Tech | Telecom</small></div><i class="bars model-requirement-art"><PortfolioIllustration name="business" id="overview-business" /></i></article>
        <article class="model-card model-ai"><span><PortfolioIcon name="chip" /></span><div><strong>AI &amp; GenAI</strong><small>AI Strategy | Copilot | LLMs</small></div><i class="brain-art model-requirement-art"><PortfolioIcon name="brain" /></i></article>
        <article class="model-card model-auto"><span><PortfolioIcon name="gear" /></span><div><strong>Automation</strong><small>API-First | Microservices | Cloud</small></div><i class="cloud-art model-requirement-art"><PortfolioIcon name="cloud" /></i></article>
        <article class="model-card model-data"><span><PortfolioIcon name="database" /></span><div><strong>Data</strong><small>SQL | Power BI | KPI Frameworks</small></div><i class="bars model-requirement-art"><PortfolioIcon name="chart" /></i></article>
        <div class="model-product"><span class="cube-icon"><PortfolioIcon name="cube" /></span><strong>Product</strong><small>Manoj Pant – Technical<br/>Product Manager</small></div>
      </div>
      <div class="operating-steps"><div><b><PortfolioIcon name="target" /> &nbsp; STRATEGY</b><small>Vision · Priorities · Roadmap</small></div><div><b><PortfolioIcon name="gear" /> &nbsp; DELIVERY</b><small>Build · Integrate · Deploy</small></div><div><b><PortfolioIcon name="chart" /> &nbsp; ADOPTION &amp; OUTCOMES</b><small>Scale · Measure · Impact</small></div></div>
    </div>
  </div>
</section>

<style>
.model-requirement-art { display:grid; place-items:center; width:20%; height:60%; background:none; clip-path:none; font-size:3em; opacity:.55; }
.expertise-card.tone-1 .expertise-icon, .expertise-card.tone-4 .expertise-icon { color:#087ff0; background:#e5f2ff; }
.expertise-card.tone-3 .expertise-icon { color:#842df4; background:#eee8ff; }
</style>
