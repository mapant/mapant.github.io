---
import ProjectShell from './ProjectShell.astro';
import NokiaReferenceSections from './NokiaReferenceSections.astro';
import Panel from './NokiaPanel.astro';
import NokiaIcon from './NokiaIcon.astro';
import Visual from './NokiaVisual.astro';
import Chart from './NokiaChart.astro';
import '../styles/page-view.scss';
import '../styles/nokia-analytics-case-study.scss';
import '../styles/nokia-pdf-reference.scss';
const navSections: [string,string][] = [['overview','Overview'],['ecosystem','Ecosystem'],['challenge','Challenge'],['strategy','Strategy'],['pm-scope','PM Scope'],['product-metrics','Product Metrics'],['portfolio','Portfolio'],['tech-data','Tech & Data'],['outcomes','Outcomes'],['product-leadership','Product Leadership']];
const previous={title:'Ayu Sales Intelligence & Field Force Optimization',href:'/projects/ayu-sales-intelligence/'};
const next={title:'Integrated Channels Suite',href:'/projects/integrated-channels/'};
const tones=['blue','orange','green','violet','pink','green'];
const values=[["chart","Standardised Metrics","Common KPI definitions across markets."],["refresh","Automated Reporting","Repeatable processing reduces consolidation."],["eye","Operational Visibility","Clearer milestones, risks and status."],["bulb","Decision Support","Trusted information for management reviews."]];
const sources=[["antenna","Network & Infrastructure Delivery","Rollout plans, milestone updates and site information"],["document","Order Management & Procurement","Material requirements, purchase orders and vendor information"],["cube","Logistics & Inventory","Warehouse movements, delivery status and equipment availability"],["gear","Engineering & Delivery Capacity","Project resources, work packages and subcontractor delivery"],["document","Regional Reporting Inputs","Market-specific trackers and operational data maintained by local teams"]];
const model=[["database","Data Integration","Bring structured and semi-structured inputs into a common analytical environment."],["share","Harmonised Business Definitions","Standardise regional terminology, KPI definitions and reference values."],["chart","Consistent KPI Logic","Apply agreed calculation rules across all participating markets."],["layers","Reporting Layer","Expose trusted information through Power BI, Tableau and enterprise reporting views."]];
const users=[["users","Regional PMOs","View delivery performance, manage pipeline execution and monitor regional KPIs."],["gear","Operations Leaders","Track operational status, resolve issues and ensure on-track delivery across markets."],["user","Executive Stakeholders","Access a consistent view of delivery performance for strategic decision-making."]];
const challenges=[["database","Regional Data Structures","Variations in source systems, data structures and field definitions across markets."],["chart","KPI Interpretation Differences","Differences in KPI definitions, calculation logic and thresholds based on regional requirements."],["clock","Reporting Cadence","Different reporting frequencies and update cycles across projects, markets and functions."],["database","Consolidation Effort","Multiple inputs required reconciliation, validation and standardisation before reporting."],["network","Exception Traceability","Inconsistent logging and categorisation of delays, risks and operational issues."],["users","Cross-Market Comparability","Differences in terminology, context and business rules made it difficult to compare delivery performance across markets."]];
const lifecycle=[["users","Stakeholder Engagement","Engaged regional PMOs, operations and leadership teams to understand requirements and align on reporting needs."],["document","Requirements & Analysis","Captured and analysed business requirements, mapped current reporting structures and identified harmonisation needs."],["network","Data & Process Mapping","Mapped data sources, reporting flows, KPI definitions and business rules across regions."],["gear","Solution Design Support","Worked with technical teams to define data models, reporting logic, integration flows and dashboard requirements."],["document","Validation & UAT","Prepared test scenarios, coordinated UAT with regional teams and managed issue resolution to ensure data accuracy and business acceptance."],["rocket","Release & Adoption","Supported deployment, user documentation, training and ongoing support for continued usage and feedback."]];
const deliverables=[["document","Business Requirements Document","Detailed business requirements, current state analysis and future state reporting needs."],["database","KPI Definitions & Reporting Business Rules","Standardised KPI logic, definitions, calculation rules and data validation criteria."],["network","Data Flow & Process Mapping","Source-to-report data flow, process maps and reporting architecture."],["checklist","UAT Plan & Test Scenarios","Comprehensive UAT scenarios, execution tracking and issue resolution log."],["book","User Documentation & Training","Reporting guidelines, user manuals and training sessions for regional teams."]];
const metrics=[{"icon":"target","title":"Milestone Adherence Rate","text":"Measures whether planned project milestones were achieved within their approved target dates.","formula":"Milestones completed on/before target date ÷ Total scheduled milestones × 100","decision":"Which markets or programs are at risk of delivery slippage?"},{"icon":"clock","title":"Reporting Cycle Duration","text":"Measures how long it takes to move from the reporting input window to a published management view.","formula":"Dashboard Publication Timestamp − Data Ingestion / Reporting Window Start","decision":"Is reporting becoming operationally faster and less dependent on manual preparation?"},{"icon":"database","title":"Data / Pipeline Exception Rate","text":"Measures the proportion of records that cannot be processed because of missing, invalid or inconsistent data.","formula":"Rejected or exception records ÷ Total ingested records × 100","decision":"Where are recurring data-quality or source-process problems occurring?"},{"icon":"chart","title":"Delivery Progress","text":"Tracks completed delivery activity against the approved implementation scope.","decision":"How much of the planned regional program has progressed and where is execution falling behind?"},{"icon":"document","title":"Data Completeness","text":"Tracks whether required reporting fields are available for the records expected in the reporting cycle.","formula":"Valid records with all required fields ÷ Total expected records × 100","decision":"Can leadership trust the reported regional picture?"}];
const governance=[["document","Definition","What exactly are we measuring?"],["database","Source","Where does the underlying data originate?"],["users","Owner","Who is accountable for its quality?"],["calendar","Frequency","How often should it update?"],["alert","Exception","What happens when required inputs are missing?"],["gear","Decision","What action should the metric enable?"]];
const workspaces=[{"icon":"chart","title":"Executive Performance View","user":"Executive and senior operations leadership","items":["cross-market health overview","milestone performance","major risks","regional comparison","historical trends","high-level operational indicators"],"question":"Where should leadership attention be focused?"},{"icon":"users","title":"Regional Delivery Performance View","user":"Regional PMO and delivery leads","items":["milestone status","project-level progress","delayed activities","dependency visibility","regional comparisons","execution exceptions"],"question":"Which programs, markets or milestones require intervention?"},{"icon":"database","title":"Data Quality & Integration View","user":"Reporting, Analytics and Data teams","items":["source-data status","processing exceptions","validation errors","missing fields","data-quality trends","ingestion visibility"],"question":"Can the reported information be trusted?"}];
const techSources=[["spreadsheet","Regional Operational Files","Excel and structured reporting inputs maintained by market teams."],["document","Order & Procurement Data","Enterprise order and material-tracking information."],["truck","Logistics & Inventory","Equipment movements, delivery and availability information."],["pin","Project / Site Metadata","Market, project, site and milestone reference data."]];
const analyticsTools=[["chart","Power BI","Interactive business and operational reporting."],["tableau","Tableau","Visual analysis and stakeholder reporting."],["building","SAP BI / Enterprise Reporting","Supporting enterprise reporting requirements where applicable."],["spreadsheet","Excel","Operational source analysis, validation and reconciliation."]];
const checkpoints=[["document","Source validation","Is the expected information available?"],["link","Mapping validation","Does every source field map to the correct business definition?"],["gear","Business-rule validation","Is the transformation consistent with agreed requirements?"],["chart","Metric validation","Does the KPI calculate according to the approved definition?"],["monitor","UI validation","Does the dashboard represent the expected result?"],["users","UAT validation","Can stakeholders make the intended decision using the delivered solution?"]];
const capabilities=[["target","Problem Framing","Move beyond report requests to understand the underlying operational need, decision context and business impact."],["users","Stakeholder Alignment","Bring PMO, operations, reporting and regional teams toward one shared definition of requirements and success."],["document","Requirements Definition","Translate business needs into functional requirements, KPI rules, data mappings, acceptance criteria and usable reporting behaviour."],["chart","Data-Informed Decisions","Use metrics, process evidence and reporting logic to support prioritisation, visibility and better operational decisions."],["network","Cross-Functional Execution","Coordinate with analytics, engineering, QA and business teams to move requirements from discussion into delivery."],["shield","Validation & Adoption","Support UAT, business sign-off and stakeholder confidence so the solution is trusted and actually used."]];
const carried=["Discovery grounded in real user and business problems","Prioritisation based on value and operational need","Clear product-style requirement definition","Cross-functional execution with measurable outcomes","Validation that delivery solves the intended problem"];
---
<ProjectShell title="Enterprise Reporting & Insights Platform" {previous} {next} {navSections} ctaText="View Projects" ctaHref="/portfolio/#portfolio" showProjectFooter={false}>
  <main class="case-study nokia-case">
    <section class="case-page nk-overview" id="overview" aria-labelledby="nk-title">
      <div class="nk-canvas">
        <header class="nk-overview-copy">
          <div class="nk-logo"><Visual kind="nokia-logo"/></div>
          <p class="nk-eyebrow">Enterprise Reporting &amp; Delivery Intelligence <i></i></p>
          <h1 id="nk-title">Enterprise Reporting &amp;<br/>Insights Platform</h1>
          <p class="nk-descriptor">Cross-Market Telecom Delivery Analytics &amp;<br/>Operations Governance Platform</p>
          <i class="nk-accent"></i>
          <h2><em>From regional reporting to</em><br/>a unified operational view.</h2>
          <p class="nk-overview-intro">Within Nokia’s established global operations, regional reporting structures and KPI interpretations varied. A standardised analytical layer supported consistent, comparable and traceable management reporting.</p>
          <div class="nk-overview-role"><span class="nk-bubble"><NokiaIcon name="user"/></span><div><b>My role: Business Analyst</b><p>Requirements · KPI logic · source mapping ·<br/>business validation.</p></div></div>
        </header>
        <div class="nk-overview-scene">
          <div class="nk-market-band"><h3>7 INTERNATIONAL MARKETS</h3><div>{['APAC','CHINA','INDIA','MEA','EUR','LAT','NAM'].map((code,i)=><div class:list={['nk-market',`nk-${['blue','red','orange','violet','blue','green','cyan'][i]}`]}><Visual kind="market" region={code}/><b>{code}</b></div>)}</div></div>
          <svg class="nk-market-paths nk-legacy-paths" viewBox="0 0 1040 150" preserveAspectRatio="none" aria-hidden="true"><path d="M140 0v20q0 22 22 22h330q22 0 22 22v45M280 0v20q0 22 22 22M420 0v20q0 22 22 22M565 0v112M710 0v20q0 22-22 22h-80q-22 0-22 22v45M855 0v20q0 22-22 22H710M995 0v20q0 22-22 22H855"/><path class="nk-arrow-fill" d="m507 103 7 14 7-14m37 1 7 14 7-14m7-15 7 14 7-14"/></svg>
          <svg class="nk-market-paths nk-reference-paths" viewBox="0 0 1036 663" aria-hidden="true"><path d="M160 168v20q0 22 22 22h302q22 0 22 22v13M287 168v20q0 22 22 22H484M415 168v20q0 22 22 22h47M541 168v77M670 168v20q0 22-22 22h-63q-22 0-22 22v13M797 168v20q0 22-22 22H648M925 168v20q0 22-22 22H775"/><path class="nk-arrow-fill" d="M500 239l6 10 6-10M535 239l6 10 6-10M557 239l6 10 6-10"/></svg>
          <div class="nk-overview-model">
          <div class="nk-overview-inputs">{[['document','Delivery'],['truck','Logistics'],['shield','Procurement'],['gear','Operations'],['document','Regional Reports']].map(([icon,text])=><div><NokiaIcon name={icon}/><b>{text}</b></div>)}</div>
          <svg class="nk-source-paths nk-legacy-paths" viewBox="0 0 250 350" preserveAspectRatio="none" aria-hidden="true"><path d="M0 20C140 20 90 175 250 175M0 95C140 95 90 175 250 175M0 175H250M0 250C140 250 90 175 250 175M0 325C140 325 90 175 250 175"/></svg>
          <svg class="nk-source-paths nk-reference-paths" viewBox="0 0 1036 663" aria-hidden="true"><path d="M142 255C170 255 182 309 212 320M142 300C174 300 181 328 212 335M142 350H212M142 398C174 398 181 372 212 365M142 447C174 447 182 390 212 380"/></svg>
          <div class="nk-dashboard-back" aria-hidden="true"><div>NOKIA</div><p>Overview</p><span>Reports</span><span>KPIs</span><span>Markets</span><span>Projects</span><span>Exports</span></div>
          <div class="nk-dashboard-sheet" aria-hidden="true"><div><NokiaIcon name="document"/><i></i><i></i></div><div class="nk-background-chart"><Chart kind="dashboard-bars"/></div><div class="nk-background-donut"><Chart kind="dashboard-donut"/></div><Visual kind="world"/></div>
          <div class="nk-platform-core"><h3><NokiaIcon name="chart"/> Enterprise Reporting &amp; Insights Platform</h3><div>{[['gear','Standardised KPI Logic','Common business definitions and calculation rules.'],['database','Consolidated Data Inputs','Regional delivery, logistics, procurement and operational data in a unified structure.'],['document','Operational Reporting','Role-based management views for project, regional and executive stakeholders.']].map(([icon,title,text])=><article><NokiaIcon name={icon}/><h4>{title}</h4><p>{text}</p></article>)}</div></div>
          </div>
          <svg class="nk-user-paths nk-legacy-paths" viewBox="0 0 1000 90" preserveAspectRatio="none" aria-hidden="true"><path d="M340 0v15q0 15-15 15H215q-15 0-15 15v35M500 0v80M660 0v15q0 15 15 15h110q15 0 15 15v35"/><path class="nk-arrow-fill" d="m193 72 7 14 7-14m286 0 7 14 7-14m286 0 7 14 7-14"/></svg>
          <svg class="nk-user-paths nk-reference-paths" viewBox="0 0 1036 663" aria-hidden="true"><path d="M361 463v10q0 16-16 16h-90q-16 0-16 16v13M488 463v55M526 463v10q0 16 16 16h226q16 0 16 16v13"/><path class="nk-arrow-fill" d="M233 512l6 10 6-10M482 512l6 10 6-10M778 512l6 10 6-10"/></svg>
          <div class="nk-overview-users">{[['users','Regional PMOs','Monitor delivery performance, milestones, dependencies and execution status.'],['gear','Operations Leaders','Review operational health, identify issues and coordinate corrective action.'],['chart','Executive Stakeholders','Access consistent cross-market information for management and strategic decisions.']].map(([icon,title,text],i)=><Panel reference {icon} title={i===0?'Regional PMOs':title} {text} tone={['blue','green','violet'][i]}/>)}</div>
        </div>
        <div class="nk-overview-values">{values.map(([icon,title,text],i)=><Panel reference icon={i===2?'eye':icon} {title} {text} tone={['blue','green','violet','orange'][i]}/>)}</div>
      </div>
    </section>
<NokiaReferenceSections content={{sources,model,users,challenges,lifecycle,deliverables,metrics,governance,workspaces,techSources,analyticsTools,checkpoints,capabilities,carried}} {previous} {next}/>
  </main>
</ProjectShell>
