---
import PortfolioIcon from '../PortfolioIcon.astro';
const { name, weight = 1.8 } = Astro.props;
---
{name === 'medal' ? (
  <svg class="intro-symbol" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width={weight} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 20-4 10 7-3 4 3 2-9m5-1 4 10-7-3-4 3-2-9"/><path d="m16 2 3 2 4 1 1 4 2 3-2 3-1 4-4 1-3 2-3-2-4-1-1-4-2-3 2-3 1-4 4-1Z"/><circle cx="16" cy="12" r="6"/></svg>
) : name === 'code' ? (
  <svg class="intro-symbol" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width={weight} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 8-8 8 8 8m10-16 8 8-8 8M19 5l-6 22"/></svg>
) : name === 'growth-bars' ? (
  <svg class="intro-symbol" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M4 21h5v10H4Zm9-6h5v16h-5Zm9-7h5v23h-5Z"/><path d="m4 15 8-8 6 3L28 1m-7 0h7v7" fill="none" stroke="currentColor" stroke-width={weight} stroke-linecap="round" stroke-linejoin="round"/></svg>
) : name === 'layers-solid' ? (
  <svg class="intro-symbol" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="m2 9 14-7 14 7-14 7Zm0 7 5-2.5 9 4.5 9-4.5 5 2.5-14 7Zm0 7 5-2.5 9 4.5 9-4.5 5 2.5-14 7Z"/></svg>
) : name === 'people-solid' ? (
  <svg class="intro-symbol" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><circle cx="16" cy="9" r="5"/><circle cx="5" cy="12" r="4"/><circle cx="27" cy="12" r="4"/><path d="M8 30V22a8 8 0 0 1 16 0v8ZM0 28v-8a5 5 0 0 1 8-4 11 11 0 0 0-3 8v4Zm27 0v-4a11 11 0 0 0-3-8 5 5 0 0 1 8 4v8Z"/></svg>
) : name === 'layers' ? (
  <svg class="intro-symbol" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width={weight} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 13-7 13 7-13 7Zm0 7 13 7 13-7M3 24l13 7 13-7"/></svg>
) : name === 'problem-first' ? (
  <svg class="intro-symbol" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width={weight} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 23c0-5-5-6-5-12a9 9 0 0 1 18 0c0 6-5 7-5 12ZM12 27h8m-6 3h4m-6-19 4 5 4-5m-4 5v7M3 10H1m30 0h-2M6 3 4 1m22 2 2-2"/></svg>
) : name === 'healthcare' ? (
  <svg class="intro-symbol" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width={weight} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4v9a7 7 0 0 0 14 0V4M3 4h4m10 0h4M12 20v3a6 6 0 0 0 12 0v-6"/><circle cx="24" cy="12" r="4"/></svg>
) : name === 'telecom' ? (
  <svg class="intro-symbol" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width={weight} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 10-8 20m8-20 8 20M11 23h10m-7-8h4m-6-5a6 6 0 0 1 0-8m8 8a6 6 0 0 0 0-8M7 14A12 12 0 0 1 7 1m18 13a12 12 0 0 0 0-13"/><circle cx="16" cy="6" r="2"/></svg>
) : name === 'education' ? (
  <svg class="intro-symbol" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width={weight} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 11 14-7 14 7-14 7zM7 14v9c6 4 12 4 18 0v-9m5-3v12" /></svg>
) : name === 'arrow' ? (
  <svg class="intro-symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={weight} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16m-7-7 7 7-7 7" /></svg>
) : name === 'linkedin' ? (
  <svg class="intro-symbol" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 1h18a2 2 0 0 1 2 2v18a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2ZM5 9v10h3V9Zm1.5-5a1.7 1.7 0 1 0 0 3.4 1.7 1.7 0 0 0 0-3.4ZM10 9v10h3v-5.3c0-2.5 3-2.7 3 0V19h3v-6.5c0-4.5-4.7-4.4-6-2.2V9Z" /></svg>
) : <PortfolioIcon name={name} weight={weight} />}
