---
import Icon from './IntroIcon.astro';
import { experience, progression } from '../../data/intro-portfolio';
---
<div class="intro-experience-page">
  <section class="intro-experience-heading" aria-labelledby="intro-experience-title"><p class="intro-eyebrow">WORK EXPERIENCE <span/></p><h1 id="intro-experience-title"><em>10+ Years</em> Across Product, Platforms, Data & Delivery</h1><p>A progression from reporting and analytics to business analysis and product leadership across FinTech, Healthcare, Telecom and enterprise platforms.</p></section>
  <ol class="intro-progression" aria-label="Career progression">{progression.map(item => <li class={`intro-tone-${item.tone}`}><span class="intro-icon-disc"><Icon name={item.icon} weight={2.5}/></span><div><h2>{item.title}</h2><p>{item.text}</p></div><span class="intro-progression-arrow"><Icon name="arrow"/></span></li>)}</ol>
  <section class="intro-timeline" aria-label="Professional experience">{experience.map((item,i) => <article class={`intro-experience-row intro-tone-${item.tone}`}><div class="intro-tenure"><span class="intro-timeline-dot"/><p>{item.start} –<br/>{item.end}</p></div><div class="intro-experience-card"><div class="intro-role"><div class:list={['intro-company-logo', i===1 && 'intro-company-logo--phoneme']}><img src={item.logo.startsWith('/') ? item.logo : `/intro/logos/${item.logo}`} alt={`${item.company} logo`} width="160" height="100"/></div><div><h2>{item.company}</h2><h3>{item.role}</h3><p>{item.context}</p></div></div><div class="intro-scope"><h4><Icon name="target" weight={2.5}/>Key Scope</h4><ul>{item.scope.map(tag => <li>{tag}</li>)}</ul></div><div class="intro-impact"><h4><Icon name="chart" weight={2.5}/>Selected Impact</h4><ul>{item.impact.map(text => <li><Icon name="check"/><span>{text}</span></li>)}</ul></div><div class="intro-projects"><h4><Icon name="cube" weight={2.5}/>Products / Platforms / Projects</h4><p>{item.projects}</p></div></div></article>)}</section>
</div>
