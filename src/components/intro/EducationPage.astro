---
import Icon from './IntroIcon.astro';
import { introImage } from './image-delivery.js';
import CertificationMark from './CertificationMark.astro';
import { education, certifications, learning } from '../../data/intro-portfolio';
const credentialImages = ['education-campus-v1.webp', 'education-computing-v1.webp', 'education-software-v1.webp'];
const certificationBrands = ['microsoft', 'google', 'powerbi', 'ibm', 'jhu', 'iiba', 'iiba', 'iiba'];
---
<div class="intro-education-page">
  <section class="intro-education-hero" aria-labelledby="intro-education-title"><div><p class="intro-eyebrow">EDUCATION <span/></p><h1 id="intro-education-title">Education & <em>Continuous Learning</em></h1><p><span>A strong academic foundation combined with continuous learning has </span><span>helped me build a balanced perspective across business, technology and data, </span><span>and apply it effectively in real-world product and enterprise environments.</span></p></div><div class="intro-education-scene" aria-hidden="true"><img class="intro-education-hero-photo" src="/intro/education/education-hero-v1.webp" width="2172" height="724" {...introImage('/intro/education/education-hero-v1.webp', '(max-width: 767px) 100vw, 75vw')} alt="" fetchpriority="high" /></div></section>
  <section class="intro-education-cards" aria-label="Academic credentials">{education.map((item,i) => <article class={`intro-panel intro-education-card intro-tone-${item.tone}`}><img class="intro-credential-photo" loading="eager" fetchpriority="low" src={`/intro/education/${credentialImages[i]}`} width="1536" height="1024" {...introImage(`/intro/education/${credentialImages[i]}`, '(max-width: 767px) max(100vw, 640px), 33vw')} alt="" aria-hidden="true"/><div class="intro-credential-heading"><span class="intro-icon-tile"><Icon name={i===2?'document':'education'}/></span><div><h2>{item.title}</h2><p>{item.institution}</p>{item.year && <strong class="intro-credential-year">{item.year}</strong>}</div></div><h3>{item.heading}</h3><ul>{item.topics.map(([icon,text]) => <li><Icon name={i === 1 && text === "Programming fundamentals" || i === 2 && text === "Application development" ? "code" : icon}/><span>{text}</span></li>)}</ul></article>)}</section>
  <div class="intro-education-lower">
    <section class="intro-panel intro-certifications" aria-labelledby="intro-certifications-title">
      <div class="intro-panel-heading intro-tone-orange"><span class="intro-icon-tile"><Icon name="medal"/></span><div><h2 id="intro-certifications-title">Certifications</h2><p>Certifications that strengthen my product, data, analytics and business analysis foundation.</p></div></div>
      <div class="intro-certification-grid">
        {certifications.map((item, index) => <article class={`intro-tone-${item.tone}`}>
          <span class="intro-icon-soft"><CertificationMark brand={certificationBrands[index]}/></span>
          <div><h3>{item.providerFirst ? item.provider : item.title}</h3>{item.providerFirst ? <p>{item.title}</p> : item.provider && <p>({item.provider})</p>}</div>
        </article>)}
      </div>
    </section>
    <section class="intro-panel intro-learning" aria-labelledby="intro-learning-title"><div class="intro-panel-heading intro-tone-purple"><span class="intro-icon-tile"><Icon name="bulb"/></span><div><h2 id="intro-learning-title">Continuous Learning</h2><p>I keep learning and exploring new areas to stay aligned with industry trends and future opportunities.</p></div></div><div class="intro-learning-grid">{learning.map(item => <article class={`intro-tone-${item.tone}`}><span class="intro-icon-soft"><Icon name={item.title === "Enterprise Architecture" ? "layers" : item.icon} weight={2.2}/></span><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div></section>
  </div>
</div>
