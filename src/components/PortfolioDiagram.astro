---
import PortfolioIcon from './PortfolioIcon.astro';
interface Props { kind: 'ecosystem' | 'challenge' | 'strategy' | 'lifecycle' | 'strategy-wheel'; }
const { kind } = Astro.props;
const prefix = `portfolio-diagram-${kind}`;
const paint = (tone: string) => `url(#${prefix}-${tone})`;
const arrow = `url(#${prefix}-arrow)`;
const joinedArrow = `url(#${prefix}-joined-arrow)`;
const shadow = `url(#${prefix}-shadow)`;
const strategy = kind === 'strategy';
const layers = strategy ? [
  { title: 'STRATEGY & PRIORITIES', detail: '', icon: 'target', tone: 'blue' },
  { title: 'PRODUCT ROADMAP', detail: '', icon: 'map', tone: 'purple' },
  { title: 'EXECUTION & ENABLEMENT', detail: '', icon: 'rocket', tone: 'green' },
  { title: 'MEASUREMENT & OUTCOMES', detail: '', icon: 'chart', tone: 'amber' },
] : [
  { title: 'Business Processes', detail: '', icon: 'gear', tone: 'blue' },
  { title: 'Technology & Integrations', detail: '', icon: 'cube', tone: 'purple' },
  { title: 'Data & Intelligence', detail: '', icon: 'database', tone: 'green' },
  { title: 'Compliance & Risk', detail: '', icon: 'shield', tone: 'amber' },
];
const inputs = strategy ? [
  { lines: ['Market &', 'Competition'], icon: 'analytics' },
  { lines: ['Technology', '& AI Opportunity'], icon: 'chip' },
  { lines: ['Data &', 'Insights'], icon: 'database' },
] : [
  { lines: ['People &', 'Stakeholders'], icon: 'users' },
  { lines: ['Business', 'Rules'], icon: 'document' },
  { lines: ['External', 'Systems'], icon: 'network' },
];
const outputs = strategy ? [
  { lines: ['Business', 'Goals & OKRs'], icon: 'target' },
  { lines: ['Risk, Compliance', '& Constraints'], icon: 'shield' },
  { lines: ['People, Process', '& Operations'], icon: 'users' },
] : [
  { lines: ['Operational', 'Readiness'], icon: 'chart' },
  { lines: ['Measurable', 'Outcomes'], icon: 'target' },
  { lines: ['Scalable', 'Growth'], icon: 'chart' },
];
const ecosystem = [
  { x: 320, y: 44, tone: 'purple', icon: 'users', lines: ['Customer', 'Experience'] },
  { x: 111, y: 123, tone: 'blue', icon: 'chart', lines: ['Business', 'Goals'] },
  { x: 529, y: 123, tone: 'green', icon: 'database', lines: ['Technology', '& Data'] },
  { x: 172, y: 252, tone: 'amber', icon: 'gear', lines: ['Operations', '& Support'] },
  { x: 468, y: 252, tone: 'pink', icon: 'shield', lines: ['Compliance', '& Risk'] },
];
const lifecycle = [
  { x: 77, y: 78, n: '01', lines: ['Discover'], icon: 'search', tone: 'blue' },
  { x: 232, y: 63, n: '02', lines: ['Define'], icon: 'document', tone: 'purple' },
  { x: 408, y: 72, n: '03', lines: ['Design'], icon: 'monitor', tone: 'green' },
  { x: 563, y: 80, n: '04', lines: ['Architect'], icon: 'cube', tone: 'amber' },
  { x: 77, y: 238, n: '05', lines: ['Automate'], icon: 'gear', tone: 'pink' },
  { x: 232, y: 260, n: '06', lines: ['AI / GenAI'], icon: 'brain', tone: 'blue' },
  { x: 408, y: 260, n: '07', lines: ['Deliver'], icon: 'rocket', tone: 'purple' },
  { x: 563, y: 238, n: '08', lines: ['Scale', '& Adopt'], icon: 'chart', tone: 'green' },
];
// The existing lifecycle stays fixed; endpoints are intersected with each circle.
const loopOrder = [0,1,2,3,7,6,5,4];
const loopControls = [[153,57],[320,54],[486,68],[638,160],[487,279],[320,283],[153,279],[2,158]];
const lifecycleEdges = loopOrder.map((nodeIndex,i)=>{
  const from=lifecycle[nodeIndex], to=lifecycle[loopOrder[(i+1)%loopOrder.length]];
  const [cx,cy]=loopControls[i];
  const edge=(node: typeof from)=>{
    const length=Math.hypot(cx-node.x,cy-node.y);
    return [node.x+(cx-node.x)*48.5/length,node.y+(cy-node.y)*48.5/length];
  };
  const a=edge(from), b=edge(to);
  return `M${a}Q${cx} ${cy} ${b}`;
});
const wheel = [
  { angle: -90, tone: 'blue', icon: 'users', lines: ['Customer', 'Value'] },
  { angle: -30, tone: 'purple', icon: 'chart', lines: ['Business', 'Impact'] },
  { angle: 30, tone: 'pink', icon: 'gear', lines: ['Feasibility'] },
  { angle: 90, tone: 'amber', icon: 'rocket', lines: ['Execution', 'Readiness'] },
  { angle: 150, tone: 'green', icon: 'chart', lines: ['Measurable', 'Outcomes'] },
  { angle: 210, tone: 'amber', icon: 'refresh', lines: ['Continuous', 'Learning'] },
];
const polar = (r: number, angle: number) => [160 + r * Math.cos(angle * Math.PI / 180), 160 + r * Math.sin(angle * Math.PI / 180)];
const sector = (angle: number) => {
  const a = polar(145, angle - 27), b = polar(145, angle + 27);
  const c = polar(79, angle + 27), d = polar(79, angle - 27);
  return `M${a} A145 145 0 0 1 ${b} L${c} A79 79 0 0 0 ${d} Z`;
};
---
<svg class="portfolio-diagram" width="100%" height="100%" preserveAspectRatio="xMidYMid meet" style="display:block;width:100%;height:100%;font-family:Segoe UI,Arial,sans-serif" viewBox={kind === 'strategy-wheel' ? '0 0 320 320' : '0 0 640 320'} role="img" aria-label={{ ecosystem:'Product connects customer experience, business goals, technology and data, operations and support, and compliance and risk', challenge:'People, business rules and external systems connect through four product layers to readiness, outcomes and growth', strategy:'Customer-led strategy connects discovery and prioritization to roadmap, delivery and measurement', lifecycle:'Product management lifecycle: Discover, Define, Design, Architect, Automate, AI and GenAI, Deliver, Scale and Adopt, and repeat', 'strategy-wheel':'Product strategy balances customer value, business impact, feasibility, execution readiness, measurable outcomes and continuous learning' }[kind]}>
  <defs>
    {[
      ['blue','#05c5ff','#1261ed'],['purple','#b53cff','#5923e9'],['green','#10e4b5','#009f9e'],['amber','#ffd051','#f59000'],['pink','#ff45bc','#d119a2'],['navy','#123f77','#06274f']
    ].map(([tone,first,last])=><linearGradient id={`${prefix}-${tone}`} x1="0" y1="0" x2="1" y2="1"><stop stop-color={first}/><stop offset="1" stop-color={last}/></linearGradient>)}
    <radialGradient id={`${prefix}-glow`}><stop stop-color="#14bbff" stop-opacity=".4"/><stop offset="1" stop-color="#0a65df" stop-opacity="0"/></radialGradient>
    <linearGradient id={`${prefix}-customer`}><stop stop-color="#00bff2"/><stop offset="1" stop-color="#7924f7"/></linearGradient>
    <filter id={`${prefix}-shadow`} x="-30%" y="-30%" width="160%" height="180%"><feDropShadow dx="0" dy="5" stdDeviation="4" flood-color="#001f4e" flood-opacity=".45"/></filter>
    <marker id={`${prefix}-arrow`} viewBox="0 0 7 7" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" refX="6" refY="3.5" orient="auto-start-reverse"><path d="m0 0 7 3.5-7 3.5 2-3.5z" fill="#d8f6ff"/></marker>
    <marker id={`${prefix}-joined-arrow`} viewBox="0 0 7 7" markerUnits="userSpaceOnUse" markerWidth="9" markerHeight="9" refX="7" refY="3.5" orient="auto"><path d="m0 0 7 3.5-7 3.5 2-3.5z" fill="#d8f6ff"/></marker>
  </defs>
  {kind === 'ecosystem' && <g>
    <ellipse cx="320" cy="176" rx="278" ry="131" fill={paint('glow')}/>
    <ellipse cx="320" cy="176" rx="278" ry="116" fill="none" stroke="#5cb7ff" stroke-opacity=".5" stroke-dasharray="3 5"/>
    <ellipse cx="320" cy="194" rx="230" ry="101" fill="none" stroke="#60c6ff" stroke-opacity=".3" stroke-dasharray="2 7"/>
    <path d="m320 73 0 62m-139-7 83 30m195-30-83 30M220 227l58-38m142 38-58-38" fill="none" stroke="#7bdeff" stroke-width="2" marker-end={arrow}/>
    <path d="M111 151v39l61 36m357-75v39l-61 36M248 252h144" fill="none" stroke="#4ebcff" stroke-opacity=".55" stroke-dasharray="4 5"/>
    {ecosystem.map(node=><g transform={`translate(${node.x} ${node.y})`} filter={shadow}>
      <path d="M-62-19-10-35Q0-38 10-35L62-19Q72-16 72-7V26Q72 35 62 38L10 54Q0 57-10 54L-62 38Q-72 35-72 26V-7Q-72-16-62-19Z" fill={paint(node.tone)} stroke="#83d8ff" stroke-opacity=".8"/>
      <path d="m-72-16 72-18 72 18L0 4z" fill="#fff" opacity=".14"/><path d="M0 4v48" stroke="#fff" stroke-opacity=".15"/>
      <g transform="translate(-13 -26)" color="#fff" font-size="26"><PortfolioIcon name={node.icon} fragment size={26} /></g>
      <text x="0" y="15" text-anchor="middle" fill="#fff" font-size="14" font-weight="750">{node.lines.map((line,i)=><tspan x="0" dy={i ? 15 : 0}>{line}</tspan>)}</text>
    </g>)}
    <g transform="translate(320 158)" filter={shadow}>
      <path d="M-59-21-10-44Q0-49 10-44L59-21Q69-17 69-7V38Q69 47 59 51L10 73Q0 78-10 73L-59 51Q-69 47-69 38V-7Q-69-17-59-21Z" fill={paint('blue')} stroke="#48d3ff"/>
      <path d="m-69-13 69-32 69 32L0 18z" fill="#38cfff" opacity=".35"/><path d="M0 18v56" stroke="#73dcff"/>
      <g transform="translate(-19 -31)" color="#fff" font-size="38"><PortfolioIcon name="cube" fragment size={38} /></g>
      <text x="0" y="46" fill="#fff" font-size="21" font-weight="850" text-anchor="middle">Product</text>
    </g>
    {[[320,105],[231,151],[410,151],[250,216],[391,216]].map(([x,y])=><circle cx={x} cy={y} r="4" fill="#d7f8ff" stroke="#0caeff" stroke-width="2"/>)}
  </g>}
  {(kind === 'challenge' || kind === 'strategy') && <g>
    <ellipse cx="320" cy="211" rx="174" ry="104" fill={paint('glow')}/>
    <g fill="none" stroke="#a9e5ff" stroke-width="1.8" stroke-linejoin="round">
      {/* Side-box centers feed a shared rail; each layer joins at its actual face edge. */}
      <path d="M165 114.5V266.5M476 114.5V266.5"/>
      {[0,1,2].map(i=><g><path d={`M148 ${116.5+i*75}H165`}/><path d={`M476 ${116.5+i*75}H492`} marker-end={joinedArrow}/></g>)}
      {layers.map((_,i)=>{
        const x=206-i*9, y=114.5+i*45, right=434+i*9;
        return <g><path d={`M165 ${y}H${x}`} marker-end={joinedArrow}/><path d={`M${right} ${y}H476`}/></g>;
      })}
      <path d="M320 97V66" stroke-width="3" marker-end={joinedArrow}/>
    </g>
    <g transform="translate(218 12)" filter={shadow}>
      <rect width="204" height="54" rx="14" fill={paint('customer')} stroke="#65bfff"/>
      <g transform="translate(14 11)" font-size="29" color="#fff"><PortfolioIcon name="users" fragment size={29} /></g>
      <text x="121" y="23" text-anchor="middle" fill="#fff" font-size={strategy ? 12 : 14} font-weight="750">{strategy ? 'CUSTOMER' : 'Customer'}<tspan x="121" dy="16">{strategy ? 'NEED & EXPERIENCE' : 'Need & Experience'}</tspan></text>
    </g>
    {layers.map((layer,i)=>{
      const x=206-i*9, y=100+i*45, width=228+i*18;
      return <g filter={shadow}>
        <path d={`M${x} ${y} Q320 ${y-26} ${x+width} ${y} V${y+29} Q320 ${y+56} ${x} ${y+29}Z`} fill={paint(layer.tone)} stroke="#91e8ff" stroke-opacity=".7"/>
        <path d={`M${x} ${y} Q320 ${y-26} ${x+width} ${y} Q320 ${y+26} ${x} ${y}Z`} fill="#fff" fill-opacity=".18"/>
        <path d={`M${x} ${y} Q320 ${y+26} ${x+width} ${y}`} fill="none" stroke="#fff" stroke-opacity=".35"/>
        <g transform={`translate(${x+16} ${y+9})`} color="#fff" font-size="24"><PortfolioIcon name={layer.icon} fragment size={24} /></g>
        <text x="334" y={y+23} text-anchor="middle" fill="#fff" font-size={strategy?12:13} font-weight="800">{layer.title}</text>
        {strategy && layer.detail && <text x="330" y={y+32} text-anchor="middle" fill="#e0f8ff" font-size="8.5">{layer.detail}</text>}
      </g>;
    })}
    {[inputs,outputs].map((list,side)=>list.map((node,i)=><g transform={`translate(${side?492:8} ${92+i*75})`}>
      <rect width="140" height="49" rx="11" fill={paint('navy')} stroke="#45baff" stroke-opacity=".8"/>
      <g transform="translate(10 12)" font-size="25" color="#e4f7ff"><PortfolioIcon name={node.icon} fragment size={25} /></g>
      <text x="88" y="21" text-anchor="middle" fill="#f0f8ff" font-size="11.5" font-weight="700">{node.lines.map((line,j)=><tspan x="88" dy={j?13:0}>{line}</tspan>)}</text>
    </g>))}
  </g>}
  {kind === 'lifecycle' && <g>
    <ellipse cx="320" cy="160" rx="297" ry="135" fill={paint('glow')}/>
    <path d="M77 78C185 42 440 43 563 80C622 116 622 200 563 238C424 287 199 287 77 238C18 204 18 113 77 78Z" fill="none" stroke="#5dbfff" stroke-opacity=".28" stroke-width="16"/>
    {lifecycleEdges.map(path=><path d={path} fill="none" stroke="#b3e9ff" stroke-width="3" marker-end={joinedArrow}/>)}
    <path d="M122.7 94.2 247.3 138.3M517.2 95.9 393.5 138.6M123.4 223.9 246.3 186.4M516.6 223.9 393.7 186.4" fill="none" stroke="#70bdff" stroke-opacity=".55" stroke-dasharray="3 5"/>
    <g transform="translate(320 164) scale(1.1)" filter={shadow}>
      <path d="m0-52 67 29v52L0 58l-67-29v-52z" fill={paint('blue')} stroke="#6bcfff"/>
      <path d="m-67-23 67-29 67 29L0 6z" fill="#58dbff" opacity=".4"/>
      <g transform="translate(-17 -40)" font-size="34" color="#fff"><PortfolioIcon name="cube" fragment size={34} weight={2.35} /></g>
      <text x="0" y="17" text-anchor="middle" fill="#fff" font-size="16" font-weight="850">Product<tspan x="0" dy="19">Management</tspan></text>
    </g>
    {lifecycle.map(node=><g transform={`translate(${node.x} ${node.y})`} filter={shadow}>
      <circle r="48" fill={paint(node.tone)} stroke="#93cfff" stroke-opacity=".7"/>
      <path d="M-37-22Q0-49 37-22" fill="none" stroke="#fff" stroke-opacity=".35" stroke-width="3"/>
      <g transform="translate(-12 -33)" font-size="24" color="#fff"><PortfolioIcon name={node.icon} fragment size={24} weight={2.35} /></g>
      <text x="0" y="8" text-anchor="middle" fill="#fff" font-size="13" font-weight="800">{node.n}</text>
      <text x="0" y="25" text-anchor="middle" fill="#fff" font-size="12" font-weight="750">{node.lines.map((line,i)=><tspan x="0" dy={i?13:0}>{line}</tspan>)}</text>
    </g>)}
  </g>}
  {kind === 'strategy-wheel' && <g>
    <circle cx="160" cy="160" r="155" fill="#f6fcff" stroke="#b9e2ff" stroke-dasharray="3 4"/>
    {wheel.map(node=>{
      const [x,y]=polar(113,node.angle);
      return <g>
        <path d={sector(node.angle)} fill={paint(node.tone)} fill-opacity=".12" stroke={paint(node.tone)} stroke-width="1.5" stroke-linejoin="round"/>
        <g transform={`translate(${x-12} ${y-24})`} font-size="25" color={{blue:'#087ff0',purple:'#8a2cfa',pink:'#e5289d',amber:'#ec9100',green:'#00a982'}[node.tone]}><PortfolioIcon name={node.icon} fragment size={25} weight={2.35} /></g>
        <text x={x} y={y+14} text-anchor="middle" fill="#143f75" font-size="9" font-weight="800">{node.lines.map((line,i)=><tspan x={x} dy={i?11:0}>{line}</tspan>)}</text>
      </g>;
    })}
    <path d="M160 8A152 152 0 0 1 291 84m21 76a152 152 0 0 1-76 131m-76 21A152 152 0 0 1 29 236M8 160A152 152 0 0 1 84 29" fill="none" stroke="#58aeef" stroke-width="1.7" marker-end={arrow}/>
    <circle cx="160" cy="160" r="76" fill={paint('navy')} stroke="#65baff" stroke-width="4" filter={shadow}/>
    <g transform="translate(145 106)" color="#b5eeff" font-size="30"><PortfolioIcon name="cube" fragment size={30} /></g>
    <text x="160" y="153" text-anchor="middle" fill="#fff" font-size="15" font-weight="850">PRODUCT<tspan x="160" dy="17">STRATEGY</tspan></text>
    <text x="160" y="189" text-anchor="middle" fill="#c8e5ff" font-size="7.5">VISION → ROADMAP<tspan x="160" dy="11">EXECUTION → OUTCOMES</tspan></text>
  </g>}
</svg>
<style>
  .portfolio-diagram { display:block; width:100%; height:100%; min-width:0; min-height:0; overflow:visible; font-family:"Segoe UI",Arial,sans-serif; }
</style>
