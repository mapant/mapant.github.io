---
import Icon from './NokiaIcon.astro';
import PortfolioIcon from './PortfolioIcon.astro';
import Visual from './NokiaVisual.astro';
import leadershipBanner from '../assets/nokia/nokia-leadership-banner.png';
import Chart from './NokiaChart.astro';
import ProjectNavigation from './ProjectNavigation.astro';
import '../styles/nokia-reference-sections.scss';
const {content,previous,next}=Astro.props;
const {sources,model,users,challenges,lifecycle,deliverables,metrics,governance,workspaces,techSources,analyticsTools,checkpoints,capabilities,carried}=content;
const colors=['blue','orange','green','violet','pink','green'];
const stages=[["document","Understand & Align",["Engage regional stakeholders","Understand existing reporting structures and KPI definitions","Capture and analyse business requirements","Identify gaps and harmonisation needs"]],["network","Define & Standardise",["Establish common business definitions","Harmonise KPI logic and calculation rules","Define reporting hierarchies and dimensions","Create data mapping and transformation requirements"]],["database","Design & Build",["Design consolidated data model and reporting layer","Define data flows and integration logic","Develop standardised reports and dashboards","Ensure scalability, reusability and performance"]],["gear","Validate & Rollout",["Conduct data validation and cross-checks","Perform UAT with regional teams","Incorporate feedback and refine reports","Ensure business sign-off and phased rollout across markets"]],["chart","Enable & Sustain",["Provide user documentation and guidance","Support adoption across regional teams","Monitor usage and address feedback","Enable continuous improvements based on evolving needs"]]];
const strategyValues=[["users","Stakeholder Collaboration","Worked closely with regional PMOs, operations, data teams and business stakeholders to ensure alignment and buy-in."],["database","Standardised Definitions","Established common business definitions, KPI logic and reporting hierarchies for consistent interpretation across markets."],["network","Governed Reporting Layer","Designed a consolidated reporting layer with structured data flows, validation and access controls."],["refresh","Iterative Rollout & Adoption","Delivered in phases with UAT, business sign-off and continuous improvements based on user feedback and evolving needs."]];
const scopeValues=[["chart","Standardised Reporting","Common KPI definitions and business rules enabled a unified view of delivery performance across all markets."],["database","Reliable Data Foundation","Structured data flows and validation improved data accuracy and consistency across reports."],["eye","Better Decision-Making","Enabled regional and executive stakeholders to review delivery performance, identify risks and take timely actions."],["users","Improved Adoption","Clear documentation, training and ongoing support ensured sustained usage by regional teams and leadership."]];
const hierarchy=[['building','EXECUTIVE SIGNAL','High-level health, risks and trends across markets.'],['users','REGIONAL PERFORMANCE','Regional and market-level progress and comparisons.'],['document','PROGRAM / PROJECT','Project performance, milestones and delivery status.'],['flag','MILESTONE / ISSUE','Detailed milestone status, issues and dependencies.'],['target','ACTION','Targeted actions for operational follow-up and improved delivery.']];
const flow=[["document","REGIONAL INPUTS","Operational files and source systems"],["database","STAGING","Consolidate data in SQL staging layer"],["gear","CLEAN & STANDARDISE","Apply transformation and validation rules"],["network","SEMANTIC MODEL","Common analytical model and business definitions"],["calculator","KPI CALCULATION","Apply agreed calculation logic and business rules"],["chart","POWER BI / TABLEAU / REPORTING","Stakeholder-specific reporting views"],["users","BUSINESS DECISION","Trusted insights for operational and strategic decisions"]];
const impact=[['clock','Faster Reporting','Reduced manual preparation before reviews.'],['database','More Consistent Data','Common definitions improved comparability across markets.'],['warning-solid','Earlier Risk Visibility','Structured dashboards highlighted execution exceptions sooner.'],['users','Improved Review Quality','Leadership discussions focused on action and less on reconciling numbers.']];
---
<section class="case-page nks-page nks-ecosystem" id="ecosystem" aria-labelledby="nks-ecosystem-title">
  <div class="nks-canvas">
    <header class="nks-ecosystem-copy nks-story">
      <p class="nks-eyebrow">Enterprise Reporting &amp; Delivery Intelligence <i></i></p>
      <h2 id="nks-ecosystem-title">Bring delivery, logistics<br/>and operational data<br/><em>into one ecosystem.</em></h2>
      <p>Nokia operated across multiple international markets with established delivery processes, systems and governance. Each region maintained its own reporting structures, source data and operational trackers to meet local requirements.</p>
      <p>The objective was to create a common analytical layer that harmonised these sources, applied consistent business definitions and enabled comparable insights across all markets.</p>
    </header>
    <div class="nks-ecosystem-columns">
      <div class="nks-source-domain"><header><span class="nks-bubble nks-blue"><Icon name="database"/></span><div><h3>Regional source domains</h3><p>Operational and business data from across markets</p></div></header><div>{sources.map(([icon,title,text],i)=><article class={`nks-domain-row nks-${['violet','orange','green','blue','pink'][i]}`}><span class="nks-bubble"><Icon name={icon}/></span><div><h4>{title}</h4><p>{text}</p></div></article>)}</div></div>
      <div class="nks-reporting-model"><header><span class="nks-bubble nks-orange"><Icon name="chart"/></span><div><h3>Unified Reporting<br/>&amp; Insights Model</h3><p>Common data model, consistent logic and trusted insights</p></div></header><div>{model.map(([icon,title,text],i)=><article class={`nks-model-row nks-${['blue','violet','green','orange'][i]}`}><span class="nks-bubble"><Icon name={icon}/></span><div><h4>{title}</h4><p>{text}</p></div></article>)}</div></div>
      <div class="nks-decision-users"><header><span class="nks-bubble nks-green"><Icon name="users"/></span><div><h3>Decision users</h3><p>Stakeholders who use the insights for operational and strategic decisions</p></div></header><div>{users.map(([icon,title,text],i)=><article class={`nks-user-row nks-${['blue','violet','green'][i]}`}><span class="nks-bubble"><Icon name={icon}/></span><div><h4>{title}</h4><p>{text}</p></div></article>)}</div></div>
    </div>
    <aside class="nks-ecosystem-enabled"><h3><Icon name="target"/> What this ecosystem enabled</h3><div>{[['chart','Consistent View Across Markets','Harmonised data and KPI definitions enabled comparable delivery insights across APAC, China, India, MEA, EUR, LAT and NAM.'],['database','Reduced Manual Consolidation','Consolidated key inputs from multiple sources, reducing manual effort and delays in preparing regional and global reports.'],['eye','Improved Data Traceability','Clear mapping from source data to reporting outputs, with validated logic and defined business rules.'],['users','Enable Better Decision-Making','Provided trusted, consistent insights for Regional PMOs, Operations leaders and Executives to prioritise actions and manage delivery effectively.']].map(([icon,title,text],i)=><article class={`nks-enabled-item nks-${['blue','green','orange','violet'][i]}`}><span class="nks-bubble"><Icon name={icon}/></span><div><h4>{title}</h4><p>{text}</p></div></article>)}</div></aside>
  </div>
</section>
<section class="case-page nks-page nks-challenge" id="challenge" aria-labelledby="nks-challenge-title">
  <div class="nks-canvas">
    <header class="nks-challenge-copy nks-story"><p class="nks-eyebrow">Enterprise Reporting &amp; Delivery Intelligence <i></i></p><h2 id="nks-challenge-title">A consistent cross-market<br/>view required <em>greater<br/>standardisation.</em></h2><p>Nokia had well-established delivery processes, systems and governance across its international markets. However, regional differences in data structures, reporting practices, terminology and KPI interpretation made it challenging to achieve a consistent, comparable and traceable view of delivery performance.</p><p>The objective was to standardise key business definitions, harmonise reporting structures and consolidate data from multiple sources to provide a unified analytical layer for management discussions and decision-making.</p></header>
    <div class="nks-challenge-board"><header><h3><Icon name="target"/> Key challenges observed</h3><p>Differences across regional contexts, data structures and reporting practices needed to be harmonised to enable a consistent view.</p></header><div>{challenges.map(([icon,title,text],i)=><article class={`nks-challenge-item nks-${['blue','orange','violet','green','orange','pink'][i]}`}><span class="nks-bubble"><Icon name={icon}/></span><div><h4>{title}</h4><p>{text}</p></div></article>)}</div></div>
    <aside class="nks-business-requirement"><h3><Icon name="target"/> The real business requirement</h3><div><article><h4>From existing regional reporting</h4><p>Multiple regional reports, trackers and data sources, each aligned to local requirements and reporting practices.</p></article><span class="nks-transition-arrow" aria-hidden="true">→</span><article><h4>To a standardised analytical layer</h4><p>A common set of business definitions, consolidated data and standardised reporting structures to provide a consistent and comparable view across all markets.</p></article></div></aside>
    <aside class="nks-importance"><header><h3><Icon name="chart"/> Why this mattered</h3><p>A standardised cross-market view enabled more efficient reporting, better governance and faster decision-making.</p></header><div>{[['users','More Efficient Consolidation','Reduced manual effort to prepare regional and global reports.'],['gear','Better Comparability','Consistent KPI definitions enabled a like-for-like view across markets.'],['eye','Stronger Traceability','Clear mapping from source data to reported KPIs and delivery performance.'],['shield','Faster Management Review','Enabled informed discussions for Regional PMOs, Operations leaders and executives.']].map(([icon,title,text],i)=><article class={`nks-importance-item nks-${['violet','green','orange','blue'][i]}`}><span class="nks-bubble"><Icon name={icon}/></span><h4>{title}</h4><p>{text}</p></article>)}</div></aside>
  </div>
</section>
<section class="case-page nks-page nks-strategy" id="strategy" aria-labelledby="nks-strategy-title">
  <div class="nks-canvas">
    <header class="nks-strategy-copy nks-story"><p class="nks-eyebrow">Enterprise Reporting &amp; Delivery Intelligence <i></i></p><h2 id="nks-strategy-title">A structured approach<br/>to standardise reporting<br/><em>across markets.</em></h2><p>I defined and executed a structured approach to harmonise regional reporting, standardise business definitions and consolidate operational data from multiple sources, while aligning with Nokia’s established delivery processes, systems and governance.</p><p>The strategy focused on clear requirements, consistent KPI logic, well-defined data flows, strong validation and business acceptance to enable a unified and reliable analytical layer for Regional PMOs, Operations leaders and executive stakeholders.</p></header>
    <div class="nks-strategy-framework"><header><h3><Icon name="target"/> Strategy framework</h3><p>A structured, iterative approach from requirements to adoption, focusing on standardisation, governance and business value.</p></header><div>{stages.map(([icon,title,items],i)=><article class={`nks-strategy-stage nks-${colors[i]}`}><span class="nks-bubble"><Icon name={icon as string}/></span><h4>{title.split(' & ')[0]}<br/>&amp; {title.split(' & ')[1]}</h4><ul>{(items as string[]).map(item=><li>{item}</li>)}</ul></article>)}</div></div>
    <aside class="nks-strategy-elements"><h3><Icon name="chart"/> Key elements of the strategy</h3><div>{strategyValues.map(([icon,title,text],i)=><article class={`nks-strategy-element nks-${['blue','green','orange','violet'][i]}`}><span class="nks-bubble"><Icon name={icon}/></span><div><h4>{title}</h4><p>{text.split(/(buy-in|evolving needs)/).map(part=>/^(buy-in|evolving needs)$/.test(part)?<span class="nks-keep-phrase">{part}</span>:part)}</p></div></article>)}</div></aside>
  </div>
</section>
<section class="case-page nks-page nks-scope" id="pm-scope" aria-labelledby="nks-scope-title">
  <div class="nks-canvas">
    <header class="nks-scope-copy nks-story"><p class="nks-eyebrow">Enterprise Reporting &amp; Delivery Intelligence <i></i></p><h2 id="nks-scope-title">End-to-end Business<br/>Analysis scope <em>across<br/>the reporting lifecycle.</em></h2><p>I led the business analysis scope to standardise regional reporting and delivery insights, working across regional PMOs, operations and executive stakeholders. The scope covered the complete lifecycle from requirement gathering to implementation and adoption.</p><p>I focused on clear requirements, consistent KPI definitions, structured data flows, robust validation and user adoption to enable a unified analytical layer for management discussions and decision-making.</p></header>
    <div class="nks-scope-workstreams"><h3><Icon name="layers"/> Workstreams across the reporting lifecycle</h3><div>{lifecycle.map(([icon,title,text],i)=><article class={`nks-workstream nks-${colors[i]}`}><span class="nks-bubble"><Icon name={icon}/></span><div><h4>{title}</h4></div><p>{text}</p></article>)}</div></div>
    <aside class="nks-scope-deliverables"><p class="nks-delivery-intro">From requirements to adoption, ensuring a standardised, traceable and reliable reporting environment.</p><div><h3><Icon name="document"/> Key deliverables</h3><div>{deliverables.map(([icon,title,text],i)=><article class={`nks-deliverable nks-${colors[i]}`}><span class="nks-bubble"><Icon name={icon}/></span><div><h4>{title}</h4><p>{text}</p></div></article>)}</div></div></aside>
    <aside class="nks-scope-values"><h3><Icon name="chart"/> How this scope created value</h3><div>{scopeValues.map(([icon,title,text],i)=><article class={`nks-scope-value nks-${['blue','green','orange','violet'][i]}`}><span class="nks-bubble"><Icon name={icon}/></span><div><h4>{title}</h4><p>{text}</p></div></article>)}</div></aside>
  </div>
</section>
<section class="case-page nks-page nks-tall nks-metrics" id="product-metrics" aria-labelledby="nks-metrics-title">
  <div class="nks-canvas">

    <header class="nks-metrics-copy nks-story"><p class="nks-eyebrow">DELIVERY &amp; REPORTING METRICS</p><h2 id="nks-metrics-title">Define metrics that<br/><em>every market interprets<br/>the same way.</em></h2><p>A key part of my BA responsibility was ensuring that reporting metrics were not merely labels on a dashboard.</p><p>Each important KPI required:</p><ul>{['an agreed business definition','defined numerator and denominator','data source','calculation logic','exception handling','reporting frequency','accountable owner'].map(text=><li>{text}</li>)}</ul></header>
    <div class="nks-metric-columns">{metrics.map((metric,i)=><article class:list={['nks-metric-column','nks-'+colors[i]]}>
      <header><span class="nks-metric-index">{String(i+1).padStart(2,'0')}</span><span class="nks-bubble"><Icon name={metric.icon}/></span></header><h3>{metric.title}</h3><p>{metric.text}</p>
      {i!==3&&<div class="nks-metric-formula"><b>Formula</b>{i===1?<p>Dashboard Publication Timestamp<br/>−<br/>Data Ingestion / Reporting<br/>Window Start</p>:<p>{metric.formula.split(' ÷ ')[0]}<br/>+<br/>{metric.formula.split(' ÷ ')[1].replace(' × 100','')}<br/>× 100</p>}</div>}
      {i!==3?<div class:list={['nks-metric-chart','nks-metric-chart-'+i]}><Chart kind={['adherence','cycle','exception','','completeness'][i]}/></div>:<div class="nks-progress-bars" role="img" aria-label="Illustrative delivery progress from the approved reference: planning 100 percent, site preparation 80 percent, deployment 60 percent, integration 45 percent and go live 20 percent">{[['Planning',100],['Site Preparation',80],['Deployment',60],['Integration',45],['Go Live',20]].map(([label,value])=><div><span>{label}</span><div><i><b style={'width:'+value+'%'}></b></i><span>{value}%</span></div></div>)}</div>}
      <div class="nks-metric-decision"><span class="nks-bubble"><Icon name={i===4?'pin':'bulb'}/></span><div><h4>Decision supported</h4><p>{metric.decision}</p></div></div>
    </article>)}</div>
    <aside class="nks-governance"><header><h3><Icon name="database"/> KPI governance questions</h3><p>For every metric, these questions need to be clearly defined and agreed.</p></header><div>{governance.map(([icon,title,text],i)=><article class:list={['nks-governance-question','nks-'+colors[i]]}><span class="nks-bubble"><Icon name={icon}/></span><div><h4>{title}</h4><p>{text}</p></div></article>)}</div></aside>
    <aside class="nks-measurement"><h3><Icon name="target"/> Measurement philosophy I carried into Product Management</h3><blockquote><span aria-hidden="true">“</span><p>Do not measure because data is available.<br/>Measure because the metric helps somebody<br/>make a better decision.”</p></blockquote><p>This principle helped ensure that metrics remained focused on business outcomes, operational efficiency and decision-making. It later became central to how I approached product adoption, impact measurement and continuous improvement in my Product Management career.</p></aside>
  </div>
</section>
<section class="case-page nks-page nks-tall nks-portfolio" id="portfolio" aria-labelledby="nks-portfolio-title">
  <div class="nks-canvas">

    <header class="nks-portfolio-copy nks-story"><p class="nks-eyebrow">REPORTING &amp; ANALYTICS WORKSPACES</p><h2 id="nks-portfolio-title">Different users.<br/><em>One trusted analytical<br/>foundation.</em></h2><p>The platform supported multiple reporting experiences based on the decision context of each stakeholder group.</p><p>Rather than creating one overloaded dashboard for everyone, information could be organised around the needs of distinct users.</p></header>
    <div class="nks-workspaces">{workspaces.map((workspace,i)=><article class:list={['nks-workspace','nks-'+['blue','orange','green'][i]]}><header><span class="nks-bubble"><Icon name={workspace.icon}/></span><div><h3>{workspace.title}</h3><p>Primary users: {workspace.user}</p></div></header>
      <div class:list={['nks-dashboard-wireframe','nks-dashboard-'+i]}><h4>{['Global Delivery Overview','Regional Project Performance','Data Quality & Integration'][i]}</h4>
        {i===1&&<div class="nks-workspace-filters"><span>Region <b>APAC ⌄</b></span><span>Market <b>All ⌄</b></span><span>Status <b>All ⌄</b></span></div>}
        <div class="nks-dashboard-fields">{(i===0?[['check','92%','Milestone Adherence','↑ 6%'],['refresh','24','Active Projects','↑ 2'],['alert','5','At Risk','↓ 3']]:i===1?[['building','18','Total Projects',''],['shield','14','On Track',''],['users','3','Delayed',''],['alert','1','At Risk','']]:[['alert','2.8%','Exception Rate','↑ 0.4%'],['check','98.5%','Data Completeness','↑ 1.2%'],['down','12','Failed Pipelines','↓ 40%']]).map(([icon,value,label,change],j)=><div class:list={['nks-kpi-'+j]}><Icon name={icon}/><b>{value}</b><span>{label}</span>{change&&<small>{change}</small>}</div>)}</div>
        {i===0&&<div class="nks-executive-wireframe"><Visual kind="world"/><div><h5>Project Health by Region</h5>{[['APAC',92],['EMEA',86],['Americas',78],['LATAM',81],['MEA',88]].map(([label,value])=><div><span>{label}</span><i><b style={'width:'+value+'%'}></b></i><small>{value}%</small></div>)}</div></div>}
        {i===1&&<table class="nks-project-wireframe"><caption>Illustrative project dashboard from the approved design</caption><thead><tr>{['Project','Market','Milestone','Status','Planned','Actual'].map(text=><th>{text}</th>)}</tr></thead><tbody>{[['5G Deployment','India','Site Rollout','On Track','30 Oct','28 Oct'],['Core Upgrade','Singapore','Integration','Delayed','12 Nov','18 Nov'],['RAN Expansion','Australia','Site Acceptance','On Track','20 Oct','19 Oct'],['Fiber Network','Malaysia','Implementation','Delayed','15 Nov','22 Nov'],['Infra Modernisation','Indonesia','Testing','On Track','28 Oct','27 Oct']].map(row=><tr>{row.map((cell,column)=><td class:list={[column===3&&(cell==='Delayed'?'nks-delayed':'nks-on-track'),column>3&&row[3]==='Delayed'&&'nks-delayed']}>{column===3&&<i></i>}{cell}</td>)}</tr>)}</tbody></table>}
        {i===2&&<div class="nks-quality-wireframe"><div><h5>Exception Trend</h5><Chart kind="qualitytrend"/></div><div><h5>Exception by Source</h5><Chart kind="exception-donut"/></div></div>}
      </div>
      <div class="nks-workspace-provides"><h4>Provides:</h4><ul>{workspace.items.map(item=><li>{item}</li>)}</ul></div><div class="nks-primary-question"><span class="nks-question-icon" aria-hidden="true">?</span><div><h4>Primary question</h4><p>{i===1?'Which programs, markets or milestones require intervention?':workspace.question}</p></div></div>
    </article>)}</div>
    <aside class="nks-reporting-hierarchy"><h3><Icon name="layers"/> Reporting design hierarchy</h3><ol>{hierarchy.map(([icon,title,text],i)=><li class:list={['nks-'+colors[i]]}><span class="nks-bubble"><Icon name={icon}/></span><h4>{title}</h4><p>{text}</p></li>)}</ol></aside>
    <aside class="nks-ba-contribution"><header><h3><Icon name="target"/> Business Analysis contribution</h3><p>Ensured each workspace was purposeful, traceable and aligned to user decisions.</p></header><div><p>My responsibility was not to visually design every dashboard component. <b>My responsibility</b> was to ensure that <b>each</b> workspace had:</p><ul>{[['users','A clear user'],['target','A defined business problem'],['chart','Agreed KPIs'],['database','Traceable data'],['document','Functional requirements'],['check','Acceptance criteria']].map(([icon,text],i)=><li class:list={['nks-'+colors[i]]}><Icon name={icon}/>{text}</li>)}</ul><p class="nks-product-thinking"><Icon name="bulb"/>That experience taught me to think in terms of user groups, use cases and value, which became increasingly important when I later moved into Product Management.</p></div></aside>
  </div>
</section>
<section class="case-page nks-page nks-tall nks-tech" id="tech-data" aria-labelledby="nks-tech-title">
  <div class="nks-canvas">
    <header class="nks-tech-copy nks-story"><p class="nks-eyebrow">Data Flow &amp; Reporting Architecture</p><h2 id="nks-tech-title">Move from manual<br/>reporting inputs to a<br/><em>governed analytical flow.</em></h2><p>From a BA perspective, I worked on defining how business information should move from source systems into the analytical experience.</p><p>The focus was functional rather than infrastructure ownership: understanding source relationships, documenting mappings, defining validation requirements and ensuring the output matched business expectations.</p></header>
    <div class="nks-tech-layers">
      <div class="nks-tech-source nks-blue"><header><span class="nks-bubble"><Icon name="database"/></span><div><h3>SOURCE LAYER</h3><p>Operational data from multiple systems and regional inputs.</p></div></header><div>{techSources.map(([icon,title,text],i)=><article><span class={`nks-bubble nks-${['green','orange','violet','blue'][i]}`}>{i===0?<span class="nks-excel-wordmark">X<span></span></span>:<Icon name={icon}/>}</span><div><h4>{title}</h4><p>{text}</p></div></article>)}</div></div>
      <div class="nks-tech-transform nks-orange"><header><span class="nks-bubble"><Icon name="gear"/></span><div><h3>INGESTION &amp;<br/>TRANSFORMATION</h3><p>Consolidate, standardise and validate data.</p></div></header><div><article><span class="nks-bubble"><Icon name="database"/></span><div><h4>SQL Staging</h4><p>Consolidate information from source structures.</p></div></article><span class="nks-down" aria-hidden="true">↓</span><article><span class="nks-bubble"><Icon name="wand"/></span><div><h4>Transformation Rules</h4><p>Standardise:</p><ul>{['field formats','identifiers','milestone values','regional labels'].map(text=><li>{text}</li>)}</ul></div></article><span class="nks-down" aria-hidden="true">↓</span><article><span class="nks-bubble"><Icon name="shield"/></span><div><h4>Validation</h4><p>Identify:</p><ul>{['missing values','invalid mappings','duplicate records','unexpected values'].map(text=><li>{text}</li>)}</ul></div></article></div></div>
      <div class="nks-tech-model nks-green"><header><span class="nks-bubble"><Icon name="network"/></span><div><h3>SEMANTIC /<br/>REPORTING MODEL</h3><p>Common analytical model for consistent reporting.</p></div></header><ul>{['Market','Program','Project / Site','Milestone','Status','Date / Period','Operational Measure','KPI'].map((text,i)=><li class={`nks-${['blue','violet','green','orange','green','blue','green','pink'][i]}`}><Icon name={['globe','layers','folder','flag','check','calendar','chart','target'][i]}/>{text}</li>)}</ul></div>
      <div class="nks-tech-experience nks-violet"><header><span class="nks-bubble"><Icon name="chart"/></span><div><h3>ANALYTICS EXPERIENCE</h3><p>Reporting and analysis for different stakeholder needs.</p></div></header><div>{analyticsTools.map(([icon,title,text],i)=><article><span class={`nks-tool-mark nks-${['orange','blue','blue','green'][i]}`}>{i===1?<PortfolioIcon name="tableau"/>:i===2?<b class="nks-sap-wordmark">SAP</b>:i===3?<span class="nks-excel-wordmark">X<span></span></span>:<Icon name="powerbi"/>}</span><div><h4>{title}</h4><p>{text}</p></div></article>)}</div></div>
    </div>
    <aside class="nks-functional-flow"><header><h3><Icon name="network"/> Functional data flow</h3><p>High-level flow from regional inputs to business decision.</p></header><ol>{flow.map(([icon,title,text],i)=><li class={`nks-${colors[i%6]}`}><span class="nks-bubble">{icon==='calculator'?<PortfolioIcon name="calculator"/>:<Icon name={icon}/>}</span><div><h4>{title}</h4><p>{text}</p></div></li>)}</ol></aside>
    <aside class="nks-validation"><header><h3><Icon name="shield"/> BA validation checkpoints</h3><p>Ensured data, logic and reporting outputs met business expectations.</p></header><div>{checkpoints.map(([icon,title,text],i)=><article class={`nks-${colors[i]}`}><header><b>{String(i+1).padStart(2,'0')}</b><span class="nks-bubble"><Icon name={icon}/></span></header><h4>{title}</h4><p>{text}</p></article>)}</div></aside>
  </div>
</section>
<section class="case-page nks-page nks-tall nks-outcomes" id="outcomes" aria-labelledby="nks-outcomes-title">
  <div class="nks-canvas">
    <header class="nks-outcomes-copy nks-story"><p class="nks-eyebrow">Measurable Business Outcomes</p><h2 id="nks-outcomes-title">Less time preparing<br/>reports.<br/><em>More time acting on<br/>the information.</em></h2><p>The value of the platform came from combining standardisation, automation and decision visibility.</p><p>Instead of spending the majority of a reporting cycle collecting and reconciling information, teams could focus more of their time on identifying and resolving operational issues.</p></header>
    <div class="nks-outcome-columns">
      <article class="nks-outcome nks-blue"><span class="nks-bubble"><Icon name="clock"/></span><strong>25%</strong><h3>Reduction in reporting<br/>turnaround time</h3><p>Reduced manual consolidation and review effort through standardised reporting and more automated data processing.</p><div class="nks-outcome-reference-chart"><Chart kind="turnaround"/></div></article>
